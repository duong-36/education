@model IEnumerable<QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.Models.ChuongTrinhDaoTao>
@{
    // Họ và tên: [Tên SV1]
    // Mã sinh viên: [Mã SV1]
    // Nội dung thực hiện: Giao diện Quản lý Chương trình đào tạo (Module 1) - Phong cách Prep.vn
    ViewData["Title"] = "Chương trình đào tạo";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
    string search = ViewBag.Search ?? "";
    string selectedTrangThai = ViewBag.SelectedTrangThai ?? "";
    var classCounts = ViewBag.ClassCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div id="ctdt-content-area" class="flex flex-col gap-y-6 transition-opacity duration-200">
    <!-- Sub-header Navigation Bar -->
    <section class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-2 border-b border-border-standard">
        <div>
            <div class="flex items-center gap-2 text-outline font-label-sm text-label-sm uppercase tracking-wider mb-1">
                <span>ĐÀO TẠO</span>
                <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                <span class="text-brand-deep font-semibold">CHƯƠNG TRÌNH ĐÀO TẠO</span>
            </div>
            <h1 class="font-headline-md text-headline-md text-brand-deep font-bold tracking-tight">
                Danh mục Chương trình đào tạo
            </h1>
        </div>

        <div class="flex items-center gap-2.5">
            <button onclick="openDrawer('create')" class="inline-flex items-center gap-1.5 bg-primary hover:bg-[#0047b3] text-surface-white font-label-md text-label-md px-4 py-2.5 rounded-xl shadow-sm hover:shadow-md transition-all cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">add_circle</span>
                <span>Thêm chương trình</span>
            </button>
        </div>
    </section>

    <!-- 3 Stat Cards (Top KPI) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle shadow-[0_2px_12px_rgba(0,22,86,0.03)] flex flex-col justify-between">
            <div class="flex items-center justify-between mb-2">
                <span class="text-outline font-label-md text-label-md">Tổng số chương trình</span>
                <div class="w-9 h-9 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-[20px]">auto_stories</span>
                </div>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="font-display text-[30px] leading-8 text-brand-deep tracking-tight font-black font-mono">@ViewBag.TongCTDT</span>
                <span class="text-xs text-outline font-medium">chuyên ngành</span>
            </div>
        </div>

        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle shadow-[0_2px_12px_rgba(0,22,86,0.03)] flex flex-col justify-between">
            <div class="flex items-center justify-between mb-2">
                <span class="text-outline font-label-md text-label-md">Đang hoạt động</span>
                <div class="w-9 h-9 rounded-xl bg-success-emerald/10 flex items-center justify-center text-success-emerald">
                    <span class="material-symbols-outlined text-[20px]">check_circle</span>
                </div>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="font-display text-[30px] leading-8 text-success-emerald tracking-tight font-black font-mono">@ViewBag.DangHoatDong</span>
                <span class="text-xs text-outline font-medium">chương trình tuyển sinh</span>
            </div>
        </div>

        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle shadow-[0_2px_12px_rgba(0,22,86,0.03)] flex flex-col justify-between">
            <div class="flex items-center justify-between mb-2">
                <span class="text-outline font-label-md text-label-md">Tổng lớp học liên kết</span>
                <div class="w-9 h-9 rounded-xl bg-secondary-container/10 flex items-center justify-center text-secondary-container">
                    <span class="material-symbols-outlined text-[20px]">meeting_room</span>
                </div>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="font-display text-[30px] leading-8 text-brand-deep tracking-tight font-black font-mono">@ViewBag.TongLopLienKet</span>
                <span class="text-xs text-outline font-medium">lớp đào tạo</span>
            </div>
        </div>
    </div>

    <!-- Filter & Operation Toolbar -->
    <div class="bg-surface-white rounded-2xl p-4 border border-border-subtle shadow-sm flex flex-col lg:flex-row items-center justify-between gap-4">
        <form method="get" action="/ChuongTrinhDaoTao/Index" class="flex flex-wrap items-center gap-3 w-full lg:w-auto" id="filter-form" onsubmit="event.preventDefault(); filterCtdtAjax();">
            <div class="relative flex-1 sm:w-80">
                <span class="material-symbols-outlined text-outline absolute left-3 top-1/2 -translate-y-1/2 text-[18px]">search</span>
                <input name="search" value="@search" class="w-full bg-surface-container-low border border-border-standard pl-9 pr-3 py-2 rounded-xl text-brand-deep font-body-sm text-body-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" placeholder="Tìm theo tên chương trình, mô tả..." type="text"/>
            </div>

            <div class="relative">
                <select name="trangThai" onchange="filterCtdtAjax()" class="appearance-none bg-surface-white border border-border-standard text-brand-deep font-body-sm text-body-sm px-3.5 py-2 pr-8 rounded-xl focus:outline-none focus:border-primary cursor-pointer hover:bg-surface-container-low transition-colors">
                    <option value="">Tất cả Trạng thái</option>
                    <!option value="Đang hoạt động" @(selectedTrangThai == "Đang hoạt động" ? "selected" : "")>● Đang hoạt động</!option>
                    <!option value="Tạm dừng" @(selectedTrangThai == "Tạm dừng" ? "selected" : "")>○ Tạm dừng</!option>
                </select>
                <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[16px]">expand_more</span>
            </div>
        </form>

        <div class="flex items-center gap-2 w-full lg:w-auto justify-end">
            <a href="/ChuongTrinhDaoTao/Index" onclick="event.preventDefault(); loadCtdtPage(this.href);" class="p-2 border border-border-standard rounded-xl text-outline hover:text-brand-deep hover:bg-surface-container-low transition-colors cursor-pointer" title="Làm mới">
                <span class="material-symbols-outlined text-[20px] block">refresh</span>
            </a>
        </div>
    </div>

    <!-- Data Table Container -->
    <div class="bg-surface-white rounded-2xl border border-border-subtle shadow-[0_1px_3px_rgba(0,22,86,0.04)] overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse" id="crud-table">
                <thead>
                    <tr class="bg-surface-container-low/70 border-b border-border-subtle font-label-sm text-label-sm text-outline tracking-wider uppercase">
                        <th class="py-4 px-6">Chương trình đào tạo</th>
                        <th class="py-4 px-4">Mô tả tóm tắt</th>
                        <th class="py-4 px-4">Email liên hệ</th>
                        <th class="py-4 px-4 text-center">Lớp liên kết</th>
                        <th class="py-4 px-4 text-center">Trạng thái</th>
                        <th class="py-4 px-6 text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border-subtle font-body-sm text-body-sm">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="py-12 text-center text-outline">
                                <span class="material-symbols-outlined text-4xl block mb-2 text-outline/50">auto_stories</span>
                                Không có chương trình đào tạo nào phù hợp.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            int soLop = classCounts.ContainsKey(item.MaChuongTrinh) ? classCounts[item.MaChuongTrinh] : 0;
                            <tr class="hover:bg-surface-container-low/50 transition-colors"
                                data-id="@item.MaChuongTrinh"
                                data-ten="@item.TenChuongTrinh"
                                data-mota="@item.MoTa"
                                data-email="@item.EmailLienHe"
                                data-trangthai="@item.TrangThai"
                                data-solop="@soLop">
                                <td class="py-4 px-6">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-xl bg-primary/10 text-primary font-bold text-sm flex items-center justify-center flex-shrink-0">
                                            CT
                                        </div>
                                        <div>
                                            <div class="font-semibold text-brand-deep">@item.TenChuongTrinh</div>
                                            <div class="text-xs text-outline font-mono">Mã CT: #@item.MaChuongTrinh</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-4 px-4 text-on-surface-variant max-w-xs truncate">
                                    @(string.IsNullOrEmpty(item.MoTa) ? "Chưa có mô tả chi tiết" : item.MoTa)
                                </td>
                                <td class="py-4 px-4 text-outline font-mono text-xs">
                                    @item.EmailLienHe
                                </td>
                                <td class="py-4 px-4 text-center">
                                    <span class="inline-flex items-center gap-1 font-mono text-xs font-semibold px-2.5 py-0.5 rounded-full bg-surface-container-low text-brand-deep">
                                        @soLop lớp
                                    </span>
                                </td>
                                <td class="py-4 px-4 text-center">
                                    @if (item.TrangThai == "Đang hoạt động")
                                    {
                                        <span class="inline-flex items-center gap-1.5 font-label-sm text-label-sm text-success-emerald bg-emerald-50 px-2.5 py-1 rounded-full font-semibold">
                                            <span class="w-1.5 h-1.5 rounded-full bg-success-emerald"></span>Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 font-label-sm text-label-sm text-outline bg-gray-100 px-2.5 py-1 rounded-full font-semibold">
                                            <span class="w-1.5 h-1.5 rounded-full bg-outline"></span>Tạm dừng
                                        </span>
                                    }
                                </td>
                                <td class="py-4 px-6 text-right">
                                    <div class="inline-flex items-center gap-1">
                                        <button onclick="openEditDrawerFromRow(this)" class="p-1.5 rounded-lg text-outline hover:text-primary hover:bg-surface-container-low transition-colors cursor-pointer" title="Chỉnh sửa">
                                            <span class="material-symbols-outlined text-[18px]">edit</span>
                                        </button>
                                        <button onclick="confirmDeleteCtdt(@item.MaChuongTrinh, '@item.TenChuongTrinh', @soLop)" class="p-1.5 rounded-lg text-outline hover:text-danger-crimson hover:bg-red-50 transition-colors cursor-pointer" title="Xóa chương trình">
                                            <span class="material-symbols-outlined text-[18px]">delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Toolbar -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 p-4 border-t border-border-subtle font-body-sm text-body-sm text-outline">
            <span class="tabular-nums">
                Trang <strong class="text-brand-deep font-semibold">@currentPage</strong> / <strong class="text-brand-deep font-semibold">@totalPages</strong> (Tổng @totalItems chương trình)
            </span>
            <div class="inline-flex items-center gap-1">
                @if (currentPage > 1)
                {
                    <a href="/ChuongTrinhDaoTao/Index?page=@(currentPage - 1)&search=@search&trangThai=@selectedTrangThai" onclick="event.preventDefault(); loadCtdtPage(this.href)" class="px-2.5 py-1 rounded-lg border border-border-standard text-brand-deep hover:bg-canvas-base transition-colors font-label-md text-label-md cursor-pointer">
                        Trước
                    </a>
                }
                else
                {
                    <span class="px-2.5 py-1 rounded-lg border border-border-standard text-outline/40 font-label-md text-label-md cursor-not-allowed">Trước</span>
                }

                @for (int p = currentPage - 1; p <= currentPage + 1; p++)
                {
                    if (p >= 1 && p <= totalPages)
                    {
                        if (p == currentPage)
                        {
                            <span class="w-8 h-8 rounded-lg bg-primary-container text-surface-white font-label-md text-label-md font-bold flex items-center justify-center font-mono">@p</span>
                        }
                        else
                        {
                            <a href="/ChuongTrinhDaoTao/Index?page=@p&search=@search&trangThai=@selectedTrangThai" onclick="event.preventDefault(); loadCtdtPage(this.href)" class="w-8 h-8 rounded-lg border border-border-standard text-brand-deep hover:bg-canvas-base transition-colors font-label-md text-label-md flex items-center justify-center font-mono cursor-pointer">@p</a>
                        }
                    }
                }

                @if (currentPage < totalPages)
                {
                    <a href="/ChuongTrinhDaoTao/Index?page=@(currentPage + 1)&search=@search&trangThai=@selectedTrangThai" onclick="event.preventDefault(); loadCtdtPage(this.href)" class="px-2.5 py-1 rounded-lg border border-border-standard text-brand-deep hover:bg-canvas-base transition-colors font-label-md text-label-md cursor-pointer">
                        Sau
                    </a>
                }
                else
                {
                    <span class="px-2.5 py-1 rounded-lg border border-border-standard text-outline/40 font-label-md text-label-md cursor-not-allowed">Sau</span>
                }
            </div>
        </div>
    </div>
</div>

<!-- Right Slide-Over Drawer for Create & Edit CTĐT -->
<div id="drawer-container" class="fixed inset-0 z-50 overflow-hidden hidden" aria-labelledby="slide-over-title" role="dialog" aria-modal="true">
    <div class="absolute inset-0 bg-brand-deep/30 backdrop-blur-xs transition-opacity" onclick="closeDrawer()"></div>
    <div class="fixed inset-y-0 right-0 max-w-full flex pl-10">
        <div class="w-screen max-w-md bg-surface-white shadow-2xl flex flex-col justify-between">
            <!-- Header -->
            <div class="p-6 border-b border-border-subtle flex items-start justify-between">
                <div>
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary text-[22px]">auto_stories</span>
                        <h2 class="font-headline-sm text-headline-sm text-brand-deep font-bold" id="drawer-title">Thêm chương trình</h2>
                    </div>
                    <p class="font-body-sm text-body-sm text-outline mt-1" id="drawer-subtitle">Tạo chương trình đào tạo mới của trung tâm.</p>
                </div>
                <button onclick="closeDrawer()" class="p-1.5 rounded-xl text-outline hover:text-brand-deep hover:bg-surface-container-low transition-colors cursor-pointer">
                    <span class="material-symbols-outlined text-[20px]">close</span>
                </button>
            </div>

            <!-- Body -->
            <form id="drawer-form" method="post" action="/ChuongTrinhDaoTao/CreatePost" class="flex-1 overflow-y-auto p-6 space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="maChuongTrinh" id="drawer-mactdt" value="0"/>

                <div class="space-y-1.5">
                    <label class="block font-label-sm text-label-sm text-brand-deep uppercase tracking-wider">Tên chương trình đào tạo <span class="text-danger-crimson">*</span></label>
                    <input type="text" name="TenChuongTrinh" id="drawer-ten" required class="w-full bg-surface-white border border-border-standard rounded-xl px-3.5 py-2.5 font-body-sm text-body-sm text-brand-deep focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" placeholder="Ví dụ: Lập trình ASP.NET Core Chuyên Sâu"/>
                </div>

                <div class="space-y-1.5">
                    <label class="block font-label-sm text-label-sm text-brand-deep uppercase tracking-wider">Email liên hệ</label>
                    <input type="email" name="EmailLienHe" id="drawer-email" class="w-full bg-surface-white border border-border-standard rounded-xl px-3.5 py-2.5 font-body-sm text-body-sm text-brand-deep focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" placeholder="contact@uneti.edu.vn"/>
                </div>

                <div class="space-y-1.5">
                    <label class="block font-label-sm text-label-sm text-brand-deep uppercase tracking-wider">Mô tả chương trình</label>
                    <textarea name="MoTa" id="drawer-mota" rows="4" class="w-full bg-surface-white border border-border-standard rounded-xl p-3 font-body-sm text-body-sm text-brand-deep focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary resize-none" placeholder="Giới thiệu mục tiêu đào tạo, chuẩn đầu ra..."></textarea>
                </div>

                <div class="space-y-1.5">
                    <label class="block font-label-sm text-label-sm text-brand-deep uppercase tracking-wider">Trạng thái tuyển sinh</label>
                    <select name="TrangThai" id="drawer-trangthai" class="w-full bg-surface-white border border-border-standard rounded-xl px-3.5 py-2.5 font-body-sm text-body-sm text-brand-deep focus:outline-none focus:border-primary cursor-pointer">
                        <option value="Đang hoạt động">Đang hoạt động</option>
                        <option value="Tạm dừng">Tạm dừng</option>
                    </select>
                </div>

                <!-- Footer Buttons inside Form -->
                <div class="border-t border-border-subtle pt-5 flex items-center justify-end gap-3">
                    <button type="button" onclick="closeDrawer()" class="border border-border-standard bg-surface-white hover:bg-surface-container-low text-brand-deep font-label-md text-label-md px-4 py-2.5 rounded-xl transition-colors cursor-pointer">
                        Hủy bỏ
                    </button>
                    <button type="submit" class="bg-primary hover:bg-[#0047b3] text-surface-white font-label-md text-label-md px-5 py-2.5 rounded-xl shadow-sm flex items-center gap-2 transition-all cursor-pointer">
                        <span class="material-symbols-outlined text-[18px]">save</span>
                        <span id="drawer-submit-text">Lưu chương trình</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const drawer = document.getElementById('drawer-container');
    const drawerForm = document.getElementById('drawer-form');

    function openDrawer(mode) {
        drawer.classList.remove('hidden');
        if (mode === 'create') {
            document.getElementById('drawer-title').innerText = 'Thêm chương trình';
            document.getElementById('drawer-subtitle').innerText = 'Tạo chương trình đào tạo mới của trung tâm.';
            document.getElementById('drawer-submit-text').innerText = 'Lưu chương trình';
            drawerForm.action = '/ChuongTrinhDaoTao/CreatePost';

            document.getElementById('drawer-mactdt').value = '0';
            document.getElementById('drawer-ten').value = '';
            document.getElementById('drawer-email').value = 'contact@uneti.edu.vn';
            document.getElementById('drawer-mota').value = '';
            document.getElementById('drawer-trangthai').value = 'Đang hoạt động';
        }
    }

    function closeDrawer() {
        drawer.classList.add('hidden');
    }

    function openEditDrawerFromRow(btn) {
        const row = btn.closest('tr');
        document.getElementById('drawer-title').innerText = 'Chỉnh sửa chương trình';
        document.getElementById('drawer-subtitle').innerText = 'Cập nhật nội dung chương trình đào tạo.';
        document.getElementById('drawer-submit-text').innerText = 'Cập nhật';
        drawerForm.action = '/ChuongTrinhDaoTao/EditPost';

        document.getElementById('drawer-mactdt').value = row.dataset.id;
        document.getElementById('drawer-ten').value = row.dataset.ten;
        document.getElementById('drawer-email').value = row.dataset.email;
        document.getElementById('drawer-mota').value = row.dataset.mota;
        document.getElementById('drawer-trangthai').value = row.dataset.trangthai;

        drawer.classList.remove('hidden');
    }

    function confirmDeleteCtdt(id, tenCtdt, soLop) {
        if (soLop > 0) {
            openGlobalDeleteModal({
                action: '#',
                id: id,
                title: 'Không thể xóa chương trình!',
                itemName: tenCtdt,
                message: `Chương trình <strong class="text-brand-deep">${tenCtdt}</strong> hiện đang có <strong>${soLop} lớp học trực thuộc</strong>. Quy định nghiệp vụ không cho phép xóa chương trình có dữ liệu lớp học đang liên kết.`,
                warning: 'Vui lòng chuyển hoặc xóa toàn bộ lớp học trước khi xóa chương trình.',
                submitText: 'Đã hiểu'
            });
            // Ẩn nút xóa thực tế
            const btn = document.querySelector('#global-delete-modal button[type="submit"]');
            if (btn) btn.onclick = (e) => { e.preventDefault(); closeGlobalDeleteModal(); };
            return;
        }

        openGlobalDeleteModal({
            action: '/ChuongTrinhDaoTao/DeletePost',
            id: id,
            title: 'Xóa chương trình đào tạo?',
            itemName: tenCtdt,
            message: `Bạn có chắc chắn muốn xóa chương trình <strong class="text-brand-deep">${tenCtdt}</strong>? Hành động này sẽ loại bỏ hoàn toàn danh mục khỏi hệ thống.`,
            warning: 'Thao tác này mang tính vĩnh viễn và không thể hoàn tác.',
            submitText: 'Xóa vĩnh viễn'
        });
    }

    function filterCtdtAjax() {
        const form = document.getElementById('filter-form');
        if (!form) return;
        const formData = new FormData(form);
        const params = new URLSearchParams(formData);
        params.set('page', '1');
        loadCtdtPage(`/ChuongTrinhDaoTao/Index?${params.toString()}`);
    }

    async function loadCtdtPage(url, pushState = true) {
        const area = document.getElementById('ctdt-content-area');
        if (area) area.classList.add('opacity-50', 'pointer-events-none');

        try {
            const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            const html = await res.text();
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');

            const newContent = doc.getElementById('ctdt-content-area');
            if (newContent && area) {
                area.innerHTML = newContent.innerHTML;
            }
            if (pushState) window.history.pushState({ url }, '', url);
        } catch (err) {
            window.location.href = url;
        } finally {
            if (area) area.classList.remove('opacity-50', 'pointer-events-none');
        }
    }

    window.addEventListener('popstate', (e) => {
        loadCtdtPage(e.state?.url || window.location.href, false);
    });

    window.onDeleteSuccess = function() {
        loadCtdtPage(window.location.href, false);
    };

    if (drawerForm) {
        drawerForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            const submitBtn = drawerForm.querySelector('button[type="submit"]');
            if (submitBtn) submitBtn.disabled = true;

            try {
                const formData = new FormData(drawerForm);
                const res = await fetch(drawerForm.action, {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const data = await res.json();
                if (data.success) {
                    closeDrawer();
                    if (window.showToast) window.showToast(data.message, 'success');
                    await loadCtdtPage(window.location.href, false);
                } else {
                    if (window.showToast) window.showToast(data.message, 'error');
                }
            } catch (err) {
                console.error(err);
            } finally {
                if (submitBtn) submitBtn.disabled = false;
            }
        });
    }
</script>
}
