@*
Họ và tên: Nguyễn Tùng Dương
Mã sinh viên: 23103100003
Nội dung thực hiện: Giao diện Dashboard (Module 5) - Phong cách Prep.vn
*@

@model QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.ViewModels.DashboardVM
@{
    ViewData["Title"] = "Dashboard - Tổng quan";
}

<div class="flex flex-col gap-y-6">
    <!-- 1. Action Strip (Prep.vn Style) -->
    <section class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 bg-surface-white p-5 rounded-2xl border border-border-subtle shadow-[0_2px_12px_rgba(0,22,86,0.03)]">
        <div class="flex flex-col gap-1">
            <h1 class="font-headline-lg-mobile lg:font-headline-lg text-brand-deep tracking-tight font-extrabold flex items-center gap-2">
                Chào buổi sáng, Nguyễn Tùng Dương <span class="text-2xl animate-bounce">👋</span>
            </h1>
            <div class="flex items-center gap-2 text-on-surface-variant font-body-sm text-body-sm flex-wrap">
                <span class="relative flex h-2.5 w-2.5">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-warning-amber opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-warning-amber"></span>
                </span>
                <span>
                    Hôm nay có <strong class="text-brand-deep font-semibold">@Model.DangKyChoDuyet yêu cầu</strong> đang chờ duyệt, 
                    <strong class="text-primary-container font-semibold">@Model.BuoiHocSapToi buổi học</strong> sắp tới cần giám sát.
                </span>
            </div>
        </div>
        <div class="flex items-center flex-wrap gap-2.5">
            @* <button onclick="location.reload()" class="border border-border-standard bg-surface-white hover:bg-canvas-base text-brand-deep font-label-md text-label-md px-3.5 py-2 rounded-xl shadow-xs inline-flex items-center gap-2 transition-all cursor-pointer" type="button">
                <span class="material-symbols-outlined text-[17px] text-outline">sync</span>
                <span>Đồng bộ dữ liệu</span>
            </button> *@
            <a href="/ThongKe/Index" class="border border-border-standard bg-surface-white hover:bg-canvas-base text-brand-deep font-label-md text-label-md px-3.5 py-2 rounded-xl shadow-xs inline-flex items-center gap-2 transition-all cursor-pointer">
                <span class="material-symbols-outlined text-[17px] text-outline">bar_chart</span>
                <span>Báo cáo thống kê</span>
            </a>
            <a href="/BuoiHoc/Create" class="bg-secondary-container hover:bg-secondary text-surface-white font-label-md text-label-md px-4 py-2 rounded-xl shadow-sm hover:shadow-md inline-flex items-center gap-1.5 transition-all transform hover:-translate-y-0.5 cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">add</span>
                <span> Lên lịch buổi học</span>
            </a>
        </div>
    </section>

    <!-- 2. 4-Column Stats Bento Grid -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <!-- Card 1: Tổng CTĐT -->
        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle shadow-[0_2px_12px_rgba(0,22,86,0.03)] hover:shadow-[0_8px_24px_rgba(0,104,255,0.08)] transition-all flex flex-col justify-between">
            <div class="flex items-center justify-between mb-3">
                <span class="text-outline font-label-md text-label-md">Tổng chương trình ĐT</span>
                <div class="w-9 h-9 rounded-xl bg-surface-container-low flex items-center justify-center text-primary-container">
                    <span class="material-symbols-outlined text-[20px]">menu_book</span>
                </div>
            </div>
            <div>
                <div class="font-display text-[30px] leading-8 text-brand-deep tracking-tight tabular-nums font-black mb-2 font-mono">
                    @Model.TongSoCTDT
                </div>
                <div class="inline-flex items-center gap-1 bg-success-emerald/10 text-success-emerald font-label-sm text-label-sm px-2 py-0.5 rounded-full font-semibold">
                    <span class="material-symbols-outlined text-[14px]">school</span>
                    <span>Hệ đào tạo UNETI</span>
                </div>
            </div>
        </div>

        <!-- Card 2: Sinh viên đăng ký -->
        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle shadow-[0_2px_12px_rgba(0,22,86,0.03)] hover:shadow-[0_8px_24px_rgba(0,104,255,0.08)] transition-all flex flex-col justify-between">
            <div class="flex items-center justify-between mb-2">
                <span class="text-outline font-label-md text-label-md">Tổng số sinh viên</span>
                <div class="w-9 h-9 rounded-xl bg-surface-container-low flex items-center justify-center text-primary-container">
                    <span class="material-symbols-outlined text-[20px]">groups</span>
                </div>
            </div>
            <div>
                <div class="flex items-baseline gap-1.5 mb-1.5">
                    <span class="font-display text-[30px] leading-8 text-brand-deep tracking-tight tabular-nums font-black font-mono">
                        @Model.TongSoHocVien
                    </span>
                    <span class="text-outline font-body-sm text-body-sm">/ @Model.TongSoLop lớp học</span>
                </div>
                <div class="w-full bg-border-subtle h-2 rounded-full overflow-hidden mb-2">
                    <div class="h-full bg-gradient-to-r from-primary to-primary-container rounded-full" style="width: @(Model.TongSoCTDT > 0 ? Math.Min(100, Model.TongSoLop * 12) : 50)%"></div>
                </div>
                <div class="text-primary-container font-label-sm text-label-sm font-semibold flex items-center gap-1">
                    <span class="material-symbols-outlined text-[13px]">play_circle</span>
                    <span>@Model.LopDangMo lớp đang mở đăng ký</span>
                </div>
            </div>
        </div>

        <!-- Card 3: Chờ phê duyệt -->
        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle shadow-[0_2px_12px_rgba(0,22,86,0.03)] hover:shadow-[0_8px_24px_rgba(0,104,255,0.08)] transition-all flex flex-col justify-between">
            <div class="flex items-center justify-between mb-3">
                <span class="text-outline font-label-md text-label-md">Chờ phê duyệt</span>
                <div class="w-9 h-9 rounded-xl bg-warning-amber/10 flex items-center justify-center text-warning-amber">
                    <span class="material-symbols-outlined text-[20px]">pending_actions</span>
                </div>
            </div>
            <div>
                <div class="flex items-center gap-2 mb-2">
                    <span class="font-display text-[30px] leading-8 text-brand-deep tracking-tight tabular-nums font-black font-mono">
                        @Model.DangKyChoDuyet
                    </span>
                    @if (Model.DangKyChoDuyet > 0)
                    {
                        <span class="relative flex h-2.5 w-2.5">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-warning-amber opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-warning-amber"></span>
                        </span>
                    }
                </div>
                <div class="inline-flex items-center gap-1 bg-warning-amber/10 text-secondary font-label-sm text-label-sm px-2 py-0.5 rounded-full font-semibold">
                    <span class="material-symbols-outlined text-[13px]">priority_high</span>
                    <span>@Model.DangKyDaDuyet lượt đã được duyệt</span>
                </div>
            </div>
        </div>

        <!-- Card 4: Tỷ lệ hoàn thành khóa học -->
        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle shadow-[0_2px_12px_rgba(0,22,86,0.03)] hover:shadow-[0_8px_24px_rgba(0,104,255,0.08)] transition-all flex flex-col justify-between">
            <div class="flex items-center justify-between mb-2">
                <span class="text-outline font-label-md text-label-md">Kết quả hoàn thành</span>
                <div class="w-9 h-9 rounded-xl bg-success-emerald/10 flex items-center justify-center text-success-emerald">
                    <span class="material-symbols-outlined text-[20px]">workspace_premium</span>
                </div>
            </div>
            <div class="flex items-center justify-between">
                <div>
                    <div class="font-display text-[30px] leading-8 text-brand-deep tracking-tight tabular-nums font-black mb-1 font-mono">
                        @Model.TyLeHoanThanh%
                    </div>
                    <div class="text-outline font-body-sm text-body-sm">
                        @Model.HocVienHoanThanh HV đạt chuẩn
                    </div>
                </div>
                <div class="relative w-12 h-12 flex-shrink-0">
                    <svg class="w-12 h-12 -rotate-90" viewBox="0 0 36 36">
                        <path class="text-border-standard" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="currentColor" stroke-width="3.5"></path>
                        <path class="text-success-emerald" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="currentColor" stroke-dasharray="@Model.TyLeHoanThanh, 100" stroke-linecap="round" stroke-width="3.5"></path>
                    </svg>
                    <span class="absolute inset-0 flex items-center justify-center font-label-sm text-[10px] text-brand-deep font-bold font-mono">
                        @(Math.Round(Model.TyLeHoanThanh))%
                    </span>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. Middle Split Section (Lịch học Module 5 & Phân tích Đào tạo) -->
    <section class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Left: Lịch Lớp Học Phần Sắp Tới (Module 5 BuoiHoc) -->
        <div class="lg:col-span-2 bg-surface-white rounded-2xl p-6 border border-border-subtle shadow-[0_2px_12px_rgba(0,22,86,0.03)] flex flex-col gap-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-2 border-b border-border-subtle">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary-container">calendar_clock</span>
                    <h2 class="font-headline-sm text-headline-sm text-brand-deep font-bold">Lịch Lớp Học Phần Sắp Tới</h2>
                </div>
                <a href="/BuoiHoc/Index" class="text-xs text-primary-container hover:text-primary font-semibold flex items-center gap-1">
                    Xem tất cả lịch học <span class="material-symbols-outlined text-sm">arrow_forward</span>
                </a>
            </div>

            <div class="flex flex-col gap-3">
                @if (Model.DanhSachBuoiHoc != null && Model.DanhSachBuoiHoc.Any())
                {
                    @foreach (var buoi in Model.DanhSachBuoiHoc)
                    {
                        var isSapDienRa = buoi.ThoiGianBatDau > DateTime.Now && buoi.ThoiGianBatDau <= DateTime.Now.AddDays(7);
                        <div class="border @(isSapDienRa ? "border-primary-fixed bg-surface-container-low/40" : "border-border-standard bg-surface-white") rounded-xl p-4 flex flex-col md:flex-row md:items-center justify-between gap-3 hover:bg-surface-container-low/70 transition-colors">
                            <div class="flex items-start gap-3">
                                <div class="px-2.5 py-1.5 rounded-lg @(isSapDienRa ? "bg-primary-container/10 text-primary-container" : "bg-surface-container-high text-on-surface-variant") font-label-sm text-label-sm font-bold flex-shrink-0 whitespace-nowrap mt-0.5 text-center font-mono">
                                    @buoi.ThoiGianBatDau.ToString("HH:mm") - @buoi.ThoiGianKetThuc.ToString("HH:mm")<br>
                                    <span class="text-[10px] font-normal">@buoi.ThoiGianBatDau.ToString("dd/MM/yyyy")</span>
                                </div>
                                <div class="flex flex-col gap-1 min-w-0">
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <h3 class="font-headline-sm text-[15px] font-bold text-brand-deep truncate">
                                            @(buoi.LopHoc != null ? buoi.LopHoc.TenLop : "Buổi học mã #" + buoi.MaBuoiHoc)
                                        </h3>
                                        <span class="px-2 py-0.5 rounded-md bg-surface-white text-brand-deep font-label-sm text-label-sm border border-border-standard">
                                            Phòng @buoi.PhongHoc
                                        </span>
                                    </div>
                                    <div class="flex items-center gap-4 text-outline font-body-sm text-body-sm flex-wrap">
                                        <span class="flex items-center gap-1">
                                            <span class="material-symbols-outlined text-[15px]">person</span> GV: @buoi.GiangVien
                                        </span>
                                        @if (!string.IsNullOrEmpty(buoi.NoiDung))
                                        {
                                            <span class="flex items-center gap-1 truncate max-w-xs text-on-surface-variant">
                                                <span class="material-symbols-outlined text-[15px]">description</span> @buoi.NoiDung
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center gap-2 md:flex-col md:items-end flex-shrink-0">
                                @if (buoi.TrangThai == "Đã lên lịch")
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-success-emerald/10 text-success-emerald font-label-sm text-label-sm font-semibold">
                                        <span class="h-2 w-2 rounded-full bg-success-emerald animate-pulse"></span>@buoi.TrangThai
                                    </span>
                                }
                                else if (buoi.TrangThai == "Đã hoàn thành")
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-surface-container-high text-on-surface-variant font-label-sm text-label-sm font-semibold">
                                        <span class="h-2 w-2 rounded-full bg-outline"></span>@buoi.TrangThai
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-danger-crimson/10 text-danger-crimson font-label-sm text-label-sm font-semibold">
                                        <span class="h-2 w-2 rounded-full bg-danger-crimson"></span>@buoi.TrangThai
                                    </span>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="py-8 text-center text-outline flex flex-col items-center justify-center gap-2">
                        <span class="material-symbols-outlined text-4xl text-outline/50">calendar_month</span>
                        <p class="font-medium text-xs">Chưa có buổi học nào được lên lịch.</p>
                        <a href="/BuoiHoc/Create" class="text-xs text-primary-container font-semibold hover:underline">+ Tạo lịch buổi học mới</a>
                    </div>
                }
            </div>
        </div>

        <!-- Right: Hiệu suất & Phân tích Đào tạo -->
        <div class="lg:col-span-1 bg-surface-white rounded-2xl p-6 border border-border-subtle shadow-[0_2px_12px_rgba(0,22,86,0.03)] flex flex-col justify-between gap-5">
            <div>
                <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-primary to-secondary-container flex items-center justify-center text-surface-white shadow-xs">
                            <span class="material-symbols-outlined text-base">insights</span>
                        </div>
                        <div>
                            <h2 class="font-headline-sm text-headline-sm text-brand-deep font-bold leading-tight">Chỉ Số Đào Tạo</h2>
                            <span class="text-outline font-label-sm text-label-sm">Thống kê tự động từ DB</span>
                        </div>
                    </div>
                    <span class="px-2 py-0.5 rounded-full bg-primary-container/10 text-primary-container font-label-sm text-label-sm font-semibold">Module 5</span>
                </div>

                <div class="flex flex-col items-center justify-center py-2 text-center">
                    <div class="relative w-36 h-36 flex items-center justify-center">
                        <svg class="w-36 h-36 -rotate-90" viewBox="0 0 100 100">
                            <circle class="text-border-subtle" cx="50" cy="50" fill="transparent" r="42" stroke="currentColor" stroke-width="8"></circle>
                            <circle class="transition-all duration-1000 ease-out text-primary-container" cx="50" cy="50" fill="transparent" r="42" stroke="currentColor" stroke-dasharray="263.89" stroke-dashoffset="@(263.89 * (1 - Model.TyLeHoanThanh / 100.0))" stroke-linecap="round" stroke-width="8"></circle>
                        </svg>
                        <div class="absolute flex flex-col items-center">
                            <span class="font-display text-[32px] font-black text-brand-deep tabular-nums leading-none font-mono">
                                @Model.TyLeHoanThanh%
                            </span>
                            <span class="font-label-sm text-[11px] text-outline font-medium mt-1">Hoàn thành</span>
                        </div>
                    </div>
                    <p class="font-label-md text-label-md text-brand-deep font-semibold mt-3">Tỷ lệ học viên hoàn thành môn</p>
                    <p class="font-body-sm text-body-sm text-outline mt-0.5">Dựa trên kết quả học tập đã nhập điểm</p>
                </div>
            </div>

            <div class="relative bg-gradient-to-br from-surface-container-low via-surface-container/60 to-surface-white border border-primary-fixed rounded-xl p-4 overflow-hidden">
                <div class="flex items-center gap-1.5 text-primary-container font-label-sm text-label-sm font-bold uppercase tracking-wider mb-1">
                    <span class="material-symbols-outlined text-[15px]">tips_and_updates</span>
                    <span>Thông tin vận hành</span>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
                    Hiện có <strong>@Model.LopDangMo lớp</strong> đang mở đăng ký. Đảm bảo lịch trình buổi học và phòng máy được phân bổ trước ngày khai giảng.
                </p>
                <a class="mt-3 inline-flex items-center gap-1 font-label-md text-label-md font-bold text-primary-container hover:text-primary transition-colors group" href="/BuoiHoc/Index">
                    <span>Xem danh sách lịch học</span>
                    <span class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform">arrow_forward</span>
                </a>
            </div>
        </div>
    </section>

    <!-- 4. Data Table Section: Hoạt động đăng ký gần đây -->
    <section id="dashboard-activity-section" class="bg-surface-white rounded-2xl p-6 border border-border-subtle shadow-[0_2px_12px_rgba(0,22,86,0.03)] flex flex-col gap-4 transition-opacity duration-200">
        <input type="hidden" id="dashboardCurrentStatus" value="@Model.SelectedStatus" />
        <input type="hidden" id="dashboardCurrentSearch" value="@Model.Search" />
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-3 border-b border-border-subtle">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-primary-container/10 text-primary-container flex items-center justify-center">
                    <span class="material-symbols-outlined text-[18px]">history</span>
                </div>
                <div>
                    <h2 class="font-headline-sm text-headline-sm text-brand-deep font-bold">Hoạt động đăng ký học phần</h2>
                    <span class="text-xs text-outline">Dữ liệu từ bảng Đăng ký học (cập nhật mới nhất)</span>
                </div>
            </div>

            <!-- Search & Filters Container -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[18px] pointer-events-none">search</span>
                    <input id="activitySearchInput" value="@Model.Search" class="pl-9 pr-3 py-1.5 rounded-xl border border-border-standard text-brand-deep placeholder:text-outline font-body-sm text-body-sm focus:outline-none focus:ring-2 focus:ring-primary-container/20 focus:border-primary-container w-full sm:w-60" placeholder="Tìm sinh viên, lớp..." type="text">
                </div>
                <div class="flex items-center gap-1 bg-surface-container-low p-1 rounded-xl overflow-x-auto">
                    <a href="/ThongKe/Dashboard?page=1&status=all&search=@Model.Search" 
                       onclick="event.preventDefault(); switchActivityStatus('all')" 
                       class="activity-filter-btn px-2.5 py-1 rounded-lg font-label-sm text-label-sm @(Model.SelectedStatus == "all" || string.IsNullOrEmpty(Model.SelectedStatus) ? "bg-surface-white text-primary-container font-bold shadow-xs" : "text-outline hover:text-brand-deep") whitespace-nowrap cursor-pointer">Tất cả</a>
                    <a href="/ThongKe/Dashboard?page=1&status=Chờ duyệt&search=@Model.Search" 
                       onclick="event.preventDefault(); switchActivityStatus('Chờ duyệt')" 
                       class="activity-filter-btn px-2.5 py-1 rounded-lg font-label-sm text-label-sm @(Model.SelectedStatus == "Chờ duyệt" ? "bg-surface-white text-primary-container font-bold shadow-xs" : "text-outline hover:text-brand-deep") whitespace-nowrap cursor-pointer">Chờ duyệt (@Model.DangKyChoDuyet)</a>
                    <a href="/ThongKe/Dashboard?page=1&status=Đã duyệt&search=@Model.Search" 
                       onclick="event.preventDefault(); switchActivityStatus('Đã duyệt')" 
                       class="activity-filter-btn px-2.5 py-1 rounded-lg font-label-sm text-label-sm @(Model.SelectedStatus == "Đã duyệt" ? "bg-surface-white text-primary-container font-bold shadow-xs" : "text-outline hover:text-brand-deep") whitespace-nowrap cursor-pointer">Đã duyệt (@Model.DangKyDaDuyet)</a>
                </div>
            </div>
        </div>

        <!-- Table Container -->
        <div class="w-full overflow-x-auto">
            <table class="w-full text-left border-collapse min-w-[840px]">
                <thead>
                    <tr class="border-b border-border-standard bg-canvas-base/60 text-outline font-label-sm text-label-sm uppercase tracking-wider">
                        <th class="py-3 px-4">Sinh viên</th>
                        <th class="py-3 px-4">Lớp học phần đăng ký</th>
                        <th class="py-3 px-4">Thời gian đăng ký</th>
                        <th class="py-3 px-4 text-center">Trạng thái</th>
                        <th class="py-3 px-4 text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border-subtle font-body-sm text-body-sm" id="activityTableBody">
                    @if (Model.HoatDongGanDay != null && Model.HoatDongGanDay.Any())
                    {
                        @foreach (var item in Model.HoatDongGanDay)
                        {
                            <tr class="activity-row hover:bg-canvas-base/80 transition-colors" data-category="@item.TrangThai">
                                <td class="py-3 px-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-full bg-primary-container/10 text-primary-container font-bold flex items-center justify-center font-label-md text-label-md flex-shrink-0">
                                            @(item.HocVien != null && !string.IsNullOrEmpty(item.HocVien.HoTen) ? item.HocVien.HoTen.Substring(0, 1) : "H")
                                        </div>
                                        <div class="flex flex-col">
                                            <span class="font-headline-sm text-brand-deep font-semibold text-[14px]">
                                                @(item.HocVien != null ? item.HocVien.HoTen : "Học viên #" + item.MaHocVien)
                                            </span>
                                            <span class="font-mono text-outline text-[11px] tabular-nums">
                                                MSSV: @(item.HocVien != null ? item.HocVien.MaHocVien.ToString() : "N/A")
                                            </span>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 px-4">
                                    <div class="flex flex-col">
                                        <span class="font-semibold text-brand-deep">
                                            @(item.LopHoc != null ? item.LopHoc.TenLop : "Lớp #" + item.MaLop)
                                        </span>
                                        <span class="text-outline text-[12px] font-mono">
                                            GV: @(item.LopHoc != null ? item.LopHoc.GiangVien : "Chưa xếp")
                                        </span>
                                    </div>
                                </td>
                                <td class="py-3 px-4">
                                    <span class="font-mono text-outline text-[12px] flex items-center gap-1">
                                        <span class="material-symbols-outlined text-[14px]">schedule</span>
                                        @item.NgayDangKy.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </td>
                                <td class="py-3 px-4 text-center">
                                    @if (item.TrangThai == "Chờ duyệt")
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-warning-amber/10 text-secondary font-label-sm text-label-sm font-semibold">
                                            <span class="h-1.5 w-1.5 rounded-full bg-warning-amber animate-pulse"></span>Chờ duyệt
                                        </span>
                                    }
                                    else if (item.TrangThai == "Đã duyệt" || item.TrangThai == "Đã đóng học phí" || item.TrangThai == "Đang học")
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-success-emerald/10 text-success-emerald font-label-sm text-label-sm font-semibold">
                                            <span class="h-1.5 w-1.5 rounded-full bg-success-emerald"></span>@item.TrangThai
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-error-container text-danger-crimson font-label-sm text-label-sm font-semibold">
                                            <span class="h-1.5 w-1.5 rounded-full bg-danger-crimson"></span>@item.TrangThai
                                        </span>
                                    }
                                </td>
                                <td class="py-3 px-4 text-right">
                                    <div class="inline-flex items-center gap-1">
                                        @if (item.TrangThai == "Chờ duyệt")
                                        {
                                            <form asp-controller="ThongKe" asp-action="DuyetNhanh" asp-route-id="@item.MaDangKy" method="post" class="inline" onsubmit="event.preventDefault(); submitDuyetNhanh(this);">
                                                <button class="p-1 rounded-lg text-outline hover:text-success-emerald hover:bg-success-emerald/10 transition-colors cursor-pointer" title="Duyệt nhanh" type="submit">
                                                    <span class="material-symbols-outlined text-[19px]">check_circle</span>
                                                </button>
                                            </form>
                                        }
                                        <a href="/KetQuaHocTap/Index" class="p-1 rounded-lg text-outline hover:text-primary-container hover:bg-surface-container-low transition-colors" title="Xem kết quả">
                                            <span class="material-symbols-outlined text-[19px]">visibility</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="py-8 text-center text-outline">
                                Không có dữ liệu hoạt động đăng ký.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Footer -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-3 border-t border-border-subtle font-body-sm text-body-sm text-outline">
            <span class="tabular-nums">
                Trang <strong class="text-brand-deep font-semibold">@Model.CurrentPage</strong> / <strong class="text-brand-deep font-semibold">@Model.TotalPages</strong>
            </span>
            <div class="inline-flex items-center gap-1">
                @if (Model.CurrentPage > 1)
                {
                    <a href="/ThongKe/Dashboard?page=@(Model.CurrentPage - 1)&status=@Model.SelectedStatus&search=@Model.Search" onclick="event.preventDefault(); loadDashboardPage(this.href)" class="px-2.5 py-1 rounded-lg border border-border-standard text-brand-deep hover:bg-canvas-base transition-colors font-label-md text-label-md cursor-pointer">
                        Trước
                    </a>
                }
                else
                {
                    <span class="px-2.5 py-1 rounded-lg border border-border-standard text-outline/40 font-label-md text-label-md cursor-not-allowed">
                        Trước
                    </span>
                }

                @for (int p = Model.CurrentPage - 1; p <= Model.CurrentPage + 1; p++)
                {
                    if (p >= 1 && p <= Model.TotalPages)
                    {
                        if (p == Model.CurrentPage)
                        {
                            <span class="w-8 h-8 rounded-lg bg-primary-container text-surface-white font-label-md text-label-md font-bold flex items-center justify-center font-mono">@p</span>
                        }
                        else
                        {
                            <a href="/ThongKe/Dashboard?page=@p&status=@Model.SelectedStatus&search=@Model.Search" onclick="event.preventDefault(); loadDashboardPage(this.href)" class="w-8 h-8 rounded-lg border border-border-standard text-brand-deep hover:bg-canvas-base transition-colors font-label-md text-label-md flex items-center justify-center font-mono cursor-pointer">@p</a>
                        }
                    }
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a href="/ThongKe/Dashboard?page=@(Model.CurrentPage + 1)&status=@Model.SelectedStatus&search=@Model.Search" onclick="event.preventDefault(); loadDashboardPage(this.href)" class="px-2.5 py-1 rounded-lg border border-border-standard text-brand-deep hover:bg-canvas-base transition-colors font-label-md text-label-md cursor-pointer">
                        Sau
                    </a>
                }
                else
                {
                    <span class="px-2.5 py-1 rounded-lg border border-border-standard text-outline/40 font-label-md text-label-md cursor-not-allowed">
                        Sau
                    </span>
                }
            </div>
        </div>
    </section>
</div>

@section Scripts {
<script>
    // Universal AJAX Page Loader for Dashboard Activities Table
    async function loadDashboardPage(url, pushState = true) {
        const section = document.getElementById('dashboard-activity-section');
        const searchInput = document.getElementById('activitySearchInput');
        const wasSearchFocused = (document.activeElement === searchInput);
        const cursorStart = searchInput ? searchInput.selectionStart : 0;
        const cursorEnd = searchInput ? searchInput.selectionEnd : 0;

        if (section) {
            section.classList.add('opacity-50', 'pointer-events-none');
        }

        try {
            const res = await fetch(url, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            const html = await res.text();
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');

            const newSection = doc.getElementById('dashboard-activity-section');
            if (newSection && section) {
                section.innerHTML = newSection.innerHTML;
                initActivityFilters();

                if (wasSearchFocused) {
                    const newSearch = document.getElementById('activitySearchInput');
                    if (newSearch) {
                        newSearch.focus();
                        newSearch.setSelectionRange(cursorStart, cursorEnd);
                    }
                }
            }

            if (pushState) {
                window.history.pushState({ url: url }, '', url);
            }
        } catch (err) {
            console.error('Lỗi khi tải trang Dashboard:', err);
            window.location.href = url;
        } finally {
            if (section) {
                section.classList.remove('opacity-50', 'pointer-events-none');
            }
        }
    }

    window.addEventListener('popstate', (e) => {
        if (e.state && e.state.url) {
            loadDashboardPage(e.state.url, false);
        } else {
            loadDashboardPage(window.location.href, false);
        }
    });

    // Handle AJAX DuyetNhanh
    async function submitDuyetNhanh(form) {
        const btn = form.querySelector('button');
        if (btn) btn.disabled = true;

        try {
            const formData = new FormData(form);
            const res = await fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            const contentType = res.headers.get("content-type");
            if (contentType && contentType.indexOf("application/json") !== -1) {
                const data = await res.json();
                if (data.success) {
                    if (window.showToast) window.showToast(data.message, 'success');
                    await loadDashboardPage(window.location.href, false);
                } else {
                    if (window.showToast) window.showToast(data.message, 'error');
                }
            } else {
                await loadDashboardPage(window.location.href, false);
            }
        } catch (err) {
            console.error('Lỗi duyệt nhanh:', err);
            if (window.showToast) window.showToast('Có lỗi xảy ra khi phê duyệt.', 'error');
        } finally {
            if (btn) btn.disabled = false;
        }
    }

    // Switch status filter preserving current search query
    function switchActivityStatus(status) {
        const searchInput = document.getElementById('activitySearchInput');
        const search = searchInput ? searchInput.value.trim() : '';
        const url = `/ThongKe/Dashboard?page=1&status=${encodeURIComponent(status)}&search=${encodeURIComponent(search)}`;
        loadDashboardPage(url);
    }

    // Initialize activity search & enter handling
    let dashboardSearchTimer = null;
    function initActivityFilters() {
        const searchInput = document.getElementById('activitySearchInput');
        if (searchInput) {
            searchInput.oninput = (e) => {
                clearTimeout(dashboardSearchTimer);
                dashboardSearchTimer = setTimeout(() => {
                    const q = e.target.value.trim();
                    const status = document.getElementById('dashboardCurrentStatus')?.value || 'all';
                    const url = `/ThongKe/Dashboard?page=1&status=${encodeURIComponent(status)}&search=${encodeURIComponent(q)}`;
                    loadDashboardPage(url);
                }, 400);
            };

            searchInput.onkeydown = (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    clearTimeout(dashboardSearchTimer);
                    const q = searchInput.value.trim();
                    const status = document.getElementById('dashboardCurrentStatus')?.value || 'all';
                    const url = `/ThongKe/Dashboard?page=1&status=${encodeURIComponent(status)}&search=${encodeURIComponent(q)}`;
                    loadDashboardPage(url);
                }
            };
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        initActivityFilters();
    });
</script>
}
