@*
Họ và tên: Nguyễn Tùng Dương
Mã sinh viên: 23103100003
Nội dung thực hiện: Module 5 - Báo cáo Thống kê LINQ - Phong cách Prep.vn
*@

@{
    ViewData["Title"] = "Báo cáo thống kê";
    double tongDoanhThu = ViewBag.TongDoanhThu ?? 0;
    double avgLapDay = ViewBag.AvgLapDay ?? 0;
    int tongChoHoc = ViewBag.TongChoHoc ?? 0;
    int choDaDangKy = ViewBag.ChoDaDangKy ?? 0;
    int tongBuoiHoc = ViewBag.TongBuoiHoc ?? 0;
    int dangKyChoDuyet = ViewBag.DangKyChoDuyet ?? 0;
    double tyLeHoanThanh = ViewBag.TyLeHoanThanh ?? 0;

    var doanhThuTheoThang = ViewBag.DoanhThuTheoThang as IEnumerable<QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.ViewModels.ThongKeDoanhThuVM> ?? new List<QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.ViewModels.ThongKeDoanhThuVM>();
    var dkTheoThang = ViewBag.DKTheoThang as IEnumerable<dynamic> ?? new List<dynamic>();
    var doanhThuCTDT = ViewBag.DoanhThuTheoCTDT as IEnumerable<dynamic> ?? new List<dynamic>();
    var topGiangVien = ViewBag.TopGiangVien as IEnumerable<dynamic> ?? new List<dynamic>();
    var lopNhieuDK = ViewBag.LopNhieuDKNhat as dynamic;
}

<div class="flex flex-col gap-y-6">
    <!-- Top Header Bar -->
    <section class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 bg-surface-white p-5 rounded-2xl border border-border-subtle shadow-[0_2px_12px_rgba(0,22,86,0.03)]">
        <div class="flex flex-col gap-1">
            <div class="flex items-center gap-2 text-outline font-body-sm text-body-sm">
                <span>Đào tạo UNETI</span>
                <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                <span class="text-primary-container font-label-md text-label-md">Thống kê tổng hợp</span>
            </div>
            <h1 class="font-headline-lg-mobile lg:font-headline-lg text-brand-deep tracking-tight font-extrabold">
                Báo cáo thống kê
            </h1>
            <p class="font-body-sm text-body-sm text-outline">
                Tổng hợp chỉ số tài chính học phí, tỷ lệ lấp đầy lớp, tiến độ đăng ký và chất lượng đào tạo Module 5.
            </p>
        </div>

        <div class="flex items-center flex-wrap gap-2.5">
            <button onclick="location.reload()" class="flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-border-standard bg-surface-white hover:bg-canvas-base text-brand-deep font-label-md text-label-md transition-all shadow-xs cursor-pointer">
                <span class="material-symbols-outlined text-outline text-[18px]">sync</span>
                <span>Làm mới dữ liệu</span>
            </button>
            @* <button onclick="window.print()" class="flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-primary-container text-surface-white hover:bg-primary font-label-md text-label-md transition-all shadow-xs cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">picture_as_pdf</span>
                <span>Xuất PDF Báo cáo</span>
            </button> *@
        </div>
    </section>

    <!-- Context Sub-bar (Prep.vn Style) -->
    <section class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 bg-surface-white p-4 rounded-2xl border border-border-subtle shadow-xs">
        <div class="flex flex-wrap items-center gap-3">
            <div class="flex items-center gap-2">
                <span class="relative flex h-2.5 w-2.5">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-success-emerald opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-success-emerald"></span>
                </span>
                <span class="font-label-sm text-label-sm uppercase tracking-wider text-outline font-bold">Trạng thái hệ thống</span>
            </div>
            <div class="h-4 w-[1px] bg-border-standard hidden sm:block"></div>
            <p class="font-body-md text-body-md text-brand-deep font-semibold">Dữ liệu thống kê tổng hợp toàn học viện theo thời gian thực</p>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-surface-container-low text-primary-container font-label-sm text-label-sm font-semibold">
                <span class="material-symbols-outlined text-[14px]">sync</span>
                Đồng bộ tự động LINQ
            </span>
        </div>
        <div class="inline-flex items-center p-1 bg-surface-container-low rounded-xl border border-border-subtle">
            <span class="px-3.5 py-1 rounded-lg font-label-md text-label-md bg-surface-white text-primary-container font-bold shadow-xs">Học kỳ 1 • 2024-2025</span>
        </div>
    </section>

    <!-- Row 1: 4 High-level KPI Bento Cards -->
    <section class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5">
        <!-- Card 1: Doanh thu Học phí -->
        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle shadow-[0_2px_12px_rgba(0,22,86,0.03)] flex flex-col justify-between hover:-translate-y-0.5 transition-transform duration-200">
            <div>
                <div class="flex items-center justify-between">
                    <span class="font-label-sm text-label-sm text-outline uppercase tracking-wider font-bold">Doanh thu Học phí</span>
                    <div class="w-10 h-10 rounded-xl bg-success-emerald/10 text-success-emerald flex items-center justify-center">
                        <span class="material-symbols-outlined text-[20px]">account_balance_wallet</span>
                    </div>
                </div>
                <div class="mt-3">
                    <div class="font-display text-[26px] leading-8 text-brand-deep tracking-tight tabular-nums font-extrabold font-mono">
                        @(tongDoanhThu >= 1_000_000_000 ? (tongDoanhThu / 1_000_000_000.0).ToString("0.00") + " Tỷ VNĐ" : (tongDoanhThu >= 1_000_000 ? (tongDoanhThu / 1_000_000.0).ToString("0.0") + " Tr VNĐ" : tongDoanhThu.ToString("N0") + " VNĐ"))
                    </div>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t border-border-subtle flex items-center justify-between flex-wrap gap-2 text-xs">
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-success-emerald/10 text-success-emerald font-label-sm text-label-sm font-bold">
                    <span class="material-symbols-outlined text-[13px]">arrow_upward</span> Thực thu
                </span>
                <span class="font-body-sm text-body-sm text-on-surface-variant">Hệ chính quy &amp; Liên thông</span>
            </div>
        </div>

        <!-- Card 2: Tỷ lệ Lấp đầy Lớp học -->
        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle shadow-[0_2px_12px_rgba(0,22,86,0.03)] flex flex-col justify-between hover:-translate-y-0.5 transition-transform duration-200">
            <div>
                <div class="flex items-center justify-between">
                    <span class="font-label-sm text-label-sm text-outline uppercase tracking-wider font-bold">Tỷ lệ lấp đầy lớp học</span>
                    <div class="w-10 h-10 rounded-xl bg-primary-container/10 text-primary-container flex items-center justify-center">
                        <span class="material-symbols-outlined text-[20px]">group</span>
                    </div>
                </div>
                <div class="mt-3 flex items-center justify-between">
                    <div class="font-display text-[26px] leading-8 text-brand-deep tracking-tight tabular-nums font-extrabold font-mono">
                        @avgLapDay%
                    </div>
                    <!-- Radial circle -->
                    <div class="relative w-11 h-11 flex items-center justify-center">
                        <svg class="w-11 h-11 transform -rotate-90" viewBox="0 0 36 36">
                            <path class="text-surface-container-high" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="currentColor" stroke-width="3.5"></path>
                            <path class="text-primary-container stroke-current" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke-dasharray="@avgLapDay, 100" stroke-linecap="round" stroke-width="3.5"></path>
                        </svg>
                        <span class="material-symbols-outlined text-[16px] text-primary-container absolute">check</span>
                    </div>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t border-border-subtle flex items-center justify-between text-xs">
                <span class="font-body-sm text-body-sm text-on-surface-variant tabular-nums font-semibold">@choDaDangKy / @tongChoHoc chỗ</span>
                <span class="font-label-sm text-label-sm text-primary font-bold">Tối ưu</span>
            </div>
        </div>

        <!-- Card 3: Số buổi Giảng dạy -->
        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle shadow-[0_2px_12px_rgba(0,22,86,0.03)] flex flex-col justify-between hover:-translate-y-0.5 transition-transform duration-200">
            <div>
                <div class="flex items-center justify-between">
                    <span class="font-label-sm text-label-sm text-outline uppercase tracking-wider font-bold">Tổng số buổi học</span>
                    <div class="w-10 h-10 rounded-xl bg-tertiary/10 text-tertiary flex items-center justify-center">
                        <span class="material-symbols-outlined text-[20px]">calendar_month</span>
                    </div>
                </div>
                <div class="mt-3 flex items-baseline gap-2">
                    <div class="font-display text-[26px] leading-8 text-brand-deep tracking-tight tabular-nums font-extrabold font-mono">
                        @tongBuoiHoc
                    </div>
                    <span class="font-body-md text-body-md text-on-surface-variant font-medium">buổi học</span>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t border-border-subtle flex items-center justify-between text-xs">
                <span class="font-body-sm text-body-sm text-on-surface-variant">Toàn bộ các cơ sở</span>
                <span class="font-label-sm text-label-sm text-success-emerald font-bold">Đã lên lịch</span>
            </div>
        </div>

        <!-- Card 4: Đăng ký cần xử lý -->
        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle shadow-[0_2px_12px_rgba(0,22,86,0.03)] flex flex-col justify-between hover:-translate-y-0.5 transition-transform duration-200">
            <div>
                <div class="flex items-center justify-between">
                    <span class="font-label-sm text-label-sm text-outline uppercase tracking-wider font-bold">Đăng ký cần xử lý</span>
                    <div class="w-10 h-10 rounded-xl bg-warning-amber/15 text-warning-amber flex items-center justify-center">
                        <span class="material-symbols-outlined text-[20px]">pending_actions</span>
                    </div>
                </div>
                <div class="mt-3 flex items-baseline gap-2">
                    <div class="font-display text-[26px] leading-8 text-warning-amber tracking-tight tabular-nums font-extrabold font-mono">
                        @dangKyChoDuyet
                    </div>
                    <span class="font-body-md text-body-md text-warning-amber font-semibold">yêu cầu</span>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t border-border-subtle flex items-center justify-between text-xs">
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-warning-amber/15 text-on-secondary-container font-label-sm text-label-sm font-bold">
                    <span class="material-symbols-outlined text-[13px] text-warning-amber">hourglass_top</span> Chờ phê duyệt
                </span>
                <a href="/ThongKe/Dashboard" class="font-label-sm text-label-sm text-primary hover:underline font-bold">Xử lý ngay</a>
            </div>
        </div>
    </section>

    <!-- Row 2: Main Analytics Charts -->
    <section class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Biểu đồ Xu hướng Đăng ký & Doanh thu theo tháng (col-span-2) -->
        <div class="lg:col-span-2 bg-surface-white rounded-2xl p-5 lg:p-6 border border-border-subtle shadow-[0_2px_12px_rgba(0,22,86,0.03)] flex flex-col justify-between gap-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-3 border-b border-border-subtle">
                <div>
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-primary-container"></span>
                        <h2 class="font-headline-sm text-headline-sm text-brand-deep font-bold">Biểu đồ Đăng ký theo Tháng</h2>
                    </div>
                    <p class="font-body-sm text-body-sm text-outline mt-0.5">Số lượng đăng ký học phần được tổng hợp bằng LINQ</p>
                </div>
                <span class="inline-flex items-center gap-1 px-3 py-1 rounded-xl bg-surface-container-low text-primary-container font-label-sm text-label-sm font-semibold">
                    <span class="material-symbols-outlined text-[15px]">show_chart</span> Dữ liệu tháng
                </span>
            </div>

            <!-- Dynamic Bar/Column representation for Monthly Registrations -->
            <div class="pt-4 pb-2">
                @if (dkTheoThang.Any())
                {
                    int maxCount = 1;
                    foreach (var item in dkTheoThang)
                    {
                        if ((int)item.SoLuong > maxCount) maxCount = (int)item.SoLuong;
                    }

                    <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-4 items-end min-h-[180px] pt-4 px-2">
                        @foreach (var item in dkTheoThang)
                        {
                            int heightPct = (int)Math.Max(15, ((double)item.SoLuong / maxCount) * 100);
                            <div class="flex flex-col items-center gap-2 h-full justify-end group">
                                <span class="font-mono text-xs font-bold text-primary-container opacity-90 group-hover:scale-110 transition-transform">
                                    @item.SoLuong lượt
                                </span>
                                <div class="w-full max-w-[42px] bg-gradient-to-t from-primary to-primary-container rounded-t-xl transition-all duration-500 shadow-xs group-hover:from-blue-700 group-hover:to-blue-500" style="height: @(heightPct)%"></div>
                                <span class="font-label-sm text-label-sm text-brand-deep font-semibold mt-1">
                                    Tháng @item.Thang
                                </span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="py-12 text-center text-outline">
                        <span class="material-symbols-outlined text-4xl text-outline/50">bar_chart</span>
                        <p class="text-xs mt-1">Chưa có dữ liệu đăng ký theo tháng.</p>
                    </div>
                }
            </div>

            <div class="pt-3 border-t border-border-subtle flex items-center justify-between text-xs text-outline">
                <span class="flex items-center gap-1">
                    <span class="material-symbols-outlined text-success-emerald text-[16px]">trending_up</span>
                    <span>Tự động cập nhật mỗi khi có sinh viên đăng ký học phần mới.</span>
                </span>
            </div>
        </div>

        <!-- Cơ cấu Doanh thu theo CTĐT (col-span-1) -->
        <div class="bg-surface-white rounded-2xl p-5 lg:p-6 border border-border-subtle shadow-[0_2px_12px_rgba(0,22,86,0.03)] flex flex-col justify-between gap-4">
            <div class="flex items-center justify-between pb-3 border-b border-border-subtle">
                <div>
                    <h2 class="font-headline-sm text-headline-sm text-brand-deep font-bold">Nguồn thu theo CTĐT</h2>
                    <p class="font-body-sm text-body-sm text-outline">Tỷ trọng các chương trình</p>
                </div>
                <span class="material-symbols-outlined text-outline">pie_chart</span>
            </div>

            <!-- Donut / List View -->
            <div class="flex flex-col gap-3 py-2">
                @if (doanhThuCTDT.Any())
                {
                    var colors = new string[] { "#0068FF", "#FF7A00", "#10B981", "#8B5CF6", "#F59E0B" };
                    int colorIdx = 0;

                    foreach (var ctdt in doanhThuCTDT)
                    {
                        var color = colors[colorIdx % colors.Length];
                        double dt = (double)ctdt.DoanhThu;
                        double pct = tongDoanhThu > 0 ? Math.Round(dt / tongDoanhThu * 100, 1) : 0;

                        <div class="flex flex-col gap-1.5 p-2 rounded-xl hover:bg-canvas-base transition-colors">
                            <div class="flex items-center justify-between text-xs">
                                <div class="flex items-center gap-2 min-w-0">
                                    <span class="w-3 h-3 rounded-full shrink-0" style="background-color: @color"></span>
                                    <span class="font-semibold text-brand-deep truncate max-w-[160px]" title="@ctdt.Ten">@ctdt.Ten</span>
                                </div>
                                <div class="flex items-center gap-2 shrink-0">
                                    <span class="font-mono text-xs font-bold text-brand-deep">@dt.ToString("N0") đ</span>
                                    <span class="px-2 py-0.5 rounded-full font-label-sm text-label-sm font-bold bg-surface-container-low text-primary-container">
                                        @pct%
                                    </span>
                                </div>
                            </div>
                            <div class="w-full bg-border-subtle rounded-full h-1.5 overflow-hidden">
                                <div class="h-1.5 rounded-full" style="width: @pct%; background-color: @color"></div>
                            </div>
                        </div>
                        colorIdx++;
                    }
                }
                else
                {
                    <div class="py-8 text-center text-outline">
                        <p class="text-xs">Chưa có dữ liệu học phí đóng theo chương trình.</p>
                    </div>
                }
            </div>

            <div class="pt-3 border-t border-border-subtle text-center text-xs text-outline">
                Tổng doanh thu thực tế: <strong class="text-brand-deep font-mono">@tongDoanhThu.ToString("N0") VNĐ</strong>
            </div>
        </div>
    </section>

    <!-- Row 3: Operational Insights & Top Lecturers -->
    <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Left: Bảng Xếp Hạng Giảng Viên Xuất Sắc -->
        <div class="bg-surface-white rounded-2xl p-5 lg:p-6 border border-border-subtle shadow-[0_2px_12px_rgba(0,22,86,0.03)] flex flex-col justify-between gap-4">
            <div class="flex items-center justify-between pb-3 border-b border-border-subtle">
                <div>
                    <h2 class="font-headline-sm text-headline-sm text-brand-deep font-bold">Giảng Viên &amp; Lớp Học Phần</h2>
                    <p class="font-body-sm text-body-sm text-outline">Thống kê số lượng sinh viên phụ trách &amp; điểm TB</p>
                </div>
                <span class="material-symbols-outlined text-outline">leaderboard</span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead>
                        <tr class="text-outline font-label-sm text-label-sm border-b border-border-subtle uppercase">
                            <th class="py-2.5 pr-3 font-bold">Giảng viên</th>
                            <th class="py-2.5 px-3 font-bold">Lớp phụ trách</th>
                            <th class="py-2.5 px-3 font-bold text-center">Số SV</th>
                            <th class="py-2.5 pl-3 font-bold text-right">Điểm TB</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border-subtle">
                        @if (topGiangVien.Any())
                        {
                            foreach (var gv in topGiangVien)
                            {
                                <tr class="hover:bg-canvas-base transition-colors">
                                    <td class="py-3 pr-3">
                                        <div class="flex items-center gap-2.5">
                                            <div class="w-8 h-8 rounded-xl bg-primary-container/10 text-primary-container font-bold flex items-center justify-center font-label-md text-label-md shrink-0">
                                                @(!string.IsNullOrEmpty(gv.GiangVien) ? gv.GiangVien.Substring(0, 1).ToUpper() : "G")
                                            </div>
                                            <div class="min-w-0">
                                                <p class="font-label-md text-label-md text-brand-deep font-bold truncate">@gv.GiangVien</p>
                                                <p class="font-body-sm text-body-sm text-outline truncate max-w-[130px]">@gv.MonHoc</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3 px-3">
                                        <span class="font-semibold text-brand-deep">@gv.SoLop lớp</span>
                                    </td>
                                    <td class="py-3 px-3 text-center">
                                        <span class="font-mono font-bold text-brand-deep">@gv.SoSV</span>
                                    </td>
                                    <td class="py-3 pl-3 text-right">
                                        <div class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-success-emerald/10 text-success-emerald font-label-sm text-label-sm font-bold">
                                            <span class="material-symbols-outlined text-[13px] text-warning-amber">star</span>
                                            <span>@gv.DiemTB</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="py-6 text-center text-outline">
                                    Chưa có dữ liệu giảng viên phụ trách.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="pt-3 border-t border-border-subtle flex items-center justify-between text-xs text-outline">
                <span>Tiêu chí: Số lớp phân công và kết quả điểm thi sinh viên.</span>
            </div>
        </div>

        <!-- Right: Tóm tắt Điều hành & Khuyến nghị Đào tạo -->
        <div class="bg-gradient-to-br from-surface-container-low via-surface-white to-surface-container/40 border border-primary/20 rounded-2xl p-5 lg:p-6 shadow-sm flex flex-col justify-between gap-4">
            <div>
                <div class="flex items-center justify-between pb-3 border-b border-border-subtle">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary-container text-[22px]">insights</span>
                        <h2 class="font-headline-sm text-headline-sm text-brand-deep font-bold">Tóm tắt Điều hành</h2>
                    </div>
                    <span class="px-2.5 py-0.5 rounded-full bg-primary-container/10 text-primary-container font-label-sm text-label-sm font-bold">
                        Module 5
                    </span>
                </div>

                <div class="mt-4 space-y-3 text-xs">
                    <div class="flex items-start gap-3 p-3 rounded-xl bg-surface-white border border-border-subtle">
                        <div class="w-6 h-6 rounded-lg bg-primary-container/10 text-primary-container font-bold flex items-center justify-center shrink-0">1</div>
                        <p class="text-on-surface leading-snug">
                            <strong class="text-brand-deep">Tỷ lệ sinh viên hoàn thành môn đạt @tyLeHoanThanh%</strong> trên tổng số học viên đã có điểm kết quả tổng kết.
                        </p>
                    </div>

                    @if (lopNhieuDK != null)
                    {
