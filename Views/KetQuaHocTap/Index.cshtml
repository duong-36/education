@*
Họ và tên: Nguyễn Tùng Dương
Mã sinh viên: 23103100003
Nội dung thực hiện: Module 5 - Quản lý Kết quả học tập CRUD chuẩn phong cách Prep.vn
*@

@model IEnumerable<QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.Models.KetQuaHocTap>
@{
    ViewData["Title"] = "Kết quả học tập";

    int totalGraded = ViewBag.TotalGraded ?? 0;
    int passCount = ViewBag.PassCount ?? 0;
    int failCount = ViewBag.FailCount ?? 0;
    double avgScore = ViewBag.AverageScore ?? 0;
    double passRate = ViewBag.PassRate ?? 0;

    int countA = ViewBag.CountA ?? 0;
    int countB = ViewBag.CountB ?? 0;
    int countC = ViewBag.CountC ?? 0;
    int countD = ViewBag.CountD ?? 0;
    int countF = ViewBag.CountF ?? 0;

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalRecords = ViewBag.TotalRecords ?? 0;
    int pageSize = 8;
    int startRecord = totalRecords == 0 ? 0 : (currentPage - 1) * pageSize + 1;
    int endRecord = Math.Min(currentPage * pageSize, totalRecords);

    var lopHocs = ViewBag.LopHocList as IEnumerable<QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.Models.LopHoc> ?? new List<QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.Models.LopHoc>();
    var eligibleDangKys = ViewBag.EligibleDangKys as IEnumerable<QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.Models.DangKyHoc> ?? new List<QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.Models.DangKyHoc>();

    int? selectedMaLop = ViewBag.SelectedMaLop;
    string selectedKetQua = ViewBag.SelectedKetQua as string ?? "";
    string search = ViewBag.Search as string ?? "";
}

<!-- Alert Notification -->
@if (TempData["Success"] != null)
{
    <div id="toast-success" class="mb-4 flex items-center justify-between p-4 bg-emerald-50 border border-emerald-200 rounded-2xl text-emerald-800 shadow-sm animate-fade-in">
        <div class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-success-emerald text-[22px]">check_circle</span>
            <span class="font-label-md text-label-md font-semibold">@TempData["Success"]</span>
        </div>
        <button onclick="document.getElementById('toast-success').remove()" class="text-emerald-600 hover:text-emerald-900">
            <span class="material-symbols-outlined text-[18px]">close</span>
        </button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div id="toast-error" class="mb-4 flex items-center justify-between p-4 bg-red-50 border border-red-200 rounded-2xl text-danger-crimson shadow-sm animate-fade-in">
        <div class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-danger-crimson text-[22px]">error</span>
            <span class="font-label-md text-label-md font-semibold">@TempData["Error"]</span>
        </div>
        <button onclick="document.getElementById('toast-error').remove()" class="text-red-500 hover:text-red-800">
            <span class="material-symbols-outlined text-[18px]">close</span>
        </button>
    </div>
}

<div id="ketqua-content-area" class="flex flex-col gap-y-6 transition-opacity duration-200">
    <!-- Contextual Sub-Header & Controls -->
    <section class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 bg-surface-white p-5 rounded-2xl border border-border-subtle shadow-[0_2px_12px_rgba(0,22,86,0.03)]">
        <div class="flex items-center gap-space-sm min-w-0">
            <div class="flex flex-col">
                <div class="flex items-center gap-1.5 text-outline font-label-sm text-label-sm tracking-wide">
                    <span>ĐÀO TẠO UNETI</span>
                    <span class="material-symbols-outlined text-[13px]">chevron_right</span>
                    <span class="text-primary-container font-semibold">ĐIỂM SỐ & CHỨNG CHỈ</span>
                </div>
                <h1 class="font-headline-md text-headline-md text-brand-deep tracking-tight truncate font-extrabold mt-0.5">
                    Kết quả học tập
                </h1>
            </div>
        </div>

        <div class="flex items-center flex-wrap gap-2.5">
            @* <button onclick="exportTableToCSV('bang-diem-sinh-vien.csv')" class="inline-flex items-center gap-1.5 bg-surface-white border border-border-standard hover:bg-surface-container-low text-brand-deep font-label-md text-label-md px-3.5 py-2 rounded-xl transition-all shadow-xs cursor-pointer">
                <span class="material-symbols-outlined text-[18px] text-primary">file_download</span>
                <span class="hidden sm:inline">Xuất bảng điểm Excel</span>
            </button> *@
            <button onclick="openDrawer('create')" class="inline-flex items-center gap-1.5 bg-secondary-container hover:bg-secondary text-surface-white font-label-md text-label-md px-4 py-2 rounded-xl shadow-sm hover:shadow-md transition-transform active:scale-95 cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">add_circle</span>
                <span> Vào điểm mới</span>
            </button>
        </div>
    </section>

    <!-- Quick Analytics Stats Row (3 Cards) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <!-- Stat 1 -->
        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle shadow-[0_1px_3px_rgba(0,22,86,0.04),0_8px_24px_-4px_rgba(0,22,86,0.06)] flex items-center justify-between">
            <div>
                <span class="font-label-sm text-label-sm text-outline tracking-wider uppercase block mb-1">Tổng học viên có điểm</span>
                <div class="flex items-baseline gap-2">
                    <span class="font-metric-stat text-metric-stat text-brand-deep tabular-nums">@totalGraded</span>
                    <span class="font-body-sm text-body-sm text-outline">học viên</span>
                </div>
                <div class="flex items-center gap-2 mt-2">
                    <span class="inline-flex items-center gap-1 font-label-sm text-label-sm text-success-emerald bg-[#10B981]/10 px-2 py-0.5 rounded-full">
                        <span class="w-1.5 h-1.5 rounded-full bg-success-emerald animate-pulse"></span>
                        @passCount Đạt
                    </span>
                    <span class="font-body-sm text-body-sm text-outline">/ @failCount Chưa đạt</span>
                </div>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-[26px]">school</span>
            </div>
        </div>

        <!-- Stat 2 -->
        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle shadow-[0_1px_3px_rgba(0,22,86,0.04),0_8px_24px_-4px_rgba(0,22,86,0.06)] flex items-center justify-between">
            <div>
                <span class="font-label-sm text-label-sm text-outline tracking-wider uppercase block mb-1">Điểm trung bình toàn khóa</span>
                <div class="flex items-baseline gap-2">
                    <span class="font-metric-stat text-metric-stat text-brand-deep tabular-nums">@avgScore.ToString("F2")</span>
                    <span class="font-body-sm text-body-sm text-outline">/ 10</span>
                </div>
                <div class="flex items-center gap-1.5 mt-2">
                    <span class="font-label-sm text-label-sm text-primary font-bold">Loại A: @countA SV</span>
                    <span class="font-body-sm text-body-sm text-outline">(B: @countB, C: @countC)</span>
                </div>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-secondary-container/10 flex items-center justify-center text-secondary-container">
                <span class="material-symbols-outlined text-[26px]">grade</span>
            </div>
        </div>

        <!-- Stat 3 -->
        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle shadow-[0_1px_3px_rgba(0,22,86,0.04),0_8px_24px_-4px_rgba(0,22,86,0.06)] flex items-center justify-between">
            <div class="min-w-0 pr-2">
                <span class="font-label-sm text-label-sm text-outline tracking-wider uppercase block mb-1">Tỷ lệ hoàn thành</span>
                <p class="font-headline-sm text-headline-sm text-brand-deep truncate">
                    @passRate% Đạt chuẩn
                </p>
                <div class="flex items-center gap-2 mt-2">
                    <span class="font-label-md text-label-md text-success-emerald font-bold tabular-nums">@(totalGraded > 0 ? passCount : 0) Đạt</span>
                    <span class="font-body-sm text-body-sm text-outline">(Đạt chuẩn đầu ra UNETI)</span>
                </div>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-tertiary/10 flex items-center justify-center text-tertiary flex-shrink-0">
                <span class="material-symbols-outlined text-[26px]">workspace_premium</span>
            </div>
        </div>
    </div>

    <!-- Filter & Operation Toolbar -->
    <div class="bg-surface-white rounded-2xl p-4 border border-border-subtle shadow-sm flex flex-col lg:flex-row items-center justify-between gap-4">
        <form method="get" action="/KetQuaHocTap/Index" class="flex flex-wrap items-center gap-3 w-full lg:w-auto" id="filter-form" onsubmit="event.preventDefault(); filterKetQuaAjax();">
            <!-- Search Field -->
            @* <div class="relative flex-1 sm:w-80">
                <span class="material-symbols-outlined text-outline absolute left-3 top-1/2 -translate-y-1/2 text-[18px]">search</span>
                <input name="search" value="@search" class="w-full bg-surface-container-low border border-border-standard pl-9 pr-8 py-2 rounded-xl text-on-surface font-body-sm text-body-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" id="table-search" placeholder="Tìm theo tên SV, mã SV, lớp học..." type="text"/>
                @if (!string.IsNullOrEmpty(search))
                {
                    <a href="/KetQuaHocTap/Index" onclick="event.preventDefault(); loadKetQuaPage('/KetQuaHocTap/Index');" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-outline hover:text-on-surface cursor-pointer">
                        <span class="material-symbols-outlined text-[16px]">cancel</span>
                    </a>
                }
            </div> *@

            <!-- Filter Dropdown: Lớp học -->
            <div class="relative">
                <select name="maLop" onchange="filterKetQuaAjax()" class="appearance-none bg-surface-white border border-border-standard text-brand-deep font-body-sm text-body-sm px-3.5 py-2 pr-8 rounded-xl focus:outline-none focus:border-primary cursor-pointer hover:bg-surface-container-low transition-colors">
                    <option value="">Tất cả Lớp học</option>
                    @foreach (var lop in lopHocs)
                    {
                        <!option value="@lop.MaLop" @(selectedMaLop == lop.MaLop ? "selected" : "")>@lop.TenLop</!option>
                    }
                </select>
                <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[16px]">expand_more</span>
            </div>

            <!-- Filter Dropdown: Kết quả -->
            <div class="relative">
                <select name="ketQua" onchange="filterKetQuaAjax()" class="appearance-none bg-surface-white border border-border-standard text-brand-deep font-body-sm text-body-sm px-3.5 py-2 pr-8 rounded-xl focus:outline-none focus:border-primary cursor-pointer hover:bg-surface-container-low transition-colors">
                    <option value="">Kết quả: Tất cả</option>
                    <!option value="Hoàn thành" @(selectedKetQua == "Hoàn thành" ? "selected" : "")>● Hoàn thành (Đạt)</!option>
                    <!option value="Không hoàn thành" @(selectedKetQua == "Không hoàn thành" ? "selected" : "")>○ Không hoàn thành</!option>
                </select>
                <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[16px]">expand_more</span>
            </div>
        </form>

        <div class="flex items-center gap-2 w-full lg:w-auto justify-end">
            <a href="/KetQuaHocTap/Index" onclick="event.preventDefault(); loadKetQuaPage(this.href);" class="p-2 border border-border-standard rounded-xl text-outline hover:text-brand-deep hover:bg-surface-container-low transition-colors cursor-pointer" title="Làm mới bảng">
                <span class="material-symbols-outlined text-[20px] block">refresh</span>
            </a>
            <button onclick="openDrawer('create')" class="bg-primary hover:bg-[#0047b3] text-surface-white font-label-md text-label-md px-4 py-2.5 rounded-xl shadow-sm flex items-center gap-2 transition-all cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">add</span>
                <span>Vào điểm mới</span>
            </button>
        </div>
    </div>

    <!-- Data Table Container -->
    <div class="bg-surface-white rounded-2xl border border-border-subtle shadow-[0_1px_3px_rgba(0,22,86,0.04),0_8px_24px_-4px_rgba(0,22,86,0.06)] overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse" id="crud-table">
                <thead>
                    <tr class="bg-surface-container-low/70 border-b border-border-subtle font-label-sm text-label-sm text-outline tracking-wider uppercase">
                        <th class="p-4 pl-6 w-12 text-center">
                            <input class="rounded border-border-standard text-primary focus:ring-primary h-4 w-4 cursor-pointer" type="checkbox" id="select-all"/>
                        </th>
                        <th class="py-4 px-4">Học viên</th>
                        <th class="py-4 px-4 min-w-[200px]">Lớp học</th>
                        <th class="py-4 px-3 text-center">Chuyên cần (30%)</th>
                        <th class="py-4 px-3 text-center">Cuối khóa (70%)</th>
                        <th class="py-4 px-3 text-center">Tổng kết</th>
                        <th class="py-4 px-3 text-center">Xếp loại</th>
                        <th class="py-4 px-4">Kết quả</th>
                        <th class="py-4 px-6 text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border-subtle font-body-sm text-body-sm">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="py-12 text-center text-outline">
                                <span class="material-symbols-outlined text-4xl block mb-2 text-outline/50">grading</span>
                                Chưa có dữ liệu điểm học viên phù hợp với bộ lọc hiện tại.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            var hv = item.DangKyHoc?.HocVien;
                            var lop = item.DangKyHoc?.LopHoc;
                            double score = item.DiemTongKet;
                            string grade = score >= 8.5 ? "A" : score >= 7.0 ? "B" : score >= 5.5 ? "C" : score >= 4.0 ? "D" : "F";
                            string gradeColor = grade == "A" ? "text-emerald-700 bg-emerald-50 border-emerald-200" :
                                               grade == "B" ? "text-blue-700 bg-blue-50 border-blue-200" :
                                               grade == "C" ? "text-amber-700 bg-amber-50 border-amber-200" :
                                               grade == "D" ? "text-orange-700 bg-orange-50 border-orange-200" :
                                               "text-red-700 bg-red-50 border-red-200";

                            <tr class="hover:bg-surface-container-low/50 transition-colors group"
                                data-id="@item.MaKetQua"
                                data-madangky="@item.MaDangKy"
                                data-hoten="@(hv?.HoTen ?? "")"
                                data-mahv="@(hv?.MaHocVien.ToString() ?? "")"
                                data-tenlop="@(lop?.TenLop ?? "")"
                                data-cc="@item.DiemChuyenCan"
                                data-ck="@item.DiemCuoiKhoa"
                                data-tk="@item.DiemTongKet"
                                data-nhanxet="@item.NhanXet"
                                data-ketqua="@item.KetQua">
                                <td class="p-4 pl-6 text-center">
                                    <input class="rounded border-border-standard text-primary focus:ring-primary h-4 w-4 row-checkbox cursor-pointer" type="checkbox"/>
                                </td>
                                <td class="py-4 px-4">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-8 h-8 rounded-full bg-primary/10 text-primary font-bold text-xs flex items-center justify-center flex-shrink-0">
                                            @(hv != null && !string.IsNullOrEmpty(hv.HoTen) ? hv.HoTen.Substring(0, 1).ToUpper() : "HV")
                                        </div>
                                        <div>
                                            <div class="font-label-md text-label-md text-brand-deep font-semibold">
                                                @(hv?.HoTen ?? $"Mã ĐK #{item.MaDangKy}")
                                            </div>
                                            <div class="text-outline text-[12px] font-mono">
                                                MSHV: @(hv?.MaHocVien ?? 0)
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-4 px-4">
                                    <div class="font-label-md text-label-md text-brand-deep font-semibold">
                                        @(lop?.TenLop ?? "Không xác định")
                                    </div>
                                    <div class="text-outline text-[12px] truncate max-w-xs">
                                        @(item.NhanXet ?? "Ghi nhận chuẩn")
                                    </div>
                                </td>
                                <td class="py-4 px-3 text-center font-mono font-semibold text-brand-deep">
                                    @item.DiemChuyenCan.ToString("F1")
                                </td>
                                <td class="py-4 px-3 text-center font-mono font-semibold text-brand-deep">
                                    @item.DiemCuoiKhoa.ToString("F1")
                                </td>
                                <td class="py-4 px-3 text-center">
                                    <span class="inline-block bg-primary/10 text-primary font-bold font-mono px-2.5 py-1 rounded-lg text-sm tabular-nums">
                                        @item.DiemTongKet.ToString("F2")
                                    </span>
                                </td>
                                <td class="py-4 px-3 text-center">
                                    <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg font-bold font-mono text-xs border @gradeColor">
                                        @grade
                                    </span>
                                </td>
                                <td class="py-4 px-4">
                                    @if (item.KetQua == "Hoàn thành")
                                    {
                                        <span class="inline-flex items-center gap-1.5 font-label-sm text-label-sm text-success-emerald bg-[#10B981]/10 px-2.5 py-1 rounded-full font-semibold">
                                            <span class="w-1.5 h-1.5 rounded-full bg-success-emerald"></span>
                                            Hoàn thành
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 font-label-sm text-label-sm text-danger-crimson bg-red-100 px-2.5 py-1 rounded-full font-semibold">
                                            <span class="w-1.5 h-1.5 rounded-full bg-danger-crimson"></span>
                                            Không hoàn thành
                                        </span>
                                    }
                                </td>
                                <td class="py-4 px-6 text-right">
                                    <div class="inline-flex items-center gap-1">
                                        <button onclick="viewScoreDetails(@item.MaKetQua)" class="p-1.5 rounded-lg text-outline hover:text-primary hover:bg-surface-container-low transition-colors cursor-pointer" title="Xem chi tiết">
                                            <span class="material-symbols-outlined text-[18px]">visibility</span>
                                        </button>
                                        <button onclick="openEditDrawerFromRow(this)" class="p-1.5 rounded-lg text-outline hover:text-secondary-container hover:bg-surface-container-low transition-colors cursor-pointer" title="Chỉnh sửa điểm">
                                            <span class="material-symbols-outlined text-[18px]">edit</span>
                                        </button>
                                        <button onclick="confirmDelete(@item.MaKetQua, '@(hv?.HoTen ?? "") - @(lop?.TenLop ?? "")')" class="p-1.5 rounded-lg text-outline hover:text-danger-crimson hover:bg-red-50 transition-colors cursor-pointer" title="Xóa kết quả">
                                            <span class="material-symbols-outlined text-[18px]">delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Toolbar -->
        <div class="p-4 px-6 border-t border-border-subtle bg-surface-white flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="font-body-sm text-body-sm text-outline">
                Hiển thị <span class="font-semibold text-brand-deep tabular-nums">@startRecord-@endRecord</span> trên <span class="font-semibold text-brand-deep tabular-nums">@totalRecords</span> kết quả
            </div>
            <div class="flex items-center gap-1.5">
                <a href="/KetQuaHocTap/Index?page=@(currentPage - 1)&maLop=@selectedMaLop&ketQua=@selectedKetQua&search=@search" 
                   onclick="event.preventDefault(); loadKetQuaPage(this.href)"
                   class="p-1.5 rounded-lg border border-border-standard text-outline hover:bg-surface-container-low transition-colors cursor-pointer @(currentPage <= 1 ? "opacity-40 pointer-events-none" : "")">
                    <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                </a>
                @for (int p = 1; p <= totalPages; p++)
                {
                    if (p == currentPage)
                    {
                        <span class="w-8 h-8 rounded-lg bg-primary text-surface-white font-label-md text-label-md font-bold flex items-center justify-center">@p</span>
                    }
                    else if (p <= 3 || p == totalPages || Math.Abs(p - currentPage) <= 1)
                    {
                        <a href="/KetQuaHocTap/Index?page=@p&maLop=@selectedMaLop&ketQua=@selectedKetQua&search=@search" 
                           onclick="event.preventDefault(); loadKetQuaPage(this.href)"
                           class="w-8 h-8 rounded-lg border border-border-standard text-brand-deep hover:bg-surface-container-low font-label-md text-label-md flex items-center justify-center transition-colors cursor-pointer">@p</a>
                    }
                    else if (p == 4 && totalPages > 5)
                    {
                        <span class="px-1 text-outline font-body-sm">...</span>
                    }
                }
                <a href="/KetQuaHocTap/Index?page=@(currentPage + 1)&maLop=@selectedMaLop&ketQua=@selectedKetQua&search=@search" 
                   onclick="event.preventDefault(); loadKetQuaPage(this.href)"
                   class="p-1.5 rounded-lg border border-border-standard text-outline hover:bg-surface-container-low transition-colors cursor-pointer @(currentPage >= totalPages ? "opacity-40 pointer-events-none" : "")">
                    <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- RIGHT SLIDE-OVER DRAWER (CREATE / UPDATE SCORE FORM) -->
<div class="fixed inset-0 z-50 overflow-hidden hidden transition-all duration-300" id="drawer-container">
    <!-- Overlay Backdrop -->
    <div class="absolute inset-0 bg-brand-deep/40 backdrop-blur-xs transition-opacity duration-300" id="drawer-backdrop" onclick="closeDrawer()"></div>
    <div class="absolute inset-y-0 right-0 max-w-full flex pl-10">
        <div class="w-screen max-w-md bg-surface-white shadow-2xl border-l border-border-standard flex flex-col justify-between">
            <!-- Drawer Header -->
            <div class="p-6 border-b border-border-subtle flex items-start justify-between bg-surface-white">
                <div>
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary text-[22px]">workspace_premium</span>
                        <h2 class="font-headline-sm text-headline-sm text-brand-deep" id="drawer-title">Nhập điểm học viên</h2>
                    </div>
                    <p class="font-body-sm text-body-sm text-outline mt-1" id="drawer-subtitle">
                        Tính điểm tổng kết và ghi nhận hoàn thành khóa đào tạo.
                    </p>
                </div>
                <button onclick="closeDrawer()" class="p-1.5 rounded-xl text-outline hover:text-brand-deep hover:bg-surface-container-low transition-colors cursor-pointer">
                    <span class="material-symbols-outlined text-[20px]">close</span>
                </button>
            </div>

            <!-- Drawer Form Body -->
            <form id="drawer-form" method="post" action="/KetQuaHocTap/Create" class="flex-1 overflow-y-auto p-6 space-y-5">
                @Html.AntiForgeryToken()
                <input type="hidden" name="maKetQua" id="drawer-maketqua" value="0"/>

                <!-- Student Select (Create Mode) / Readonly Info (Edit Mode) -->
                <div class="space-y-1.5" id="drawer-dangky-container">
                    <label class="block font-label-sm text-label-sm text-brand-deep uppercase tracking-wider">
                        Học viên / Lớp đào tạo <span class="text-danger-crimson">*</span>
                    </label>
                    <div class="relative" id="drawer-select-wrapper">
                        <select name="MaDangKy" id="drawer-madangky" required class="w-full appearance-none bg-surface-white border border-border-standard rounded-xl px-3.5 py-2.5 font-body-md text-body-md text-brand-deep focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary">
                            @if (!eligibleDangKys.Any())
                            {
                                <option value="">Không có hồ sơ học viên đang học</option>
                            }
                            else
                            {
                                @foreach (var dk in eligibleDangKys)
                                {
                                    <option value="@dk.MaDangKy">
                                        @(dk.HocVien?.HoTen ?? $"HV #{dk.MaHocVien}") - @(dk.LopHoc?.TenLop ?? "")
                                    </option>
                                }
                            }
                        </select>
                        <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[20px]">expand_more</span>
                    </div>
                    <div id="drawer-readonly-student" class="hidden p-3 rounded-xl bg-surface-container-low border border-border-subtle">
                        <div class="font-semibold text-brand-deep" id="readonly-student-name">Nguyễn Văn A</div>
                        <div class="text-xs text-outline" id="readonly-student-class">Lớp CNTT01</div>
                    </div>
                </div>

                <!-- Score 1: Điểm Chuyên cần (30%) Stepper -->
                <div class="space-y-1.5">
                    <label class="block font-label-sm text-label-sm text-brand-deep uppercase tracking-wider">
                        Điểm chuyên cần (30%) <span class="text-danger-crimson">*</span>
                    </label>
                    <div class="flex items-center justify-between border border-border-standard rounded-xl p-2 bg-surface-container-low/40">
                        <span class="font-body-sm text-body-sm text-on-surface-variant pl-2">Thang điểm 0 - 10</span>
                        <div class="flex items-center gap-2">
                            <button type="button" onclick="adjustScore('drawer-cc', -0.5)" class="w-8 h-8 rounded-lg bg-surface-white border border-border-standard flex items-center justify-center text-outline hover:text-brand-deep shadow-xs cursor-pointer">
                                <span class="material-symbols-outlined text-[18px]">remove</span>
                            </button>
                            <input type="number" step="0.1" min="0" max="10" name="diemChuyenCan" id="drawer-cc" value="8.5" oninput="calculateTotalScore()" class="w-16 text-center font-mono font-bold text-brand-deep text-lg bg-transparent border-0 focus:outline-none"/>
                            <button type="button" onclick="adjustScore('drawer-cc', 0.5)" class="w-8 h-8 rounded-lg bg-surface-white border border-border-standard flex items-center justify-center text-outline hover:text-brand-deep shadow-xs cursor-pointer">
                                <span class="material-symbols-outlined text-[18px]">add</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Score 2: Điểm Cuối khóa (70%) Stepper -->
                <div class="space-y-1.5">
                    <label class="block font-label-sm text-label-sm text-brand-deep uppercase tracking-wider">
                        Điểm cuối khóa (70%) <span class="text-danger-crimson">*</span>
                    </label>
                    <div class="flex items-center justify-between border border-border-standard rounded-xl p-2 bg-surface-container-low/40">
                        <span class="font-body-sm text-body-sm text-on-surface-variant pl-2">Thang điểm 0 - 10</span>
                        <div class="flex items-center gap-2">
                            <button type="button" onclick="adjustScore('drawer-ck', -0.5)" class="w-8 h-8 rounded-lg bg-surface-white border border-border-standard flex items-center justify-center text-outline hover:text-brand-deep shadow-xs cursor-pointer">
                                <span class="material-symbols-outlined text-[18px]">remove</span>
                            </button>
                            <input type="number" step="0.1" min="0" max="10" name="diemCuoiKhoa" id="drawer-ck" value="8.0" oninput="calculateTotalScore()" class="w-16 text-center font-mono font-bold text-brand-deep text-lg bg-transparent border-0 focus:outline-none"/>
                            <button type="button" onclick="adjustScore('drawer-ck', 0.5)" class="w-8 h-8 rounded-lg bg-surface-white border border-border-standard flex items-center justify-center text-outline hover:text-brand-deep shadow-xs cursor-pointer">
                                <span class="material-symbols-outlined text-[18px]">add</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Auto-Calculated Total & Grade Box -->
                <div class="p-4 rounded-xl bg-gradient-to-tr from-primary/5 to-primary-container/10 border border-primary/20 flex items-center justify-between">
                    <div>
                        <span class="text-xs uppercase font-bold text-primary block tracking-wider">Điểm tổng kết tự động</span>
                        <span class="text-xs text-outline">Công thức: 30% CC + 70% CK</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="font-mono text-2xl font-black text-brand-deep tabular-nums" id="computed-score">8.15</span>
                        <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg font-bold font-mono text-xs bg-primary text-surface-white shadow-xs" id="computed-grade">B</span>
                    </div>
                </div>

                <!-- Radio: Kết quả cuối cùng -->
                <div class="space-y-1.5">
                    <label class="block font-label-sm text-label-sm text-brand-deep uppercase tracking-wider">Kết quả công nhận</label>
                    <div class="grid grid-cols-2 gap-2">
                        <label class="cursor-pointer border-2 border-success-emerald bg-emerald-50/50 rounded-xl p-3 flex items-center justify-center gap-2 transition-all select-none" id="label-ketqua-pass" onclick="setKetQua('Hoàn thành', event)">
                            <input type="radio" name="ketQua" value="Hoàn thành" class="hidden" id="radio-ketqua-pass" checked/>
                            <span class="material-symbols-outlined text-success-emerald text-[18px]" id="icon-ketqua-pass">check_circle</span>
                            <span class="font-label-md text-label-md text-success-emerald font-bold" id="text-ketqua-pass">Hoàn thành</span>
                        </label>
                        <label class="cursor-pointer border border-border-standard bg-surface-white rounded-xl p-3 flex items-center justify-center gap-2 hover:bg-surface-container-low transition-colors select-none" id="label-ketqua-fail" onclick="setKetQua('Không hoàn thành', event)">
                            <input type="radio" name="ketQua" value="Không hoàn thành" class="hidden" id="radio-ketqua-fail"/>
                            <span class="material-symbols-outlined text-outline text-[18px]" id="icon-ketqua-fail">cancel</span>
                            <span class="font-label-md text-label-md text-on-surface-variant font-bold" id="text-ketqua-fail">Chưa đạt</span>
                        </label>
                    </div>
                </div>

                <!-- Textarea: Nhận xét của giáo vụ -->
                <div class="space-y-1.5">
                    <label class="block font-label-sm text-label-sm text-brand-deep uppercase tracking-wider">Nhận xét của Giáo vụ</label>
                    <textarea name="nhanXet" id="drawer-nhanxet" class="w-full bg-surface-white border border-border-standard rounded-xl p-3 font-body-sm text-body-sm text-brand-deep focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary resize-none" placeholder="Đánh giá thái độ học tập, bài thi cuối khóa..." rows="3">Học viên tham gia đầy đủ, hoàn thành tốt bài kiểm tra.</textarea>
                </div>

                <!-- AI Assistant Tip Widget -->
                <div class="bg-primary/5 border border-primary/20 rounded-2xl p-3.5 flex items-start gap-3">
                    <div class="w-8 h-8 rounded-xl bg-primary text-surface-white flex items-center justify-center flex-shrink-0 shadow-sm">
                        <span class="material-symbols-outlined text-[18px]">auto_awesome</span>
                    </div>
                    <div>
                        <span class="font-label-sm text-label-sm text-primary uppercase tracking-wider block font-bold">Gợi ý từ AI Assistant</span>
                        <p class="font-body-sm text-[12px] text-on-surface-variant mt-0.5 leading-relaxed">
                            Điểm tổng kết ≥ 5.0 được xếp loại Đạt chuẩn đầu ra hoàn thành khóa học theo quy chế trung tâm UNETI.
                        </p>
                    </div>
                </div>

                <!-- Drawer Footer inside form -->
                <div class="border-t border-border-subtle pt-4 flex items-center justify-end gap-3">
                    <button type="button" onclick="closeDrawer()" class="border border-border-standard bg-surface-white hover:bg-surface-container-low text-brand-deep font-label-md text-label-md px-4 py-2.5 rounded-xl transition-colors cursor-pointer">
                        Hủy bỏ
                    </button>
                    <button type="submit" class="bg-primary hover:bg-[#0047b3] text-surface-white font-label-md text-label-md px-5 py-2.5 rounded-xl shadow-sm flex items-center gap-2 transition-all cursor-pointer">
                        <span class="material-symbols-outlined text-[18px]">save</span>
                        <span id="drawer-submit-text">Lưu kết quả</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Micro-interactions for Drawer and Global Modal
    const drawer = document.getElementById('drawer-container');
    const drawerForm = document.getElementById('drawer-form');

    function openDrawer(mode) {
        drawer.classList.remove('hidden');
        if (mode === 'create') {
            document.getElementById('drawer-title').innerText = 'Nhập điểm học viên';
            document.getElementById('drawer-subtitle').innerText = 'Tính điểm tổng kết và ghi nhận hoàn thành khóa đào tạo.';
            document.getElementById('drawer-submit-text').innerText = 'Lưu kết quả';
            drawerForm.action = '/KetQuaHocTap/Create';
            document.getElementById('drawer-maketqua').value = '0';

            document.getElementById('drawer-select-wrapper').classList.remove('hidden');
            document.getElementById('drawer-readonly-student').classList.add('hidden');
            document.getElementById('drawer-cc').value = '8.5';
            document.getElementById('drawer-ck').value = '8.0';
            calculateTotalScore();
        }
    }

    function closeDrawer() {
        drawer.classList.add('hidden');
    }

    function adjustScore(inputId, delta) {
        const input = document.getElementById(inputId);
        let val = parseFloat(input.value) || 0;
        val = Math.max(0, Math.min(10, Math.round((val + delta) * 10) / 10));
        input.value = val.toFixed(1);
        calculateTotalScore();
    }

    function setKetQua(val, e) {
        if (e) {
            e.preventDefault();
        }
        const isPass = (val === 'Hoàn thành' || val === 'pass');
        const radioPass = document.getElementById('radio-ketqua-pass');
        const radioFail = document.getElementById('radio-ketqua-fail');
        const labelPass = document.getElementById('label-ketqua-pass');
        const labelFail = document.getElementById('label-ketqua-fail');
        const iconPass = document.getElementById('icon-ketqua-pass');
        const iconFail = document.getElementById('icon-ketqua-fail');
        const textPass = document.getElementById('text-ketqua-pass');
        const textFail = document.getElementById('text-ketqua-fail');

        if (radioPass && radioFail) {
            radioPass.checked = isPass;
            radioFail.checked = !isPass;
        }

        if (labelPass && labelFail) {
            if (isPass) {
                labelPass.className = 'cursor-pointer border-2 border-success-emerald bg-emerald-50/50 rounded-xl p-3 flex items-center justify-center gap-2 transition-all select-none';
                if (iconPass) iconPass.className = 'material-symbols-outlined text-success-emerald text-[18px]';
                if (textPass) textPass.className = 'font-label-md text-label-md text-success-emerald font-bold';

                labelFail.className = 'cursor-pointer border border-border-standard bg-surface-white rounded-xl p-3 flex items-center justify-center gap-2 hover:bg-surface-container-low transition-colors select-none';
                if (iconFail) iconFail.className = 'material-symbols-outlined text-outline text-[18px]';
                if (textFail) textFail.className = 'font-label-md text-label-md text-on-surface-variant font-bold';
            } else {
                labelPass.className = 'cursor-pointer border border-border-standard bg-surface-white rounded-xl p-3 flex items-center justify-center gap-2 hover:bg-surface-container-low transition-colors select-none';
                if (iconPass) iconPass.className = 'material-symbols-outlined text-outline text-[18px]';
                if (textPass) textPass.className = 'font-label-md text-label-md text-on-surface-variant font-bold';

                labelFail.className = 'cursor-pointer border-2 border-danger-crimson bg-red-50/50 rounded-xl p-3 flex items-center justify-center gap-2 transition-all select-none';
                if (iconFail) iconFail.className = 'material-symbols-outlined text-danger-crimson text-[18px]';
                if (textFail) textFail.className = 'font-label-md text-label-md text-danger-crimson font-bold';
            }
        }
    }

    function calculateTotalScore(autoSelect = true) {
        const cc = parseFloat(document.getElementById('drawer-cc').value) || 0;
        const ck = parseFloat(document.getElementById('drawer-ck').value) || 0;
        const total = Math.round((cc * 0.3 + ck * 0.7) * 100) / 100;
        document.getElementById('computed-score').innerText = total.toFixed(2);

        let grade = 'F';
        if (total >= 8.5) grade = 'A';
        else if (total >= 7.0) grade = 'B';
        else if (total >= 5.5) grade = 'C';
        else if (total >= 4.0) grade = 'D';
        document.getElementById('computed-grade').innerText = grade;

        if (autoSelect) {
            setKetQua(total >= 5.0 ? 'Hoàn thành' : 'Không hoàn thành');
        }
    }

    function openEditDrawerFromRow(btn) {
        const row = btn.closest('tr');
        document.getElementById('drawer-title').innerText = 'Cập nhật kết quả';
        document.getElementById('drawer-subtitle').innerText = 'Điều chỉnh điểm số và nhận xét đánh giá học viên.';
        document.getElementById('drawer-submit-text').innerText = 'Cập nhật';
        drawerForm.action = '/KetQuaHocTap/EditPost';

        document.getElementById('drawer-maketqua').value = row.dataset.id;
        document.getElementById('drawer-select-wrapper').classList.add('hidden');
        document.getElementById('drawer-readonly-student').classList.remove('hidden');
        document.getElementById('readonly-student-name').innerText = row.dataset.hoten || ('Học viên #' + row.dataset.mahv);
        document.getElementById('readonly-student-class').innerText = 'Lớp: ' + (row.dataset.tenlop || '');

        document.getElementById('drawer-cc').value = parseFloat(row.dataset.cc || 0).toFixed(1);
        document.getElementById('drawer-ck').value = parseFloat(row.dataset.ck || 0).toFixed(1);
        document.getElementById('drawer-nhanxet').value = row.dataset.nhanxet || '';

        // Calculate score without overriding saved status
        calculateTotalScore(false);

        // Load saved status from row
        const savedKetQua = row.dataset.ketqua || (parseFloat(row.dataset.tk || 0) >= 5.0 ? 'Hoàn thành' : 'Không hoàn thành');
        setKetQua(savedKetQua);

        drawer.classList.remove('hidden');
    }

    function viewScoreDetails(id) {
        const row = document.querySelector(`tr[data-id="${id}"]`);
        if (row) openEditDrawerFromRow(row.querySelector('button[title="Chỉnh sửa điểm"]'));
    }

    function confirmDelete(id, studentInfo) {
        openGlobalDeleteModal({
            action: '/KetQuaHocTap/DeletePost',
            id: id,
            title: 'Xóa kết quả học tập này?',
            itemName: studentInfo,
            message: `Bạn có chắc chắn muốn xóa bản ghi kết quả của <strong class="text-brand-deep">${studentInfo}</strong>? Tất cả dữ liệu điểm thành phần và nhận xét đánh giá liên quan sẽ bị loại bỏ.`,
            warning: 'Hành động này mang tính vĩnh viễn và không thể hoàn tác sau khi xác nhận.',
            submitText: 'Xóa vĩnh viễn'
        });
    }

    // Filter KetQua via AJAX without reloading page
    function filterKetQuaAjax() {
        const form = document.getElementById('filter-form');
        if (!form) return;
        const formData = new FormData(form);
        const params = new URLSearchParams(formData);
        params.set('page', '1');
        const url = `/KetQuaHocTap/Index?${params.toString()}`;
        loadKetQuaPage(url);
    }

    // Universal AJAX Page Loader for KetQuaHocTap (Pagination, Filter, Refresh)
    async function loadKetQuaPage(url, pushState = true) {
        const area = document.getElementById('ketqua-content-area');
        if (area) {
            area.classList.add('opacity-50', 'pointer-events-none');
        }

        try {
            const res = await fetch(url, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            const html = await res.text();
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');

            const newContent = doc.getElementById('ketqua-content-area');
            if (newContent && area) {
                area.innerHTML = newContent.innerHTML;
                bindSelectAll();
            }

            if (pushState) {
                window.history.pushState({ url: url }, '', url);
            }
        } catch (err) {
            console.error('Lỗi khi tải trang AJAX:', err);
            window.location.href = url;
        } finally {
            if (area) {
                area.classList.remove('opacity-50', 'pointer-events-none');
            }
        }
    }

    window.addEventListener('popstate', (e) => {
        if (e.state && e.state.url) {
            loadKetQuaPage(e.state.url, false);
        } else {
            loadKetQuaPage(window.location.href, false);
        }
    });

    // Handle AJAX Delete Callback
    window.onDeleteSuccess = function(data) {
        loadKetQuaPage(window.location.href, false);
    };

    // AJAX Form Submission for Right Drawer (Create & Edit)
    if (drawerForm) {
        drawerForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            const submitBtn = drawerForm.querySelector('button[type="submit"]');
            const submitText = document.getElementById('drawer-submit-text');
            const originalText = submitText ? submitText.innerText : 'Lưu kết quả';
            if (submitBtn) submitBtn.disabled = true;
            if (submitText) submitText.innerText = 'Đang xử lý...';

            try {
                const formData = new FormData(drawerForm);
                const res = await fetch(drawerForm.action, {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                const contentType = res.headers.get("content-type");
                if (contentType && contentType.indexOf("application/json") !== -1) {
                    const data = await res.json();
                    if (data.success) {
                        closeDrawer();
                        if (window.showToast) window.showToast(data.message, 'success');
                        await loadKetQuaPage(window.location.href, false);
                    } else {
                        if (window.showToast) window.showToast(data.message, 'error');
                    }
                } else {
                    closeDrawer();
                    await loadKetQuaPage(window.location.href, false);
                }
            } catch (err) {
                console.error('Lỗi khi gửi form kết quả:', err);
                if (window.showToast) window.showToast('Có lỗi xảy ra khi lưu kết quả.', 'error');
            } finally {
                if (submitBtn) submitBtn.disabled = false;
                if (submitText) submitText.innerText = originalText;
            }
        });
    }

    // Select-all Checkbox helper
    function bindSelectAll() {
        const selectAll = document.getElementById('select-all');
        if (selectAll) {
            selectAll.onchange = function(e) {
                document.querySelectorAll('.row-checkbox').forEach(cb => cb.checked = e.target.checked);
            };
        }
    }
    bindSelectAll();

    // Client-side CSV Exporter
    function exportTableToCSV(filename) {
        let csv = [];
        const rows = document.querySelectorAll("#crud-table tr");
        for (let i = 0; i < rows.length; i++) {
            let row = [], cols = rows[i].querySelectorAll("td, th");
            for (let j = 1; j < cols.length - 1; j++) {
                let data = cols[j].innerText.replace(/(\r\n|\n|\r)/gm, " ").trim();
                data = data.replace(/"/g, '""');
                row.push('"' + data + '"');
            }
            csv.push(row.join(","));
        }
        const csvFile = new Blob(["\uFEFF" + csv.join("\n")], { type: "text/csv;charset=utf-8;" });
        const downloadLink = document.createElement("a");
        downloadLink.download = filename;
        downloadLink.href = window.URL.createObjectURL(csvFile);
        downloadLink.style.display = "none";
        document.body.appendChild(downloadLink);
        downloadLink.click();
        document.body.removeChild(downloadLink);
    }
</script>
