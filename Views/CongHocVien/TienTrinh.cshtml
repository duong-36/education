@model IEnumerable<QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.Models.DangKyHoc>
@{
    // Họ và tên: Nguyễn Đức Linh
    // Mã sinh viên: 23103100042
    // Nội dung thực hiện: Không Gian Học Tập Của Tôi (My Learning Space) - Cổng Học viên
    ViewData["Title"] = "Không Gian Học Tập Của Tôi";
    var currentStudent = ViewBag.CurrentStudent as QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.Models.HocVien;
    var buoiHocs = ViewBag.BuoiHocs as List<QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.Models.BuoiHoc> ?? new List<QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.Models.BuoiHoc>();
    var ketQuas = ViewBag.KetQuas as List<QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.Models.KetQuaHocTap> ?? new List<QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.Models.KetQuaHocTap>();
    var completedSessionsMap = ViewBag.CompletedSessionsCount as Dictionary<int, int> ?? new Dictionary<int, int>();

    int totalCourses = Model.Count();
    int activeCourses = Model.Count(d => d.TrangThai == "Đang học" || d.TrangThai == "Đã đóng học phí");
    int pendingCourses = Model.Count(d => d.TrangThai == "Chờ duyệt" || d.TrangThai == "Đã duyệt");
    int completedCourses = ketQuas.Count(k => k.KetQua == "Hoàn thành" || k.KetQua == "Đạt");
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <!-- ================= STUDENT PROFILE HERO BAR ================= -->
    <div class="bg-gradient-to-r from-brand-deep via-[#002f87] to-primary text-white rounded-3xl p-6 sm:p-8 shadow-xl relative overflow-hidden">
        <div class="absolute -right-16 -top-16 w-64 h-64 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-6">
            <div class="flex flex-col sm:flex-row items-center gap-5 text-center sm:text-left">
                <div class="w-20 h-20 rounded-3xl bg-white text-brand-deep font-black text-3xl flex items-center justify-center shadow-lg shrink-0">
                    @(string.IsNullOrWhiteSpace(currentStudent?.HoTen) ? "HV" : currentStudent.HoTen.Substring(0, 1).ToUpper())
                </div>
                <div class="space-y-1.5">
                    <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
                        <h1 class="text-xl sm:text-2xl font-black text-white tracking-tight">
                            @(currentStudent?.HoTen ?? "Học viên UNETI")
                        </h1>
                        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-400 text-slate-900">
                            Học viên chính thức
                        </span>
                    </div>
                    <p class="text-xs text-slate-200 font-mono">
                        Mã HV: <strong>#HV@(currentStudent?.MaHocVien.ToString("D3") ?? "001")</strong> • @(currentStudent?.Email ?? "hocvien@uneti.edu.vn")
                    </p>
                </div>
            </div>

            <!-- Learning Stats -->
            <div class="flex items-center gap-4 sm:gap-6 bg-white/10 backdrop-blur-md px-5 py-3 rounded-2xl border border-white/20 text-center">
                <div>
                    <span class="text-xl sm:text-2xl font-black text-white font-mono block">@totalCourses</span>
                    <span class="text-[10px] text-slate-300 uppercase tracking-wider font-semibold">Khóa đã ĐK</span>
                </div>
                <div class="h-8 w-px bg-white/20"></div>
                <div>
                    <span class="text-xl sm:text-2xl font-black text-amber-300 font-mono block">@activeCourses</span>
                    <span class="text-[10px] text-slate-300 uppercase tracking-wider font-semibold">Đang theo học</span>
                </div>
                <div class="h-8 w-px bg-white/20"></div>
                <div>
                    <span class="text-xl sm:text-2xl font-black text-emerald-300 font-mono block">@completedCourses</span>
                    <span class="text-[10px] text-slate-300 uppercase tracking-wider font-semibold">Đã hoàn thành</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= TABS NAVIGATION ================= -->
    <div class="border-b border-border-standard flex items-center justify-between gap-4">
        <div class="flex items-center gap-2 sm:gap-4 overflow-x-auto custom-scrollbar">
            <button type="button" onclick="switchTab('courses')" id="tab-btn-courses"
                    class="py-3 px-4 text-xs sm:text-sm font-bold border-b-2 border-primary text-primary flex items-center gap-2 transition-colors cursor-pointer">
                <span class="material-symbols-outlined text-[20px]">school</span>
                <span>Khóa học của tôi (@totalCourses)</span>
            </button>
            <button type="button" onclick="switchTab('schedule')" id="tab-btn-schedule"
                    class="py-3 px-4 text-xs sm:text-sm font-bold border-b-2 border-transparent text-outline hover:text-brand-deep flex items-center gap-2 transition-colors cursor-pointer">
                <span class="material-symbols-outlined text-[20px]">calendar_month</span>
                <span>Thời khóa biểu cá nhân (@buoiHocs.Count)</span>
            </button>
            <button type="button" onclick="switchTab('grades')" id="tab-btn-grades"
                    class="py-3 px-4 text-xs sm:text-sm font-bold border-b-2 border-transparent text-outline hover:text-brand-deep flex items-center gap-2 transition-colors cursor-pointer">
                <span class="material-symbols-outlined text-[20px]">workspace_premium</span>
                <span>Bảng điểm & Chứng chỉ (@ketQuas.Count)</span>
            </button>
        </div>

        <a href="/CongHocVien/DangKy" class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-primary text-white text-xs font-bold hover:bg-primary-hover shadow-xs transition-colors shrink-0">
            <span class="material-symbols-outlined text-[16px]">add_shopping_cart</span>
            <span>Khám phá thêm khóa học</span>
        </a>
    </div>

    <!-- ================= TAB 1: KHÓA HỌC CỦA TÔI ================= -->
    <div id="tab-content-courses" class="space-y-6">
        @if (!Model.Any())
        {
            <div class="bg-white rounded-3xl border border-border-standard p-12 text-center text-outline shadow-xs space-y-4">
                <span class="material-symbols-outlined text-[54px] opacity-40 text-primary">menu_book</span>
                <h3 class="text-base font-bold text-brand-deep">Bạn chưa đăng ký khóa học nào</h3>
                <p class="text-xs max-w-md mx-auto">Hãy ghé thăm trang Khám phá khóa học để lựa chọn lớp học phù hợp với định hướng của bạn nhé!</p>
                <a href="/CongHocVien/DangKy" class="inline-block px-6 py-2.5 rounded-xl bg-primary text-white text-xs font-bold shadow-md hover:bg-primary-hover transition-colors">
                    Khám phá khóa học ngay
                </a>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var dk in Model)
                {
                    var lop = dk.LopHoc;
                    int maLop = dk.MaLop;
                    int totalSessions = lop?.SoBuoiHoc ?? 1;
                    int completedSessions = completedSessionsMap.ContainsKey(maLop) ? completedSessionsMap[maLop] : 0;
                    double progressPercent = totalSessions > 0 ? Math.Min(100.0, Math.Round((double)completedSessions / totalSessions * 100, 1)) : 0;

                    <div class="bg-white rounded-3xl border border-border-standard hover:border-primary/40 shadow-xs hover:shadow-lg transition-all flex flex-col justify-between overflow-hidden">
                        <!-- Top Banner -->
                        <div class="p-5 bg-gradient-to-r from-slate-900 to-brand-deep text-white flex items-center justify-between">
                            <span class="text-[10px] font-bold uppercase tracking-wider bg-white/20 px-2 py-0.5 rounded">
                                @(lop?.TrinhDoDauVao ?? "Đào tạo")
                            </span>
                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-bold
                                @(dk.TrangThai == "Đang học" ? "bg-blue-500 text-white" :
                                  dk.TrangThai == "Đã đóng học phí" ? "bg-emerald-500 text-white" :
                                  dk.TrangThai == "Hoàn thành" ? "bg-purple-500 text-white" :
                                  dk.TrangThai == "Chờ duyệt" ? "bg-amber-400 text-slate-900 animate-pulse" :
                                  "bg-rose-500 text-white")">
                                @dk.TrangThai
                            </span>
                        </div>

                        <!-- Card Body -->
                        <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
                            <div class="space-y-2">
                                <h3 class="text-base font-bold text-brand-deep line-clamp-2">
                                    @(lop?.TenLop ?? $"Lớp #{maLop}")
                                </h3>
                                <p class="text-xs text-outline">
                                    @(lop?.ChuongTrinhDaoTao?.TenChuongTrinh ?? "Chương trình chuyên biệt")
                                </p>

                                <div class="space-y-1.5 pt-2 text-xs text-slate-600 border-t border-border-standard">
                                    <div class="flex items-center justify-between">
                                        <span class="text-outline">Giảng viên:</span>
                                        <strong class="text-brand-deep">@(lop?.GiangVien ?? "Chưa chỉ định")</strong>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-outline">Khai giảng:</span>
                                        <span class="font-mono text-brand-deep">@(lop?.NgayKhaiGiang.ToString("dd/MM/yyyy") ?? "—")</span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-outline">Học phí:</span>
                                        <span class="font-mono font-bold text-emerald-700">@(lop?.HocPhi.ToString("N0") ?? "0") đ</span>
                                    </div>
                                </div>

                                <!-- Progress bar for enrolled courses -->
                                @if (dk.TrangThai == "Đang học" || dk.TrangThai == "Đã đóng học phí")
                                {
                                    <div class="pt-3 space-y-1.5">
                                        <div class="flex justify-between items-center text-[11px]">
                                            <span class="text-outline">Tiến độ khóa học:</span>
                                            <strong class="text-primary font-mono">@completedSessions / @totalSessions buổi (@progressPercent%)</strong>
                                        </div>
                                        <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                                            <div class="h-2 rounded-full bg-primary transition-all duration-500" style="width: @progressPercent%"></div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Actions -->
                            <div class="pt-3 border-t border-border-standard space-y-2">
                                @if (dk.TrangThai == "Đang học" || dk.TrangThai == "Đã đóng học phí")
                                {
                                    <a asp-action="ChiTiet" asp-route-id="@maLop" class="w-full py-2.5 px-3 rounded-xl bg-primary hover:bg-primary-hover text-white text-xs font-bold text-center flex items-center justify-center gap-1.5 shadow-xs transition-colors">
                                        <span class="material-symbols-outlined text-[16px]">event_note</span>
                                        <span>Xem Lịch & Đề Cương</span>
                                    </a>
                                }
                                else if (dk.TrangThai == "Chờ duyệt" || (dk.TrangThai == "Đã duyệt" && dk.SoTienDaDong == 0))
                                {
                                    <div class="flex items-center gap-2">
                                        <a asp-action="ChiTiet" asp-route-id="@maLop" class="flex-1 py-2 px-2 rounded-xl border border-border-standard text-brand-deep text-xs font-bold text-center hover:bg-slate-50 transition-colors">
                                            Chi tiết
                                        </a>
                                        <button type="button" onclick="confirmHuyDangKy(@dk.MaDangKy, '@(lop?.TenLop?.Replace("'", "\\'") ?? "")')"
                                                class="py-2 px-3 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-xs font-bold transition-colors">
                                            Hủy đơn
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <a asp-action="ChiTiet" asp-route-id="@maLop" class="w-full py-2 px-3 rounded-xl border border-border-standard text-brand-deep text-xs font-bold text-center block hover:bg-slate-50 transition-colors">
                                        Xem chi tiết khóa học
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- ================= TAB 2: THỜI KHÓA BIỂU CÁ NHÂN ================= -->
    <div id="tab-content-schedule" class="space-y-6 hidden">
        <div class="bg-white rounded-3xl border border-border-standard p-6 sm:p-7 shadow-xs space-y-5">
            <div class="flex items-center justify-between pb-3 border-b border-border-standard">
                <div>
                    <h3 class="text-base font-bold text-brand-deep">Lịch Buổi Học Sắp Tới Của Bạn</h3>
                    <p class="text-xs text-outline">Được tổng hợp tự động từ tất cả các khóa học bạn đang tham gia</p>
                </div>
                <span class="text-xs font-mono font-bold text-primary px-3 py-1 bg-primary-light rounded-xl">
                    @buoiHocs.Count buổi học
                </span>
            </div>

            @if (!buoiHocs.Any())
            {
                <div class="text-center py-12 text-outline text-xs">
                    <span class="material-symbols-outlined text-[44px] opacity-40 mb-2 text-primary">event_busy</span>
                    <p class="font-medium text-sm text-brand-deep">Chưa có buổi học nào được lên lịch</p>
                    <p class="text-[11px] mt-1">Khi các lớp học của bạn được Ban Giáo vụ xếp phòng và giảng viên, lịch học sẽ hiển thị tại đây.</p>
                </div>
            }
            else
            {
                <div class="space-y-3">
                    @{ int bIndex = 1; }
                    @foreach (var b in buoiHocs)
                    {
                        bool isToday = b.ThoiGianBatDau.Date == DateTime.Today;
                        <div class="p-4 rounded-2xl border transition-all flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs
                            @(isToday ? "bg-amber-50/70 border-amber-300 ring-2 ring-amber-200" : "bg-slate-50 border-border-standard hover:border-primary/40")">
                            <div class="flex items-center gap-3.5">
                                <div class="w-10 h-10 rounded-2xl font-mono font-bold flex flex-col items-center justify-center text-xs shrink-0 shadow-xs
                                    @(isToday ? "bg-amber-500 text-white" : "bg-brand-deep text-white")">
                                    <span class="text-[9px] uppercase leading-none">Buổi</span>
                                    <span class="text-sm font-bold leading-none">@(bIndex++)</span>
                                </div>
                                <div class="space-y-1">
                                    <div class="flex items-center gap-2">
                                        <h4 class="font-bold text-brand-deep text-sm">@(b.LopHoc?.TenLop ?? "Khóa học")</h4>
                                        @if (isToday)
                                        {
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-400 text-slate-900 animate-pulse">
                                                HÔM NAY
                                            </span>
                                        }
                                    </div>
                                    <div class="text-outline text-[11px] flex flex-wrap items-center gap-3 font-mono">
                                        <span class="text-slate-800 font-semibold flex items-center gap-1">
                                            <span class="material-symbols-outlined text-[15px] text-primary">schedule</span>
                                            @b.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm") - @b.ThoiGianKetThuc.ToString("HH:mm")
                                        </span>
                                        <span>•</span>
                                        <span>Phòng học: <strong class="text-brand-deep font-sans">@b.PhongHoc</strong></span>
                                        <span>•</span>
                                        <span>GV: <strong class="text-brand-deep font-sans">@b.GiangVien</strong></span>
                                    </div>
                                </div>
                            </div>

                            <span class="px-3 py-1 rounded-full text-[11px] font-semibold shrink-0
                                @(b.TrangThai == "Đã hoàn thành" ? "bg-emerald-50 text-emerald-700 border border-emerald-200" :
                                  b.TrangThai == "Đang diễn ra" ? "bg-blue-50 text-blue-700 border border-blue-200" :
                                  "bg-slate-200 text-slate-700")">
                                @b.TrangThai
                            </span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- ================= TAB 3: BẢNG ĐIỂM & CHỨNG NHẬN ================= -->
    <div id="tab-content-grades" class="space-y-6 hidden">
        @if (!ketQuas.Any())
        {
            <div class="bg-white rounded-3xl border border-border-standard p-12 text-center text-outline shadow-xs space-y-3">
                <span class="material-symbols-outlined text-[48px] opacity-40 text-primary">workspace_premium</span>
                <h3 class="text-base font-bold text-brand-deep">Chưa có kết quả học tập nào được công bố</h3>
                <p class="text-xs max-w-md mx-auto">Sau khi kết thúc khóa học và hoàn thành kỳ thi đánh giá, kết quả cùng chứng chỉ tốt nghiệp của bạn sẽ xuất hiện tại đây.</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                @foreach (var kq in ketQuas)
                {
                    bool isPassed = kq.KetQua == "Hoàn thành" || kq.KetQua == "Đạt";
                    <div class="bg-white rounded-3xl border border-border-standard shadow-xs p-6 flex flex-col justify-between space-y-5 relative overflow-hidden">
                        <div class="space-y-3">
                            <div class="flex items-center justify-between">
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-primary-light text-primary">
                                    Chứng Chỉ Khóa Học
                                </span>
                                <span class="px-2.5 py-1 rounded-full text-[11px] font-bold @(isPassed ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-rose-50 text-rose-700 border border-rose-200")">
                                    @kq.KetQua
                                </span>
                            </div>

                            <h3 class="text-base font-bold text-brand-deep">
                                @(kq.DangKyHoc?.LopHoc?.TenLop ?? "Khóa học")
                            </h3>

                            <!-- Score details -->
                            <div class="grid grid-cols-3 gap-2 p-3.5 rounded-2xl bg-slate-50 border border-border-standard text-center text-xs">
                                <div>
                                    <span class="text-[10px] text-outline block">Chuyên cần</span>
                                    <strong class="font-mono text-sm text-brand-deep">@kq.DiemChuyenCan</strong>
                                </div>
                                <div>
                                    <span class="text-[10px] text-outline block">Cuối khóa</span>
                                    <strong class="font-mono text-sm text-brand-deep">@kq.DiemCuoiKhoa</strong>
                                </div>
                                <div>
                                    <span class="text-[10px] text-outline block font-bold">Tổng kết</span>
                                    <strong class="font-mono text-base font-black text-primary">@kq.DiemTongKet.ToString("0.0")</strong>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(kq.NhanXet))
                            {
                                <div class="text-xs text-slate-600 italic bg-amber-50/60 p-3 rounded-xl border border-amber-200">
                                    "Giảng viên nhận xét: @kq.NhanXet"
                                </div>
                            }
                        </div>

                        <!-- Certificate Badge Footer -->
                        <div class="pt-4 border-t border-border-standard flex items-center justify-between text-xs">
                            <span class="text-outline text-[11px] font-mono">Cập nhật: @kq.NgayCapNhat.ToString("dd/MM/yyyy")</span>
                            @if (isPassed)
                            {
                                <span class="text-emerald-700 font-bold flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[16px]">verified</span>
                                    <span>Đã cấp chứng chỉ UNETI</span>
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    function switchTab(tab) {
        document.getElementById('tab-content-courses').classList.add('hidden');
        document.getElementById('tab-content-schedule').classList.add('hidden');
        document.getElementById('tab-content-grades').classList.add('hidden');

        document.getElementById('tab-btn-courses').className = 'py-3 px-4 text-xs sm:text-sm font-bold border-b-2 border-transparent text-outline hover:text-brand-deep flex items-center gap-2 transition-colors cursor-pointer';
        document.getElementById('tab-btn-schedule').className = 'py-3 px-4 text-xs sm:text-sm font-bold border-b-2 border-transparent text-outline hover:text-brand-deep flex items-center gap-2 transition-colors cursor-pointer';
        document.getElementById('tab-btn-grades').className = 'py-3 px-4 text-xs sm:text-sm font-bold border-b-2 border-transparent text-outline hover:text-brand-deep flex items-center gap-2 transition-colors cursor-pointer';

        document.getElementById(`tab-content-${tab}`).classList.remove('hidden');
        document.getElementById(`tab-btn-${tab}`).className = 'py-3 px-4 text-xs sm:text-sm font-bold border-b-2 border-primary text-primary flex items-center gap-2 transition-colors cursor-pointer';
    }

    function confirmHuyDangKy(maDangKy, tenLop) {
        if (confirm(`Bạn có chắc chắn muốn hủy đăng ký khóa học "${tenLop}" không?`)) {
            const formData = new FormData();
            formData.append('maDangKy', maDangKy);
            formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');

            fetch('/CongHocVien/HuyDangKyPost', {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    if (window.showToast) window.showToast(res.message, 'success');
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    if (window.showToast) window.showToast(res.message, 'error');
                }
            })
            .catch(err => {
                console.error(err);
                if (window.showToast) window.showToast('Có lỗi xảy ra khi hủy đăng ký!', 'error');
            });
        }
    }
</script>
}
