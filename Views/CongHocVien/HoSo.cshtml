@model QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.Models.HocVien
@{
    // Họ và tên: [Tên SV3]
    // Mã sinh viên: [Mã SV3]
    // Nội dung thực hiện: Cổng Học viên - Hồ sơ cá nhân (Module 3) - Phong cách Prep.vn
    ViewData["Title"] = "Hồ Sơ Cá Nhân";
    var taiKhoan = ViewBag.TaiKhoan as QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.Models.TaiKhoan;
}

<div class="flex flex-col gap-y-6 max-w-4xl mx-auto">
    <!-- Sub-header Navigation Bar -->
    <section class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-2 border-b border-border-standard">
        <div>
            <div class="flex items-center gap-2 text-outline font-label-sm text-label-sm uppercase tracking-wider mb-1">
                <span>CỔNG HỌC VIÊN</span>
                <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                <span class="text-brand-deep font-semibold">HỒ SƠ CÁ NHÂN</span>
            </div>
            <h1 class="font-headline-md text-headline-md text-brand-deep font-bold tracking-tight">
                Thông Tin Tài Khoản Học Viên
            </h1>
        </div>

        <div class="flex items-center gap-2.5">
            <a asp-action="TienTrinh" class="inline-flex items-center gap-1.5 bg-surface-white border border-border-standard hover:bg-surface-container-low text-brand-deep font-label-md text-label-md px-3.5 py-2.5 rounded-xl transition-all shadow-xs">
                <span class="material-symbols-outlined text-[18px]">school</span>
                <span>Xem tiến trình</span>
            </a>
        </div>
    </section>

    <!-- Main Profile Card -->
    <div class="bg-surface-white rounded-2xl border border-border-subtle p-6 sm:p-8 shadow-[0_2px_12px_rgba(0,22,86,0.03)]">
        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 pb-6 border-b border-border-standard text-center sm:text-left">
            <div class="w-20 h-20 rounded-3xl bg-primary text-surface-white font-black text-3xl flex items-center justify-center shrink-0 shadow-md">
                @(string.IsNullOrWhiteSpace(Model.HoTen) ? "HV" : Model.HoTen.Substring(0, 1).ToUpper())
            </div>
            <div class="flex-1 space-y-1.5">
                <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2.5">
                    <h2 class="text-xl font-bold text-brand-deep">@Model.HoTen</h2>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                        @Model.TrangThai
                    </span>
                </div>
                <div class="flex flex-wrap items-center justify-center sm:justify-start gap-4 text-xs text-outline font-mono">
                    <span>Mã HV: <strong class="text-brand-deep">#HV@Model.MaHocVien.ToString("D3")</strong></span>
                    <span>•</span>
                    <span>Tài khoản: <strong class="text-brand-deep">@(taiKhoan?.TenDangNhap ?? "hocvien")</strong></span>
                    <span>•</span>
                    <span>Vai trò: <strong class="text-primary">Học viên</strong></span>
                </div>
            </div>
        </div>

        <!-- Edit Profile Form -->
        <form id="hosoForm" onsubmit="submitHoSo(event)" class="pt-6 space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" name="MaHocVien" value="@Model.MaHocVien" />
            <input type="hidden" name="MaTaiKhoan" value="@Model.MaTaiKhoan" />
            <input type="hidden" name="TrangThai" value="@Model.TrangThai" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <!-- Họ tên -->
                <div>
                    <label class="block text-xs font-bold text-brand-deep uppercase mb-1">Họ và tên</label>
                    <input type="text" name="HoTen" value="@Model.HoTen" required
                           class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-border-standard bg-surface-container-lowest focus:bg-surface-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-brand-deep" />
                </div>

                <!-- Email (Readonly) -->
                <div>
                    <label class="block text-xs font-bold text-brand-deep uppercase mb-1">Email (Tên đăng nhập hệ thống)</label>
                    <input type="email" name="Email" value="@Model.Email" readonly
                           class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-border-standard bg-slate-100 text-slate-500 cursor-not-allowed font-mono" />
                </div>

                <!-- Ngày sinh -->
                <div>
                    <label class="block text-xs font-bold text-brand-deep uppercase mb-1">Ngày sinh</label>
                    <input type="date" name="NgaySinh" value="@Model.NgaySinh.ToString("yyyy-MM-dd")" required
                           class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-border-standard bg-surface-container-lowest focus:bg-surface-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-brand-deep font-mono" />
                </div>

                <!-- Giới tính -->
                <div>
                    <label class="block text-xs font-bold text-brand-deep uppercase mb-1">Giới tính</label>
                    <select name="GioiTinh" class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-border-standard bg-surface-container-lowest focus:bg-surface-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-brand-deep">
                        <!option value="Nam" @(Model.GioiTinh == "Nam" ? "selected" : "")>Nam</!option>
                        <!option value="Nữ" @(Model.GioiTinh == "Nữ" ? "selected" : "")>Nữ</!option>
                        <!option value="Khác" @(Model.GioiTinh == "Khác" ? "selected" : "")>Khác</!option>
                    </select>
                </div>

                <!-- Số điện thoại -->
                <div>
                    <label class="block text-xs font-bold text-brand-deep uppercase mb-1">Số điện thoại liên hệ</label>
                    <input type="tel" name="SoDienThoai" value="@Model.SoDienThoai" placeholder="0987654321"
                           class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-border-standard bg-surface-container-lowest focus:bg-surface-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-brand-deep font-mono" />
                </div>

                <!-- Trình độ học vấn -->
                <div>
                    <label class="block text-xs font-bold text-brand-deep uppercase mb-1">Trình độ học vấn</label>
                    <select name="TrinhDoHocVan" class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-border-standard bg-surface-container-lowest focus:bg-surface-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-brand-deep">
                        <!option value="Đại học" @(Model.TrinhDoHocVan == "Đại học" ? "selected" : "")>Đại học</!option>
                        <!option value="Cao đẳng" @(Model.TrinhDoHocVan == "Cao đẳng" ? "selected" : "")>Cao đẳng</!option>
                        <!option value="Trung cấp" @(Model.TrinhDoHocVan == "Trung cấp" ? "selected" : "")>Trung cấp</!option>
                        <!option value="THPT" @(Model.TrinhDoHocVan == "THPT" ? "selected" : "")>THPT</!option>
                        <!option value="Sau đại học" @(Model.TrinhDoHocVan == "Sau đại học" ? "selected" : "")>Sau đại học</!option>
                    </select>
                </div>

                <!-- Nghề nghiệp -->
                <div>
                    <label class="block text-xs font-bold text-brand-deep uppercase mb-1">Nghề nghiệp hiện tại</label>
                    <input type="text" name="NgheNghiep" value="@Model.NgheNghiep" placeholder="Sinh viên, Nhân viên..."
                           class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-border-standard bg-surface-container-lowest focus:bg-surface-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-brand-deep" />
                </div>

                <!-- Địa chỉ -->
                <div>
                    <label class="block text-xs font-bold text-brand-deep uppercase mb-1">Địa chỉ thường trú</label>
                    <input type="text" name="DiaChi" value="@Model.DiaChi" placeholder="Số nhà, đường, quận/huyện, TP"
                           class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-border-standard bg-surface-container-lowest focus:bg-surface-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-brand-deep" />
                </div>
            </div>

            <div class="pt-4 border-t border-border-standard flex items-center justify-end">
                <button type="submit" class="px-6 py-2.5 text-xs font-bold text-surface-white bg-primary hover:bg-[#0047b3] rounded-xl shadow-sm hover:shadow transition-all flex items-center gap-1.5 cursor-pointer">
                    <span class="material-symbols-outlined text-[16px]">save</span>
                    <span>Cập nhật thông tin</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function submitHoSo(e) {
        e.preventDefault();
        const form = document.getElementById('hosoForm');
        const formData = new FormData(form);

        fetch('/CongHocVien/CapNhatHoSoPost', {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(res => res.json())
        .then(res => {
            if (res.success) {
                if (window.showToast) window.showToast(res.message, 'success');
            } else {
                if (window.showToast) window.showToast(res.message, 'error');
            }
        })
        .catch(err => {
            console.error(err);
            if (window.showToast) window.showToast('Có lỗi xảy ra khi cập nhật hồ sơ!', 'error');
        });
    }
</script>
}
