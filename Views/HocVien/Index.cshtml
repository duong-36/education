@model IEnumerable<QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.Models.HocVien>
@{
    // Họ và tên: Nguyễn Đức Linh
    // Mã sinh viên: 23103100042
    // Nội dung thực hiện: Quản lý học viên (Module 3) - Phong cách Prep.vn
    ViewData["Title"] = "Quản lý Học viên";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
    string search = ViewBag.Search ?? "";
    string selectedTrangThai = ViewBag.SelectedTrangThai ?? "";
    string selectedTrinhDo = ViewBag.SelectedTrinhDo ?? "";
    var trinhDoList = ViewBag.TrinhDoList as List<string> ?? new List<string>();
}

<div id="hocvien-content-area" class="flex flex-col gap-y-6 transition-opacity duration-200">
    <!-- Sub-header Navigation Bar -->
    <section class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-2 border-b border-border-standard">
        <div>
            <div class="flex items-center gap-2 text-outline font-label-sm text-label-sm uppercase tracking-wider mb-1">
                <span>ĐÀO TẠO</span>
                <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                <span class="text-brand-deep font-semibold">QUẢN LÝ HỌC VIÊN</span>
            </div>
            <h1 class="font-headline-md text-headline-md text-brand-deep font-bold tracking-tight">
                Danh sách Hồ sơ Học viên
            </h1>
        </div>

        <div class="flex items-center gap-2.5">
            <button onclick="exportTableToCSV('danh-sach-hoc-vien.csv')" class="inline-flex items-center gap-1.5 bg-surface-white border border-border-standard hover:bg-surface-container-low text-brand-deep font-label-md text-label-md px-3.5 py-2.5 rounded-xl transition-all shadow-xs cursor-pointer">
                <span class="material-symbols-outlined text-[18px] text-primary">file_download</span>
                <span class="hidden sm:inline">Xuất Excel</span>
            </button>
            <button onclick="openCreateDrawer()" class="inline-flex items-center gap-1.5 bg-primary hover:bg-[#0047b3] text-surface-white font-label-md text-label-md px-4 py-2.5 rounded-xl shadow-sm hover:shadow-md transition-all cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">person_add</span>
                <span>Thêm học viên</span>
            </button>
        </div>
    </section>

    <!-- 3 Stat Cards (Top KPI) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle shadow-[0_2px_12px_rgba(0,22,86,0.03)] flex flex-col justify-between">
            <div class="flex items-center justify-between mb-2">
                <span class="text-outline font-label-md text-label-md">Tổng số học viên</span>
                <div class="w-9 h-9 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-[20px]">group</span>
                </div>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="font-display text-[30px] leading-8 text-brand-deep tracking-tight font-black font-mono">@ViewBag.TongSoHocVien</span>
                <span class="text-xs text-outline font-medium">hồ sơ đã lưu</span>
            </div>
        </div>

        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle shadow-[0_2px_12px_rgba(0,22,86,0.03)] flex flex-col justify-between">
            <div class="flex items-center justify-between mb-2">
                <span class="text-outline font-label-md text-label-md">Học viên đang học</span>
                <div class="w-9 h-9 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600">
                    <span class="material-symbols-outlined text-[20px]">school</span>
                </div>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="font-display text-[30px] leading-8 text-emerald-700 tracking-tight font-black font-mono">@ViewBag.DangHoc</span>
                <span class="text-xs text-emerald-600 font-medium font-mono">hồ sơ tích cực</span>
            </div>
        </div>

        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle shadow-[0_2px_12px_rgba(0,22,86,0.03)] flex flex-col justify-between">
            <div class="flex items-center justify-between mb-2">
                <span class="text-outline font-label-md text-label-md">Đã tốt nghiệp / Hoàn thành</span>
                <div class="w-9 h-9 rounded-xl bg-blue-50 flex items-center justify-center text-blue-600">
                    <span class="material-symbols-outlined text-[20px]">verified</span>
                </div>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="font-display text-[30px] leading-8 text-blue-700 tracking-tight font-black font-mono">@ViewBag.TotNghiep</span>
                <span class="text-xs text-blue-600 font-medium font-mono">đạt chứng nhận</span>
            </div>
        </div>
    </div>

    <!-- Filters & Search Toolbar -->
    <div class="bg-surface-white rounded-2xl p-4 border border-border-subtle shadow-[0_2px_12px_rgba(0,22,86,0.03)] flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-3 flex-1 min-w-[280px]">
            <!-- Search Input -->
            <div class="relative flex-1 min-w-[220px]">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-[18px] text-outline">search</span>
                <input type="text" id="searchInput" value="@search" placeholder="Tìm theo họ tên, email, SĐT, mã HV..." 
                       class="w-full pl-9 pr-3 py-2 text-xs rounded-xl border border-border-standard bg-surface-container-lowest focus:bg-surface-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-brand-deep placeholder:text-outline/60" />
            </div>

            <!-- Filter Trạng thái -->
            <div class="min-w-[150px]">
                <select id="filterTrangThai" class="w-full px-3 py-2 text-xs rounded-xl border border-border-standard bg-surface-container-lowest focus:bg-surface-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-brand-deep">
                    <option value="">Tất cả trạng thái</option>
                    <!option value="Đang học" @(selectedTrangThai == "Đang học" ? "selected" : "")>Đang học</!option>
                    <!option value="Đã tốt nghiệp" @(selectedTrangThai == "Đã tốt nghiệp" ? "selected" : "")>Đã tốt nghiệp</!option>
                    <!option value="Bảo lưu" @(selectedTrangThai == "Bảo lưu" ? "selected" : "")>Bảo lưu</!option>
                    <!option value="Đã nghỉ" @(selectedTrangThai == "Đã nghỉ" ? "selected" : "")>Đã nghỉ</!option>
                </select>
            </div>

            <!-- Filter Trình độ học vấn -->
            <div class="min-w-[160px]">
                <select id="filterTrinhDo" class="w-full px-3 py-2 text-xs rounded-xl border border-border-standard bg-surface-container-lowest focus:bg-surface-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-brand-deep">
                    <option value="">Tất cả trình độ</option>
                    @foreach (var td in trinhDoList)
                    {
                        <!option value="@td" @(selectedTrinhDo == td ? "selected" : "")>@td</!option>
                    }
                </select>
            </div>
        </div>

        <button type="button" onclick="resetFilters()" class="text-xs text-outline hover:text-primary font-medium flex items-center gap-1 px-3 py-2 rounded-xl hover:bg-surface-container-low transition-colors">
            <span class="material-symbols-outlined text-[16px]">restart_alt</span>
            <span>Đặt lại</span>
        </button>
    </div>

    <!-- Table Section (SPA Ajax Replace Target) -->
    <div id="table-wrapper">
        @await Html.PartialAsync("_HocVienTablePartial", Model)
    </div>
</div>

<!-- ================= RIGHT SLIDE-OVER DRAWER (CREATE / EDIT) ================= -->
<div id="drawer-backdrop" onclick="closeDrawer()" class="fixed inset-0 bg-brand-deep/40 backdrop-blur-xs z-50 transition-opacity duration-300 opacity-0 pointer-events-none"></div>

<aside id="drawer" class="fixed top-0 right-0 h-full w-full max-w-lg bg-surface-white shadow-2xl z-50 transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col">
    <!-- Drawer Header -->
    <div class="p-6 border-b border-border-standard flex items-center justify-between bg-surface-container-lowest">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center text-primary" id="drawer-icon">
                <span class="material-symbols-outlined text-[22px]">person_add</span>
            </div>
            <div>
                <h2 class="font-bold text-base text-brand-deep" id="drawer-title">Thêm Học Viên Mới</h2>
                <p class="text-xs text-outline" id="drawer-subtitle">Nhập thông tin hồ sơ học viên</p>
            </div>
        </div>
        <button onclick="closeDrawer()" class="p-2 rounded-xl hover:bg-surface-container-high text-outline hover:text-brand-deep transition-colors">
            <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
    </div>

    <!-- Drawer Body / Form -->
    <form id="drawerForm" onsubmit="handleFormSubmit(event)" class="flex-1 overflow-y-auto p-6 space-y-4">
        @Html.AntiForgeryToken()
        <input type="hidden" id="form-MaHocVien" name="MaHocVien" value="0" />

        <!-- Họ tên -->
        <div>
            <label class="block text-xs font-bold text-brand-deep uppercase mb-1">Họ và tên <span class="text-rose-500">*</span></label>
            <input type="text" id="form-HoTen" name="HoTen" required placeholder="Ví dụ: Nguyễn Văn A"
                   class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-border-standard bg-surface-container-lowest focus:bg-surface-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-brand-deep" />
        </div>

        <!-- Ngày sinh & Giới tính -->
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-xs font-bold text-brand-deep uppercase mb-1">Ngày sinh <span class="text-rose-500">*</span></label>
                <input type="date" id="form-NgaySinh" name="NgaySinh" required
                       class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-border-standard bg-surface-container-lowest focus:bg-surface-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-brand-deep" />
            </div>
            <div>
                <label class="block text-xs font-bold text-brand-deep uppercase mb-1">Giới tính</label>
                <select id="form-GioiTinh" name="GioiTinh" class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-border-standard bg-surface-container-lowest focus:bg-surface-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-brand-deep">
                    <option value="Nam">Nam</option>
                    <option value="Nữ">Nữ</option>
                    <option value="Khác">Khác</option>
                </select>
            </div>
        </div>

        <!-- Email & Số điện thoại -->
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-xs font-bold text-brand-deep uppercase mb-1">Email <span class="text-rose-500">*</span></label>
                <input type="email" id="form-Email" name="Email" required placeholder="hocvien@gmail.com"
                       class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-border-standard bg-surface-container-lowest focus:bg-surface-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-brand-deep" />
            </div>
            <div>
                <label class="block text-xs font-bold text-brand-deep uppercase mb-1">Số điện thoại</label>
                <input type="tel" id="form-SoDienThoai" name="SoDienThoai" placeholder="0987654321"
                       class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-border-standard bg-surface-container-lowest focus:bg-surface-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-brand-deep" />
            </div>
        </div>

        <!-- Địa chỉ -->
        <div>
            <label class="block text-xs font-bold text-brand-deep uppercase mb-1">Địa chỉ thường trú</label>
            <input type="text" id="form-DiaChi" name="DiaChi" placeholder="Số nhà, tên đường, quận/huyện, TP"
                   class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-border-standard bg-surface-container-lowest focus:bg-surface-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-brand-deep" />
        </div>

        <!-- Trình độ học vấn & Nghề nghiệp -->
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-xs font-bold text-brand-deep uppercase mb-1">Trình độ học vấn</label>
                <select id="form-TrinhDoHocVan" name="TrinhDoHocVan" class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-border-standard bg-surface-container-lowest focus:bg-surface-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-brand-deep">
                    <option value="Đại học">Đại học</option>
                    <option value="Cao đẳng">Cao đẳng</option>
                    <option value="Trung cấp">Trung cấp</option>
                    <option value="THPT">THPT</option>
                    <option value="Sau đại học">Sau đại học</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-brand-deep uppercase mb-1">Nghề nghiệp</label>
                <input type="text" id="form-NgheNghiep" name="NgheNghiep" placeholder="Sinh viên, Kỹ sư, ..."
                       class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-border-standard bg-surface-container-lowest focus:bg-surface-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-brand-deep" />
            </div>
        </div>

        <!-- Trạng thái -->
        <div>
            <label class="block text-xs font-bold text-brand-deep uppercase mb-1">Trạng thái hồ sơ</label>
            <select id="form-TrangThai" name="TrangThai" class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-border-standard bg-surface-container-lowest focus:bg-surface-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-brand-deep">
                <option value="Đang học">Đang học</option>
                <option value="Đã tốt nghiệp">Đã tốt nghiệp</option>
                <option value="Bảo lưu">Bảo lưu</option>
                <option value="Đã nghỉ">Đã nghỉ</option>
            </select>
        </div>

        <!-- Account fields (Chỉ hiện khi tạo mới) -->
        <div id="account-fields-section" class="pt-3 border-t border-border-standard space-y-3">
            <span class="text-xs font-bold text-outline block">TÀI KHOẢN HỆ THỐNG</span>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-[11px] font-medium text-brand-deep mb-1">Tên đăng nhập (tùy chọn)</label>
                    <input type="text" id="form-TenDangNhap" name="tenDangNhap" placeholder="Mặc định theo Email"
                           class="w-full px-3 py-2 text-xs rounded-xl border border-border-standard bg-surface-container-lowest focus:bg-surface-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-brand-deep" />
                </div>
                <div>
                    <label class="block text-[11px] font-medium text-brand-deep mb-1">Mật khẩu khởi tạo</label>
                    <input type="text" id="form-MatKhau" name="matKhau" placeholder="Mặc định: 123456"
                           class="w-full px-3 py-2 text-xs rounded-xl border border-border-standard bg-surface-container-lowest focus:bg-surface-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary text-brand-deep" />
                </div>
            </div>
        </div>
    </form>

    <!-- Drawer Footer -->
    <div class="p-6 border-t border-border-standard bg-surface-container-lowest flex items-center justify-end gap-3">
        <button type="button" onclick="closeDrawer()" class="px-4 py-2.5 text-xs font-semibold text-outline hover:text-brand-deep border border-border-standard rounded-xl hover:bg-surface-container-high transition-colors">
            Hủy
        </button>
        <button type="button" onclick="document.getElementById('drawerForm').requestSubmit()" class="px-5 py-2.5 text-xs font-semibold text-surface-white bg-primary hover:bg-[#0047b3] rounded-xl shadow-sm hover:shadow transition-all flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[16px]">save</span>
            <span id="btn-submit-text">Lưu hồ sơ</span>
        </button>
    </div>
</aside>

@section Scripts {
<script>
    let currentPage = @currentPage;
    let isEditing = false;
    let searchDebounceTimer = null;

    // Lắng nghe tìm kiếm debounce
    document.getElementById('searchInput').addEventListener('input', function() {
        clearTimeout(searchDebounceTimer);
        searchDebounceTimer = setTimeout(() => {
            currentPage = 1;
            loadTableData();
        }, 350);
    });

    document.getElementById('filterTrangThai').addEventListener('change', () => { currentPage = 1; loadTableData(); });
    document.getElementById('filterTrinhDo').addEventListener('change', () => { currentPage = 1; loadTableData(); });

    function resetFilters() {
        document.getElementById('searchInput').value = '';
        document.getElementById('filterTrangThai').value = '';
        document.getElementById('filterTrinhDo').value = '';
        currentPage = 1;
        loadTableData();
    }

    function changePage(page) {
        currentPage = page;
        loadTableData();
    }

    function loadTableData() {
        const search = document.getElementById('searchInput').value.trim();
        const trangThai = document.getElementById('filterTrangThai').value;
        const trinhDo = document.getElementById('filterTrinhDo').value;

        const params = new URLSearchParams({
            search: search,
            trangThai: trangThai,
            trinhDo: trinhDo,
            page: currentPage
        });

        const wrapper = document.getElementById('table-wrapper');
        wrapper.classList.add('opacity-50');

        fetch(`/HocVien/Index?${params.toString()}`, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(res => res.text())
        .then(html => {
            wrapper.innerHTML = html;
            wrapper.classList.remove('opacity-50');
        })
        .catch(err => {
            console.error(err);
            wrapper.classList.remove('opacity-50');
            if (window.showToast) window.showToast('Lỗi tải dữ liệu!', 'error');
        });
    }

    // Drawer Logic
    function openCreateDrawer() {
        isEditing = false;
        document.getElementById('drawer-title').innerText = 'Thêm Học Viên Mới';
        document.getElementById('drawer-subtitle').innerText = 'Nhập thông tin hồ sơ học viên vào hệ thống';
        document.getElementById('btn-submit-text').innerText = 'Lưu hồ sơ';
        document.getElementById('account-fields-section').style.display = 'block';

        const form = document.getElementById('drawerForm');
        form.reset();
        document.getElementById('form-MaHocVien').value = '0';
        document.getElementById('form-NgaySinh').value = '2000-01-01';

        showDrawerUI();
    }

    function openEditDrawer(id) {
        isEditing = true;
        document.getElementById('drawer-title').innerText = 'Chỉnh Sửa Hồ Sơ Học Viên';
        document.getElementById('drawer-subtitle').innerText = `Cập nhật thông tin học viên #${id}`;
        document.getElementById('btn-submit-text').innerText = 'Cập nhật';
        document.getElementById('account-fields-section').style.display = 'none';

        fetch(`/HocVien/GetHocVien?id=${id}`)
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    const d = res.data;
                    document.getElementById('form-MaHocVien').value = d.maHocVien;
                    document.getElementById('form-HoTen').value = d.hoTen || '';
                    document.getElementById('form-NgaySinh').value = d.ngaySinh || '';
                    document.getElementById('form-GioiTinh').value = d.gioiTinh || 'Nam';
                    document.getElementById('form-SoDienThoai').value = d.soDienThoai || '';
                    document.getElementById('form-Email').value = d.email || '';
                    document.getElementById('form-DiaChi').value = d.diaChi || '';
                    document.getElementById('form-TrinhDoHocVan').value = d.trinhDoHocVan || 'Đại học';
                    document.getElementById('form-NgheNghiep').value = d.ngheNghiep || '';
                    document.getElementById('form-TrangThai').value = d.trangThai || 'Đang học';
                    showDrawerUI();
                } else {
                    if (window.showToast) window.showToast(res.message, 'error');
                }
            })
            .catch(err => {
                console.error(err);
                if (window.showToast) window.showToast('Không thể lấy thông tin học viên.', 'error');
            });
    }

    function showDrawerUI() {
        const backdrop = document.getElementById('drawer-backdrop');
        const drawer = document.getElementById('drawer');
        backdrop.classList.remove('opacity-0', 'pointer-events-none');
        drawer.classList.remove('translate-x-full');
    }

    function closeDrawer() {
        const backdrop = document.getElementById('drawer-backdrop');
        const drawer = document.getElementById('drawer');
        backdrop.classList.add('opacity-0', 'pointer-events-none');
        drawer.classList.add('translate-x-full');
    }

    function handleFormSubmit(e) {
        e.preventDefault();
        const form = document.getElementById('drawerForm');
        const formData = new FormData(form);
        const url = isEditing ? '/HocVien/EditPost' : '/HocVien/CreatePost';

        fetch(url, {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(res => res.json())
        .then(res => {
            if (res.success) {
                if (window.showToast) window.showToast(res.message, 'success');
                closeDrawer();
                loadTableData();
            } else {
                if (window.showToast) window.showToast(res.message, 'error');
            }
        })
        .catch(err => {
            console.error(err);
            if (window.showToast) window.showToast('Có lỗi xảy ra khi lưu dữ liệu!', 'error');
        });
    }

    function confirmDelete(id, name) {
        if (typeof openGlobalDeleteModal === 'function') {
            openGlobalDeleteModal({
                title: 'Xóa hồ sơ học viên',
                message: `Bạn có chắc chắn muốn xóa học viên #${id} (${name})? Thao tác này không thể hoàn tác nếu học viên chưa có lịch sử học tập.`,
                confirmUrl: '/HocVien/DeletePost',
                itemId: id,
                onSuccess: function() {
                    loadTableData();
                }
            });
        } else {
            if (confirm(`Bạn có chắc muốn xóa học viên ${name}?`)) {
                const formData = new FormData();
                formData.append('id', id);
                formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
                fetch('/HocVien/DeletePost', {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(r => r.json())
                .then(r => {
                    if (r.success) {
                        if (window.showToast) window.showToast(r.message, 'success');
                        loadTableData();
                    } else {
                        if (window.showToast) window.showToast(r.message, 'error');
                    }
                });
            }
        }
    }

    // CSV Export
    function exportTableToCSV(filename) {
        const rows = document.querySelectorAll("#hocvien-table tr");
        let csv = [];
        for (let i = 0; i < rows.length; i++) {
            let row = [], cols = rows[i].querySelectorAll("td, th");
            for (let j = 0; j < cols.length - 1; j++) {
                row.push('"' + cols[j].innerText.replace(/"/g, '""').trim() + '"');
            }
            csv.push(row.join(","));
        }
        const csvFile = new Blob(["\uFEFF" + csv.join("\n")], { type: "text/csv;charset=utf-8;" });
        const downloadLink = document.createElement("a");
        downloadLink.download = filename;
        downloadLink.href = window.URL.createObjectURL(csvFile);
        downloadLink.style.display = "none";
        document.body.appendChild(downloadLink);
        downloadLink.click();
    }
</script>
}
