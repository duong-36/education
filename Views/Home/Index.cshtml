@{
    // Họ và tên: Nhóm 5 (Vũ Đình Trường - Nguyễn Đình Kiên - Nguyễn Đức Linh - Nguyễn Hoàng Long - Nguyễn Tùng Dương)
    // Lớp: DHTI17A1HN - Đại học Kinh tế - Kỹ thuật Công nghiệp (UNETI)
    // Nội dung thực hiện: Trang chủ Nền tảng Thương mại Giáo dục UNETI EDUSPACE (EdTech Commercial Homepage)
    Layout = "_StudentLayout";
    ViewData["Title"] = "UNETI EDUSPACE - Học Viện Đào Tạo & Kỹ Năng Thực Chiến Chuẩn Doanh Nghiệp";

    var chuongTrinhs = ViewBag.ChuongTrinhs as List<QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.Models.ChuongTrinhDaoTao> ?? new List<QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.Models.ChuongTrinhDaoTao>();
    var openClassCounts = ViewBag.OpenClassCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var hotCourses = ViewBag.HotCourses as List<QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.Models.LopHoc> ?? new List<QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.Models.LopHoc>();
    var upcomingCourses = ViewBag.UpcomingCourses as List<QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.Models.LopHoc> ?? new List<QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.Models.LopHoc>();
    var siSoMap = ViewBag.SiSoMap as Dictionary<int, int> ?? new Dictionary<int, int>();

    int totalCourses = ViewBag.TotalCourses ?? 0;
    int totalStudents = ViewBag.TotalStudents ?? 0;
    int totalRegistrations = ViewBag.TotalRegistrations ?? 0;

    var currentStudent = ViewBag.CurrentStudent as QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.Models.HocVien;
    bool isLoggedInStudent = currentStudent != null;
    var myRegistrations = ViewBag.MyRegistrations as Dictionary<int, QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.Models.DangKyHoc> ?? new Dictionary<int, QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.Models.DangKyHoc>();
    var activeCourse = ViewBag.ActiveCourse as QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.Models.DangKyHoc;
    var nextSession = ViewBag.NextSession as QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.Models.BuoiHoc;
    int totalSessions = ViewBag.TotalSessions ?? 0;
    int completedSessions = ViewBag.CompletedSessions ?? 0;
    double progressPercent = totalSessions > 0 ? Math.Min(100.0, Math.Round((double)completedSessions / totalSessions * 100, 1)) : 0;
}

<div class="space-y-16 sm:space-y-24 pb-16">

    <!-- ================= 1. HERO SECTION (THƯƠNG MẠI ĐỈNH CAO) ================= -->
    <section class="relative bg-gradient-to-b from-[#001242] via-[#001e66] to-[#002f87] text-white pt-12 pb-20 sm:pt-20 sm:pb-32 overflow-hidden">
        <!-- Background Tech Glow Circles -->
        <div class="absolute -top-24 -left-24 w-96 h-96 bg-primary/30 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute top-1/2 -right-24 w-[30rem] h-[30rem] bg-indigo-500/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute inset-0 bg-[radial-gradient(#ffffff0a_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                <!-- Left: Hero Headline & Action -->
                <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
                    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-xs font-semibold text-amber-300">
                        <span class="flex h-2 w-2 rounded-full bg-amber-400 animate-ping"></span>
                        <span>Tuyển sinh Khóa Đào tạo Thực chiến Kỳ Mới 2024 - 2025</span>
                    </div>

                    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-[1.15] text-white">
                        Kiến Tạo Tương Lai <br />
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-sky-300 to-indigo-200">
                            Công Nghệ Thực Chiến
                        </span>
                    </h1>

                    <p class="text-sm sm:text-base lg:text-lg text-slate-200 max-w-2xl mx-auto lg:mx-0 font-normal leading-relaxed">
                        Chương trình đào tạo nghề nghiệp và chứng chỉ quốc tế chất lượng cao tại <strong>UNETI EDUSPACE</strong>. Giảng viên chuyên gia doanh nghiệp, 80% thời lượng thực hành, cam kết giới thiệu việc làm ngay sau tốt nghiệp.
                    </p>

                    <!-- Quick Search Bar on Hero -->
                    <form action="/CongHocVien/DangKy" method="get" class="max-w-xl mx-auto lg:mx-0">
                        <div class="relative flex items-center bg-white rounded-2xl p-1.5 shadow-2xl border border-white/20">
                            <span class="material-symbols-outlined text-outline pl-3 text-[22px]">search</span>
                            <input type="text" name="search" placeholder="Bạn muốn học gì hôm nay? (ASP.NET, React, AI, Python...)"
                                   class="w-full px-3 py-2.5 text-xs sm:text-sm text-brand-deep placeholder:text-outline bg-transparent focus:outline-none" />
                            <button type="submit" class="px-5 py-2.5 rounded-xl bg-primary hover:bg-primary-hover text-white text-xs sm:text-sm font-bold shadow-md transition-all shrink-0">
                                Tìm khóa học
                            </button>
                        </div>
                    </form>

                    <!-- Action Buttons -->
                    <div class="flex flex-wrap items-center justify-center lg:justify-start gap-4 pt-2">
                        <a href="/CongHocVien/DangKy"
                           class="px-6 py-3.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-900 font-extrabold text-xs sm:text-sm shadow-lg shadow-amber-400/25 transition-all flex items-center gap-2 group">
                            <span>Khám Phá Khóa Học Ngay</span>
                            <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
                        </a>
                        <a href="#tu-van-section"
                           class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs sm:text-sm border border-white/20 backdrop-blur-md transition-all flex items-center gap-2">
                            <span class="material-symbols-outlined text-[18px]">support_agent</span>
                            <span>Nhận Tư Vấn Lộ Trình</span>
                        </a>
                    </div>

                    <!-- Trust Stats Badges -->
                    <div class="pt-6 border-t border-white/10 grid grid-cols-3 gap-4 max-w-lg mx-auto lg:mx-0 text-left">
                        <div>
                            <div class="text-xl sm:text-2xl font-black text-amber-300 font-mono">15,000+</div>
                            <div class="text-[11px] text-slate-300">Học viên tin chọn</div>
                        </div>
                        <div>
                            <div class="text-xl sm:text-2xl font-black text-sky-300 font-mono">98.2%</div>
                            <div class="text-[11px] text-slate-300">Có việc làm đúng ngành</div>
                        </div>
                        <div>
                            <div class="text-xl sm:text-2xl font-black text-emerald-300 font-mono">100+</div>
                            <div class="text-[11px] text-slate-300">Doanh nghiệp đối tác</div>
                        </div>
                    </div>
                </div>

                <!-- Right: Visual EdTech Showcase Card -->
                <div class="lg:col-span-5 relative hidden lg:block">
                    <div class="relative mx-auto max-w-sm rounded-3xl bg-white/10 backdrop-blur-xl border border-white/20 p-6 shadow-2xl space-y-5">
                        <!-- Top floating badge -->
                        <div class="flex items-center justify-between pb-4 border-b border-white/10">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-2xl bg-amber-400 text-slate-900 flex items-center justify-center font-bold">
                                    <span class="material-symbols-outlined text-[22px]">workspace_premium</span>
                                </div>
                                <div>
                                    <h4 class="text-xs font-bold text-white">Chứng Chỉ UNETI</h4>
                                    <p class="text-[10px] text-slate-300">Công nhận toàn quốc</p>
                                </div>
                            </div>
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/30 text-emerald-300 border border-emerald-400/30">
                                CHUẨN ĐẦU RA
                            </span>
                        </div>

                        <!-- Mini Demo Course Card -->
                        <div class="bg-white rounded-2xl p-4 text-slate-900 space-y-3 shadow-lg">
                            <div class="flex items-center justify-between">
                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-primary-light text-primary uppercase">
                                    Lập trình Web & Mobile
                                </span>
                                <span class="text-xs font-bold text-amber-500 flex items-center gap-0.5">
                                    <span class="material-symbols-outlined text-[14px]">star</span> 4.9 (140+)
                                </span>
                            </div>
                            <h5 class="text-sm font-bold text-brand-deep">Chuyên gia ASP.NET Core & Fullstack Cloud</h5>
                            <p class="text-[11px] text-outline">Giảng viên: ThS. Hoàng Long (Tech Lead FPT)</p>
                            <div class="flex items-center justify-between pt-2 border-t border-border-standard text-xs">
                                <span class="text-[11px] text-outline">Khai giảng: <strong class="text-brand-deep">Tháng này</strong></span>
                                <span class="font-mono font-black text-emerald-700">5.500.000 đ</span>
                            </div>
                        </div>

                        <!-- Live Study Urgency Strip -->
                        <div class="flex items-center justify-between text-xs text-slate-200 bg-white/10 px-4 py-2.5 rounded-xl border border-white/10">
                            <span class="flex items-center gap-1.5">
                                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                                Đang mở @totalCourses lớp học phần
                            </span>
                            <a href="/CongHocVien/DangKy" class="text-amber-300 hover:underline font-semibold text-[11px]">Xem tất cả →</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ================= 2. PERSONALIZED STUDENT WIDGET (CHỈ HIỂN THỊ KHI ĐÃ ĐĂNG NHẬP) ================= -->
    @if (isLoggedInStudent)
    {
        <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-10 sm:-mt-14 relative z-20">
            <div class="bg-white rounded-3xl p-6 sm:p-7 shadow-xl border border-border-standard">
                <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
                    <!-- Left: Greeting -->
                    <div class="flex items-center gap-4">
                        <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-brand-deep to-primary text-white font-black text-xl flex items-center justify-center shrink-0 shadow-md">
                            @(string.IsNullOrWhiteSpace(currentStudent?.HoTen) ? "HV" : currentStudent.HoTen.Substring(0, 1).ToUpper())
                        </div>
                        <div class="space-y-1">
                            <div class="flex items-center gap-2">
                                <h3 class="text-base sm:text-lg font-bold text-brand-deep">
                                    Chào mừng bạn quay lại, @currentStudent?.HoTen! 👋
                                </h3>
                                <span class="hidden sm:inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-primary-light text-primary">
                                    Học viên UNETI
                                </span>
                            </div>
                            <p class="text-xs text-outline font-mono">
                                Mã HV: <strong>#HV@(currentStudent?.MaHocVien.ToString("D3"))</strong> • Bạn đã đăng ký <strong>@myRegistrations.Count khóa học</strong>
                            </p>
                        </div>
                    </div>

                    <!-- Right: Quick Learning Shortcut -->
                    <div class="flex flex-wrap items-center gap-4 w-full md:w-auto justify-between md:justify-end border-t md:border-t-0 pt-4 md:pt-0 border-border-standard">
                        @if (activeCourse != null)
                        {
                            <div class="text-left md:text-right text-xs">
                                <span class="text-outline text-[11px] block">Khóa học đang học:</span>
                                <strong class="text-brand-deep truncate max-w-[220px] block">@(activeCourse.LopHoc?.TenLop)</strong>
                                <span class="text-primary font-mono text-[11px] font-semibold">Tiến độ: @progressPercent% (@completedSessions/@totalSessions buổi)</span>
                            </div>
                        }
                        <a href="/CongHocVien/TienTrinh"
                           class="px-5 py-2.5 rounded-xl bg-primary hover:bg-primary-hover text-white text-xs font-bold shadow-md transition-all flex items-center gap-2">
                            <span class="material-symbols-outlined text-[18px]">play_circle</span>
                            <span>Vào Không Gian Học Tập</span>
                        </a>
                    </div>
                </div>

                @if (nextSession != null)
                {
                    <div class="mt-4 pt-4 border-t border-border-standard flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs bg-amber-50/70 p-3.5 rounded-2xl border border-amber-200">
                        <div class="flex items-center gap-2 text-amber-900">
                            <span class="material-symbols-outlined text-[18px] text-amber-600">notifications_active</span>
                            <span><strong>Buổi học sắp tới:</strong> @(nextSession.LopHoc?.TenLop) • @nextSession.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm") tại Phòng <strong>@nextSession.PhongHoc</strong></span>
                        </div>
                        <a href="/CongHocVien/TienTrinh" class="text-primary font-bold hover:underline shrink-0 text-xs">Xem chi tiết lịch →</a>
                    </div>
                }
            </div>
        </section>
    }

    <!-- ================= 3. STAT HIGHLIGHTS (SỐ LIỆU BẢO CHỨNG) ================= -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
            <div class="bg-white rounded-3xl p-6 border border-border-standard shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between space-y-3">
                <div class="w-12 h-12 rounded-2xl bg-blue-50 text-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-[26px]">school</span>
                </div>
                <div>
                    <h3 class="text-2xl sm:text-3xl font-black text-brand-deep font-mono">10+ Năm</h3>
                    <p class="text-xs text-outline mt-0.5">Kinh nghiệm đào tạo thực chiến tại UNETI</p>
                </div>
            </div>

            <div class="bg-white rounded-3xl p-6 border border-border-standard shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between space-y-3">
                <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[26px]">group</span>
                </div>
                <div>
                    <h3 class="text-2xl sm:text-3xl font-black text-brand-deep font-mono">@(Math.Max(15000, totalStudents * 150))+</h3>
                    <p class="text-xs text-outline mt-0.5">Học viên đã tốt nghiệp & nhận chứng chỉ</p>
                </div>
            </div>

            <div class="bg-white rounded-3xl p-6 border border-border-standard shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between space-y-3">
                <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[26px]">verified</span>
                </div>
                <div>
                    <h3 class="text-2xl sm:text-3xl font-black text-emerald-700 font-mono">98.2%</h3>
                    <p class="text-xs text-outline mt-0.5">Tỷ lệ học viên có việc làm đúng chuyên ngành</p>
                </div>
            </div>

            <div class="bg-white rounded-3xl p-6 border border-border-standard shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between space-y-3">
                <div class="w-12 h-12 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[26px]">handshake</span>
                </div>
                <div>
                    <h3 class="text-2xl sm:text-3xl font-black text-brand-deep font-mono">100+</h3>
                    <p class="text-xs text-outline mt-0.5">Doanh nghiệp công nghệ đối tác tuyển dụng</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ================= 4. SPECIALIZATION TRACKS (CHUYÊN NGÀNH ĐÀO TẠO) ================= -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
            <div>
                <span class="text-xs font-bold text-primary uppercase tracking-wider">Lĩnh vực chuyên môn</span>
                <h2 class="text-2xl sm:text-3xl font-black text-brand-deep tracking-tight mt-1">
                    Chương Trình Đào Tạo Trọng Điểm
                </h2>
                <p class="text-xs sm:text-sm text-outline mt-1 max-w-xl">
                    Được thiết kế chuẩn hóa theo đơn đặt hàng của các doanh nghiệp công nghệ, chú trọng tính ứng dụng thực tiễn cao.
                </p>
            </div>
            <a href="/CongHocVien/DangKy" class="text-xs font-bold text-primary hover:underline flex items-center gap-1 shrink-0">
                <span>Xem tất cả chuyên ngành</span>
                <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
            </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            @{
                string[] trackIcons = new string[] { "code", "smart_toy", "security", "brush", "translate", "analytics" };
                int iconIdx = 0;
            }
            @foreach (var ct in chuongTrinhs)
            {
                int openCount = openClassCounts.ContainsKey(ct.MaChuongTrinh) ? openClassCounts[ct.MaChuongTrinh] : 0;
                string icon = trackIcons[iconIdx % trackIcons.Length];
                iconIdx++;

                <a href="/CongHocVien/DangKy?maChuongTrinh=@ct.MaChuongTrinh"
                   class="bg-white rounded-3xl p-6 border border-border-standard hover:border-primary/50 shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between group space-y-4">
                    <div class="space-y-3">
                        <div class="w-12 h-12 rounded-2xl bg-primary-light text-primary flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-colors">
                            <span class="material-symbols-outlined text-[26px]">@icon</span>
                        </div>
                        <h3 class="text-base font-bold text-brand-deep group-hover:text-primary transition-colors">
                            @ct.TenChuongTrinh
                        </h3>
                        <p class="text-xs text-outline line-clamp-2 leading-relaxed">
                            @(string.IsNullOrWhiteSpace(ct.MoTa) ? "Chương trình đào tạo thực chiến bám sát nhu cầu tuyển dụng của thị trường lao động số." : ct.MoTa)
                        </p>
                    </div>

                    <div class="pt-3 border-t border-border-standard flex items-center justify-between text-xs">
                        <span class="font-mono text-outline font-medium">@openCount lớp đang mở</span>
                        <span class="text-primary font-bold flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                            Khám phá <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
                        </span>
                    </div>
                </a>
            }
        </div>
    </section>

    <!-- ================= 5. BEST-SELLER COURSES (KHÓA HỌC BÁN CHẠY & NỔI BẬT NHẤT) ================= -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
            <div>
                <span class="text-xs font-bold text-amber-600 uppercase tracking-wider flex items-center gap-1">
                    <span class="material-symbols-outlined text-[16px]">local_fire_department</span>
                    Khóa học được quan tâm nhất
                </span>
                <h2 class="text-2xl sm:text-3xl font-black text-brand-deep tracking-tight mt-1">
                    Khóa Học Thực Chiến Bán Chạy Nhất
                </h2>
                <p class="text-xs sm:text-sm text-outline mt-1 max-w-xl">
                    Được đông đảo học viên và các bạn sinh viên tin tưởng lựa chọn nhiều nhất trong học kỳ này.
                </p>
            </div>
            <a href="/CongHocVien/DangKy" class="text-xs font-bold text-primary hover:underline flex items-center gap-1 shrink-0">
                <span>Xem khoá học khác</span>
                <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
            </a>
        </div>

        @if (!hotCourses.Any())
        {
            <div class="bg-white rounded-3xl p-12 text-center text-outline border border-border-standard">
                <span class="material-symbols-outlined text-[44px] opacity-40 mb-2">school</span>
                <p class="text-xs">Hiện tại trung tâm đang cập nhật lịch tuyển sinh các khóa mới.</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var lop in hotCourses)
                {
                    int currentEnrolled = siSoMap.ContainsKey(lop.MaLop) ? siSoMap[lop.MaLop] : 0;
                    int maxCapacity = lop.SiSoToiDa;
                    int remainingSeats = Math.Max(0, maxCapacity - currentEnrolled);
                    double fillPercent = maxCapacity > 0 ? Math.Min(100.0, Math.Round((double)currentEnrolled / maxCapacity * 100, 1)) : 0;
                    bool isFull = remainingSeats <= 0;
                    bool isRegistered = myRegistrations.ContainsKey(lop.MaLop);

                    <div class="bg-white rounded-3xl border border-border-standard hover:border-primary/50 shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between overflow-hidden group">
                        <!-- Card Cover Top -->
                        <div class="relative h-44 bg-gradient-to-tr from-brand-deep to-primary p-5 flex flex-col justify-between text-white overflow-hidden">
                            <div class="absolute -right-8 -bottom-8 w-32 h-32 bg-white/10 rounded-full blur-xl pointer-events-none group-hover:scale-125 transition-transform"></div>

                            <div class="flex items-center justify-between relative z-10">
                                <span class="px-2.5 py-1 rounded-full text-[10px] font-extrabold bg-amber-400 text-slate-900 shadow-sm flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[13px]">local_fire_department</span> BÁN CHẠY
                                </span>
