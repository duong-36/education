@model QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.ViewModels.RegisterViewModel
@{
    // Họ và tên: Vũ Đình Trường
    // Mã sinh viên: 23103100026
    // Nội dung thực hiện: Giao diện Đăng ký tài khoản học viên (Module 1) - Phong cách Prep.vn
    ViewData["Title"] = "Đăng ký tài khoản học viên";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Đăng ký học viên - UNETI EDUSPACE</title>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "brand-deep": "#001656",
                        "primary": "#0052cc",
                        "primary-container": "#0068ff",
                        "canvas-base": "#F8FAFC",
                        "surface-white": "#FFFFFF",
                        "border-standard": "#E2E8F0",
                        "border-subtle": "#F1F5F9",
                        "outline": "#727687",
                        "danger-crimson": "#EF4444"
                    },
                    fontFamily: {
                        sans: ["'Be Vietnam Pro'", "sans-serif"]
                    }
                }
            }
        };
    </script>
</head>
<body class="bg-gradient-to-br from-[#001656] via-[#002d80] to-[#0052cc] min-h-screen flex items-center justify-center p-4 py-8 font-sans antialiased">
    <div class="w-full max-w-lg">
        <!-- Main Register Card -->
        <div class="bg-surface-white rounded-3xl shadow-2xl p-6 sm:p-9 border border-white/20 backdrop-blur-sm">
            <!-- Brand Logo & Header -->
            <div class="flex flex-col items-center text-center mb-6">
                <a href="/" class="flex flex-col items-center group">
                    <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-primary to-primary-container text-surface-white flex items-center justify-center shadow-lg shadow-primary/30 mb-3 group-hover:scale-105 transition-transform">
                        <span class="material-symbols-outlined text-[32px]">school</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="text-2xl font-black text-brand-deep tracking-tight">UNETI</span>
                        <span class="text-xs px-2 py-0.5 rounded bg-primary text-white font-extrabold uppercase">EDUSPACE</span>
                    </div>
                </a>
                <h1 class="text-lg sm:text-xl font-black text-brand-deep tracking-tight mt-2">Đăng Ký Tài Khoản Học Viên</h1>
                <p class="text-xs text-outline mt-0.5">Khởi đầu hành trình học tập công nghệ thực chiến cùng chuyên gia</p>
            </div>

            <!-- Role Enforcement Notice -->
            <div class="mb-5 p-3.5 rounded-2xl bg-blue-50/80 border border-blue-200 text-xs text-blue-900 flex items-start gap-2.5">
                <span class="material-symbols-outlined text-[20px] text-primary shrink-0">info</span>
                <div class="leading-relaxed">
                    Tài khoản đăng ký tại đây mặc định là <strong>Học viên</strong>. Các vai trò <strong>Giáo vụ</strong> và <strong>Quản trị viên (Admin)</strong> được phân quyền trực tiếp bởi Ban quản trị.
                </div>
            </div>

            <!-- Validation Summary -->
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="mb-5 p-3.5 rounded-xl bg-red-50 border border-red-200 text-danger-crimson text-xs space-y-1">
                    <div class="flex items-center gap-2 font-bold">
                        <span class="material-symbols-outlined text-[18px]">error</span>
                        <span>Vui lòng kiểm tra lại thông tin:</span>
                    </div>
                    <ul class="list-disc list-inside pl-2 space-y-0.5 text-[11px]">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <!-- Register Form -->
            <form method="post" action="/TaiKhoan/Register" class="space-y-4">
                @Html.AntiForgeryToken()

                <!-- Họ tên -->
                <div>
                    <label class="block text-xs font-bold text-brand-deep uppercase tracking-wider mb-1">
                        Họ và tên học viên <span class="text-rose-500">*</span>
                    </label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[18px]">person</span>
                        <input type="text" asp-for="HoTen" required autofocus
                               class="w-full pl-10 pr-3.5 py-2.5 rounded-xl bg-canvas-base border border-border-standard text-brand-deep placeholder:text-outline text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
                               placeholder="VD: Nguyễn Văn An" />
                    </div>
                </div>

                <!-- Username & Email Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                    <div>
                        <label class="block text-xs font-bold text-brand-deep uppercase tracking-wider mb-1">
                            Tên đăng nhập <span class="text-rose-500">*</span>
                        </label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[18px]">badge</span>
                            <input type="text" asp-for="TenDangNhap" required
                                   class="w-full pl-10 pr-3.5 py-2.5 rounded-xl bg-canvas-base border border-border-standard text-brand-deep placeholder:text-outline text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all font-mono"
                                   placeholder="nguyenvanan" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-brand-deep uppercase tracking-wider mb-1">
                            Email <span class="text-rose-500">*</span>
                        </label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[18px]">mail</span>
                            <input type="email" asp-for="Email" required
                                   class="w-full pl-10 pr-3.5 py-2.5 rounded-xl bg-canvas-base border border-border-standard text-brand-deep placeholder:text-outline text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all font-mono"
                                   placeholder="an.nguyen@email.com" />
                        </div>
                    </div>
                </div>

                <!-- Password & Confirm Password Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                    <div>
                        <label class="block text-xs font-bold text-brand-deep uppercase tracking-wider mb-1">
                            Mật khẩu <span class="text-rose-500">*</span>
                        </label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[18px]">lock</span>
                            <input type="password" asp-for="MatKhau" required
                                   class="w-full pl-10 pr-3.5 py-2.5 rounded-xl bg-canvas-base border border-border-standard text-brand-deep placeholder:text-outline text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
                                   placeholder="Tối thiểu 6 ký tự" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-brand-deep uppercase tracking-wider mb-1">
                            Xác nhận mật khẩu <span class="text-rose-500">*</span>
                        </label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[18px]">lock_reset</span>
                            <input type="password" asp-for="XacNhanMatKhau" required
                                   class="w-full pl-10 pr-3.5 py-2.5 rounded-xl bg-canvas-base border border-border-standard text-brand-deep placeholder:text-outline text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
                                   placeholder="Nhập lại mật khẩu" />
                        </div>
                    </div>
                </div>

                <!-- Phone & Gender Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                    <div>
                        <label class="block text-xs font-bold text-brand-deep uppercase tracking-wider mb-1">
                            Số điện thoại
                        </label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[18px]">call</span>
                            <input type="tel" asp-for="SoDienThoai"
                                   class="w-full pl-10 pr-3.5 py-2.5 rounded-xl bg-canvas-base border border-border-standard text-brand-deep placeholder:text-outline text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all font-mono"
                                   placeholder="0987654321" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-brand-deep uppercase tracking-wider mb-1">
                            Giới tính
                        </label>
                        <select asp-for="GioiTinh" class="w-full px-3.5 py-2.5 rounded-xl bg-canvas-base border border-border-standard text-brand-deep text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary">
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                            <option value="Khác">Khác</option>
                        </select>
                    </div>
                </div>

                <!-- Ngày sinh & Địa chỉ -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                    <div>
                        <label class="block text-xs font-bold text-brand-deep uppercase tracking-wider mb-1">
                            Ngày sinh
                        </label>
                        <input type="date" asp-for="NgaySinh"
                               class="w-full px-3.5 py-2.5 rounded-xl bg-canvas-base border border-border-standard text-brand-deep text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary font-mono" />
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-brand-deep uppercase tracking-wider mb-1">
                            Địa chỉ thường trú
                        </label>
                        <input type="text" asp-for="DiaChi" placeholder="Hà Nội, Nam Định..."
                               class="w-full px-3.5 py-2.5 rounded-xl bg-canvas-base border border-border-standard text-brand-deep text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" />
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="pt-3">
                    <button type="submit" class="w-full bg-primary hover:bg-[#0047b3] text-surface-white font-bold text-sm py-3 rounded-xl shadow-md shadow-primary/25 transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-98">
                        <span>Hoàn tất đăng ký học viên</span>
                        <span class="material-symbols-outlined text-[18px]">how_to_reg</span>
                    </button>
                </div>

                <!-- Links -->
                <div class="pt-2 text-center text-xs text-outline space-y-2">
                    <p>
                        Đã có tài khoản?
                        <a href="/TaiKhoan/Login" class="text-primary font-bold hover:underline">
                            Đăng nhập ngay
                        </a>
                    </p>
                    <p>
                        <a href="/" class="text-slate-500 hover:text-brand-deep inline-flex items-center gap-1 text-[11px]">
                            <span class="material-symbols-outlined text-[14px]">home</span>
                            <span>Quay lại Trang chủ EdTech</span>
                        </a>
                    </p>
                </div>
            </form>
        </div>

        <!-- Footer Info -->
        <p class="text-center text-white/60 text-xs mt-6 font-medium">
            TRƯỜNG ĐẠI HỌC KINH TẾ - KỸ THUẬT CÔNG NGHIỆP (UNETI)<br/>
            Bài tập lớn Thực hành Lập trình .NET 10 • Nhóm 5
        </p>
    </div>
</body>
</html>
