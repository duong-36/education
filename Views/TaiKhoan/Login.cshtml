@{
    // Họ và tên: Vũ Đình Trường
    // Mã sinh viên: 23103100026
    // Nội dung thực hiện: Giao diện Đăng nhập hệ thống (Module 1) - Phong cách Prep.vn
    ViewData["Title"] = "Đăng nhập hệ thống";
    Layout = null; // Standalone login screen
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Đăng nhập - UNETI ĐÀO TẠO</title>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "brand-deep": "#001656",
                        "primary": "#0052cc",
                        "primary-container": "#0068ff",
                        "canvas-base": "#F8FAFC",
                        "surface-white": "#FFFFFF",
                        "border-standard": "#E2E8F0",
                        "border-subtle": "#F1F5F9",
                        "outline": "#727687",
                        "danger-crimson": "#EF4444"
                    },
                    fontFamily: {
                        sans: ["'Be Vietnam Pro'", "sans-serif"]
                    }
                }
            }
        };
    </script>
</head>
<body class="bg-gradient-to-br from-[#001656] via-[#002d80] to-[#0052cc] min-h-screen flex items-center justify-center p-4 font-sans antialiased">
    <div class="w-full max-w-md">
        <!-- Main Login Card -->
        <div class="bg-surface-white rounded-3xl shadow-2xl p-8 border border-white/20 backdrop-blur-sm">
            <!-- Brand Logo & Header -->
            <div class="flex flex-col items-center text-center mb-7">
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-primary to-primary-container text-surface-white flex items-center justify-center shadow-lg shadow-primary/30 mb-3.5">
                    <span class="material-symbols-outlined text-[32px]">school</span>
                </div>
                <h1 class="text-2xl font-black text-brand-deep tracking-tight">UNETI ĐÀO TẠO</h1>
                <p class="text-xs text-outline mt-1">Cổng Quản lý Đăng ký Khóa học & Đào tạo</p>
            </div>

            <!-- Error Notice -->
            @if (ViewBag.Error != null)
            {
                <div class="mb-5 p-3.5 rounded-xl bg-red-50 border border-red-200 flex items-start gap-2.5 text-danger-crimson text-xs">
                    <span class="material-symbols-outlined text-[18px] flex-shrink-0">error</span>
                    <span class="font-medium leading-relaxed">@ViewBag.Error</span>
                </div>
            }
            @if (TempData["Warning"] != null)
            {
                <div class="mb-5 p-3.5 rounded-xl bg-amber-50 border border-amber-200 flex items-start gap-2.5 text-amber-800 text-xs">
                    <span class="material-symbols-outlined text-[18px] text-amber-600 flex-shrink-0">warning</span>
                    <span class="font-medium leading-relaxed">@TempData["Warning"]</span>
                </div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="mb-5 p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 flex items-start gap-2.5 text-emerald-800 text-xs">
                    <span class="material-symbols-outlined text-[18px] text-emerald-600 flex-shrink-0">check_circle</span>
                    <span class="font-medium leading-relaxed">@TempData["Success"]</span>
                </div>
            }

            <!-- Form -->
            <form method="post" action="/TaiKhoan/Login" class="space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl"/>

                <div>
                    <label class="block text-xs font-bold text-brand-deep uppercase tracking-wider mb-1.5">Tên đăng nhập</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[18px]">person</span>
                        <input type="text" name="tenDangNhap" required autofocus
                               class="w-full pl-10 pr-3.5 py-2.5 rounded-xl bg-canvas-base border border-border-standard text-brand-deep placeholder:text-outline text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
                               placeholder="Nhập tên đăng nhập..." />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-brand-deep uppercase tracking-wider mb-1.5">Mật khẩu</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[18px]">lock</span>
                        <input type="password" name="matKhau" required
                               class="w-full pl-10 pr-3.5 py-2.5 rounded-xl bg-canvas-base border border-border-standard text-brand-deep placeholder:text-outline text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
                               placeholder="Nhập mật khẩu..." />
                    </div>
                </div>

                <div class="pt-2">
                    <button type="submit" class="w-full bg-primary hover:bg-[#0047b3] text-surface-white font-bold text-sm py-3 rounded-xl shadow-md shadow-primary/25 transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-98">
                        <span>Đăng nhập hệ thống</span>
                        <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                    </button>
                </div>

                <div class="pt-2 text-center text-xs text-outline space-y-2">
                    <p>
                        Chưa có tài khoản?
                        <a href="/TaiKhoan/Register" class="text-primary font-bold hover:underline">
                            Đăng ký học viên mới
                        </a>
                    </p>
                    <p>
                        <a href="/" class="text-slate-500 hover:text-brand-deep inline-flex items-center gap-1 text-[11px]">
                            <span class="material-symbols-outlined text-[14px]">home</span>
                            <span>Quay lại Trang chủ EdTech</span>
                        </a>
                    </p>
                </div>
            </form>

            <!-- Quick Login Shortcuts for Review & Testing -->
            <div class="mt-7 pt-5 border-t border-border-subtle">
                <span class="block text-[11px] font-bold text-outline uppercase tracking-wider text-center mb-3">Đăng nhập nhanh (Kiểm thử)</span>
                <div class="grid grid-cols-3 gap-2">
                    <a href="/TaiKhoan/QuickLogin?role=Admin" class="px-2 py-2 rounded-xl border border-border-standard hover:border-primary hover:bg-blue-50/50 text-center text-xs font-semibold text-brand-deep transition-all flex flex-col items-center gap-1 group">
                        <span class="material-symbols-outlined text-primary text-[20px] group-hover:scale-110 transition-transform">admin_panel_settings</span>
                        <span>Admin</span>
                    </a>
                    <a href="/TaiKhoan/QuickLogin?role=GiaoVu" class="px-2 py-2 rounded-xl border border-border-standard hover:border-primary hover:bg-blue-50/50 text-center text-xs font-semibold text-brand-deep transition-all flex flex-col items-center gap-1 group">
                        <span class="material-symbols-outlined text-primary text-[20px] group-hover:scale-110 transition-transform">badge</span>
                        <span>Giáo vụ</span>
                    </a>
                    <a href="/TaiKhoan/QuickLogin?role=HocVien" class="px-2 py-2 rounded-xl border border-border-standard hover:border-primary hover:bg-blue-50/50 text-center text-xs font-semibold text-brand-deep transition-all flex flex-col items-center gap-1 group">
                        <span class="material-symbols-outlined text-primary text-[20px] group-hover:scale-110 transition-transform">school</span>
                        <span>Học viên</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Footer Info -->
        <p class="text-center text-white/60 text-xs mt-6 font-medium">
            TRƯỜNG ĐẠI HỌC KINH TẾ - KỸ THUẬT CÔNG NGHIỆP (UNETI)<br/>
            Bài tập lớn Thực hành Lập trình .NET 10 • Nhóm 5
        </p>
    </div>
</body>
</html>
