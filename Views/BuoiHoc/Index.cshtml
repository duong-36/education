@*
Họ và tên: Nguyễn Tùng Dương
Mã sinh viên: 23103100003
Nội dung thực hiện: Module 5 - Quản lý lịch học CRUD chuẩn phong cách Prep.vn
*@

@model IEnumerable<QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.Models.BuoiHoc>
@{
    ViewData["Title"] = "Quản lý lịch học";
    var conflictIds = ViewBag.ConflictIds as HashSet<int> ?? new HashSet<int>();
    int totalSessions = ViewBag.TotalSessions ?? 0;
    int completedSessions = ViewBag.CompletedSessions ?? 0;
    int scheduledSessions = ViewBag.ScheduledSessions ?? 0;
    int canceledSessions = ViewBag.CanceledSessions ?? 0;
    int conflictCount = ViewBag.SoLoiTrung ?? 0;

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalRecords = ViewBag.TotalRecords ?? 0;
    int pageSize = 8;
    int startRecord = totalRecords == 0 ? 0 : (currentPage - 1) * pageSize + 1;
    int endRecord = Math.Min(currentPage * pageSize, totalRecords);

    var lopHocs = ViewBag.LopHocList as IEnumerable<QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.Models.LopHoc> ?? new List<QuanLyDangKyKhoaHoc_UNETI04_TI17A1HN.Models.LopHoc>();
    var danhSachPhong = ViewBag.DanhSachPhong as IEnumerable<string> ?? new List<string>();
    var danhSachGV = ViewBag.DanhSachGiangVien as IEnumerable<string> ?? new List<string>();

    int? selectedMaLop = ViewBag.SelectedMaLop;
    string selectedPhong = ViewBag.SelectedPhong as string ?? "";
    string selectedTrangThai = ViewBag.SelectedTrangThai as string ?? "";
    string search = ViewBag.Search as string ?? "";

    double completionRate = totalSessions > 0 ? Math.Round((double)completedSessions / totalSessions * 100, 1) : 0;
}

<!-- Alert Notification -->
@if (TempData["Success"] != null)
{
    <div id="toast-success" class="mb-4 flex items-center justify-between p-4 bg-emerald-50 border border-emerald-200 rounded-2xl text-emerald-800 shadow-sm animate-fade-in">
        <div class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-success-emerald text-[22px]">check_circle</span>
            <span class="font-label-md text-label-md font-semibold">@TempData["Success"]</span>
        </div>
        <button onclick="document.getElementById('toast-success').remove()" class="text-emerald-600 hover:text-emerald-900">
            <span class="material-symbols-outlined text-[18px]">close</span>
        </button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div id="toast-error" class="mb-4 flex items-center justify-between p-4 bg-red-50 border border-red-200 rounded-2xl text-danger-crimson shadow-sm animate-fade-in">
        <div class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-danger-crimson text-[22px]">error</span>
            <span class="font-label-md text-label-md font-semibold">@TempData["Error"]</span>
        </div>
        <button onclick="document.getElementById('toast-error').remove()" class="text-red-500 hover:text-red-800">
            <span class="material-symbols-outlined text-[18px]">close</span>
        </button>
    </div>
}

<div class="flex flex-col gap-y-6">
    <!-- Contextual Sub-Header & Controls -->
    <section class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 bg-surface-white p-5 rounded-2xl border border-border-subtle shadow-[0_2px_12px_rgba(0,22,86,0.03)]">
        <div class="flex items-center gap-space-sm min-w-0">
            <div class="flex flex-col">
                <div class="flex items-center gap-1.5 text-outline font-label-sm text-label-sm tracking-wide">
                    <span>ĐÀO TẠO UNETI</span>
                    <span class="material-symbols-outlined text-[13px]">chevron_right</span>
                    <span class="text-primary-container font-semibold">LỊCH HỌC & PHÒNG MÁY</span>
                </div>
                <h1 class="font-headline-md text-headline-md text-brand-deep tracking-tight truncate font-extrabold mt-0.5">
                    Quản lý lịch học
                </h1>
            </div>
            <span class="bg-primary/10 text-primary font-label-sm text-label-sm px-2.5 py-0.5 rounded-full ml-2 hidden sm:inline-block font-semibold">
                HK1 2024-2025
            </span>
        </div>

        <div class="flex items-center flex-wrap gap-2.5">
            <button onclick="exportTableToCSV('danh-sach-lich-hoc.csv')" class="inline-flex items-center gap-1.5 bg-surface-white border border-border-standard hover:bg-surface-container-low text-brand-deep font-label-md text-label-md px-3.5 py-2 rounded-xl transition-all shadow-xs cursor-pointer">
                <span class="material-symbols-outlined text-[18px] text-primary">file_download</span>
                <span class="hidden sm:inline">Xuất danh mục Excel</span>
            </button>
            <button onclick="openDrawer('create')" class="inline-flex items-center gap-1.5 bg-secondary-container hover:bg-secondary text-surface-white font-label-md text-label-md px-4 py-2 rounded-xl shadow-sm hover:shadow-md transition-transform active:scale-95 cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">add_circle</span>
                <span>+ Xếp lịch học</span>
            </button>
        </div>
    </section>

    <!-- Quick Analytics Stats Row (3 Cards) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <!-- Stat 1 -->
        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle shadow-[0_1px_3px_rgba(0,22,86,0.04),0_8px_24px_-4px_rgba(0,22,86,0.06)] flex items-center justify-between">
            <div>
                <span class="font-label-sm text-label-sm text-outline tracking-wider uppercase block mb-1">Tổng số buổi học</span>
                <div class="flex items-baseline gap-2">
                    <span class="font-metric-stat text-metric-stat text-brand-deep tabular-nums">@totalSessions</span>
                    <span class="font-body-sm text-body-sm text-outline">buổi</span>
                </div>
                <div class="flex items-center gap-2 mt-2">
                    <span class="inline-flex items-center gap-1 font-label-sm text-label-sm text-success-emerald bg-[#10B981]/10 px-2 py-0.5 rounded-full">
                        <span class="w-1.5 h-1.5 rounded-full bg-success-emerald animate-pulse"></span>
                        @scheduledSessions Đang mở
                    </span>
                    <span class="font-body-sm text-body-sm text-outline">/ @canceledSessions Đã hủy</span>
                </div>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-[26px]">calendar_month</span>
            </div>
        </div>

        <!-- Stat 2 -->
        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle shadow-[0_1px_3px_rgba(0,22,86,0.04),0_8px_24px_-4px_rgba(0,22,86,0.06)] flex items-center justify-between">
            <div>
                <span class="font-label-sm text-label-sm text-outline tracking-wider uppercase block mb-1">Buổi học đã hoàn thành</span>
                <div class="flex items-baseline gap-2">
                    <span class="font-metric-stat text-metric-stat text-brand-deep tabular-nums">@completedSessions</span>
                    <span class="font-body-sm text-body-sm text-outline">buổi</span>
                </div>
                <div class="flex items-center gap-1.5 mt-2">
                    <span class="font-label-sm text-label-sm text-primary font-bold">@completionRate%</span>
                    <span class="font-body-sm text-body-sm text-on-surface-variant">tiến độ hoàn tất</span>
                </div>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-secondary-container/10 flex items-center justify-center text-secondary-container">
                <span class="material-symbols-outlined text-[26px]">fact_check</span>
            </div>
        </div>

        <!-- Stat 3 -->
        <div class="bg-surface-white rounded-2xl p-5 border border-border-subtle shadow-[0_1px_3px_rgba(0,22,86,0.04),0_8px_24px_-4px_rgba(0,22,86,0.06)] flex items-center justify-between">
            <div class="min-w-0 pr-2">
                <span class="font-label-sm text-label-sm text-outline tracking-wider uppercase block mb-1">Cảnh báo trùng lịch</span>
                <p class="font-headline-sm text-headline-sm text-brand-deep truncate">
                    @(conflictCount > 0 ? $"{conflictCount} ca học xung đột" : "An toàn - 0 xung đột")
                </p>
                <div class="flex items-center gap-2 mt-2">
                    @if (conflictCount > 0)
                    {
                        <span class="font-label-md text-label-md text-danger-crimson font-bold tabular-nums">Cần xếp lại</span>
                        <span class="font-body-sm text-body-sm text-outline">(Trùng phòng / GV)</span>
                    }
                    else
                    {
                        <span class="font-label-md text-label-md text-success-emerald font-bold tabular-nums">Tối ưu</span>
                        <span class="font-body-sm text-body-sm text-outline">(Đúng quy định UNETI)</span>
                    }
                </div>
            </div>
            <div class="w-12 h-12 rounded-2xl @(conflictCount > 0 ? "bg-red-100 text-danger-crimson" : "bg-tertiary/10 text-tertiary") flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-[26px]">@(conflictCount > 0 ? "warning" : "verified")</span>
            </div>
        </div>
    </div>

    <!-- Filter & Operation Toolbar -->
    <div class="bg-surface-white rounded-2xl p-4 border border-border-subtle shadow-sm flex flex-col lg:flex-row items-center justify-between gap-4">
        <form method="get" action="/BuoiHoc/Index" class="flex flex-wrap items-center gap-3 w-full lg:w-auto" id="filter-form">
            <!-- Search Field -->
            <div class="relative flex-1 sm:w-72">
                <span class="material-symbols-outlined text-outline absolute left-3 top-1/2 -translate-y-1/2 text-[18px]">search</span>
                <input name="search" value="@search" class="w-full bg-surface-container-low border border-border-standard pl-9 pr-8 py-2 rounded-xl text-on-surface font-body-sm text-body-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" id="table-search" placeholder="Tìm theo giảng viên, phòng, lớp..." type="text"/>
                @if (!string.IsNullOrEmpty(search))
                {
                    <a href="/BuoiHoc/Index" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-outline hover:text-on-surface">
                        <span class="material-symbols-outlined text-[16px]">cancel</span>
                    </a>
                }
            </div>

            <!-- Filter Dropdown: Lớp học -->
            <div class="relative">
                <select name="maLop" onchange="document.getElementById('filter-form').submit()" class="appearance-none bg-surface-white border border-border-standard text-brand-deep font-body-sm text-body-sm px-3.5 py-2 pr-8 rounded-xl focus:outline-none focus:border-primary cursor-pointer hover:bg-surface-container-low transition-colors">
                    <option value="">Tất cả Lớp học</option>
                    @foreach (var lop in lopHocs)
                    {
                        <!option value="@lop.MaLop" @(selectedMaLop == lop.MaLop ? "selected" : "")>@lop.TenLop</!option>
                    }
                </select>
                <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[16px]">expand_more</span>
            </div>

            <!-- Filter Dropdown: Phòng học -->
            <div class="relative">
                <select name="phong" onchange="document.getElementById('filter-form').submit()" class="appearance-none bg-surface-white border border-border-standard text-brand-deep font-body-sm text-body-sm px-3.5 py-2 pr-8 rounded-xl focus:outline-none focus:border-primary cursor-pointer hover:bg-surface-container-low transition-colors">
                    <option value="">Tất cả Phòng học</option>
                    @foreach (var p in danhSachPhong)
                    {
                        <!option value="@p" @(selectedPhong == p ? "selected" : "")>@p</!option>
                    }
                </select>
                <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[16px]">expand_more</span>
            </div>

            <!-- Filter Dropdown: Trạng thái -->
            <div class="relative">
                <select name="trangThai" onchange="document.getElementById('filter-form').submit()" class="appearance-none bg-surface-white border border-border-standard text-brand-deep font-body-sm text-body-sm px-3.5 py-2 pr-8 rounded-xl focus:outline-none focus:border-primary cursor-pointer hover:bg-surface-container-low transition-colors">
                    <option value="">Trạng thái: Tất cả</option>
                    <!option value="Đã lên lịch" @(selectedTrangThai == "Đã lên lịch" ? "selected" : "")>● Đã lên lịch</!option>
                    <!option value="Đã hoàn thành" @(selectedTrangThai == "Đã hoàn thành" ? "selected" : "")>● Đã hoàn thành</!option>
                    <!option value="Đã hủy" @(selectedTrangThai == "Đã hủy" ? "selected" : "")>○ Đã hủy</!option>
                </select>
                <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[16px]">expand_more</span>
            </div>
        </form>

        <div class="flex items-center gap-2 w-full lg:w-auto justify-end">
            <a href="/BuoiHoc/Index" class="p-2 border border-border-standard rounded-xl text-outline hover:text-brand-deep hover:bg-surface-container-low transition-colors" title="Làm mới bảng">
                <span class="material-symbols-outlined text-[20px] block">refresh</span>
            </a>
            <button onclick="openDrawer('create')" class="bg-primary hover:bg-[#0047b3] text-surface-white font-label-md text-label-md px-4 py-2.5 rounded-xl shadow-sm flex items-center gap-2 transition-all cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">add</span>
                <span>Tạo buổi mới</span>
            </button>
        </div>
    </div>

    <!-- Data Table Container -->
    <div class="bg-surface-white rounded-2xl border border-border-subtle shadow-[0_1px_3px_rgba(0,22,86,0.04),0_8px_24px_-4px_rgba(0,22,86,0.06)] overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse" id="crud-table">
                <thead>
                    <tr class="bg-surface-container-low/70 border-b border-border-subtle font-label-sm text-label-sm text-outline tracking-wider uppercase">
                        <th class="p-4 pl-6 w-12 text-center">
                            <input class="rounded border-border-standard text-primary focus:ring-primary h-4 w-4 cursor-pointer" type="checkbox" id="select-all"/>
                        </th>
                        <th class="py-4 px-4">Mã ca</th>
                        <th class="py-4 px-4 min-w-[200px]">Lớp học</th>
                        <th class="py-4 px-4">Thời gian học</th>
                        <th class="py-4 px-3 text-center">Phòng</th>
                        <th class="py-4 px-4">Giảng viên</th>
                        <th class="py-4 px-4">Trạng thái</th>
                        <th class="py-4 px-6 text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border-subtle font-body-sm text-body-sm">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="py-12 text-center text-outline">
                                <span class="material-symbols-outlined text-4xl block mb-2 text-outline/50">event_busy</span>
                                Chưa có buổi học nào phù hợp với bộ lọc hiện tại.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            bool isConflict = conflictIds.Contains(item.MaBuoiHoc);
                            <tr class="hover:bg-surface-container-low/50 transition-colors group @(isConflict ? "bg-red-50/50" : "")" 
                                data-id="@item.MaBuoiHoc"
                                data-malop="@item.MaLop"
                                data-tenlop="@(item.LopHoc?.TenLop ?? "")"
                                data-phong="@item.PhongHoc"
                                data-gv="@item.GiangVien"
                                data-batdau="@item.ThoiGianBatDau.ToString("yyyy-MM-ddTHH:mm")"
                                data-ketthuc="@item.ThoiGianKetThuc.ToString("yyyy-MM-ddTHH:mm")"
                                data-noidung="@item.NoiDung"
                                data-ghichu="@item.GhiChu"
                                data-trangthai="@item.TrangThai">
                                <td class="p-4 pl-6 text-center">
                                    <input class="rounded border-border-standard text-primary focus:ring-primary h-4 w-4 row-checkbox cursor-pointer" type="checkbox"/>
                                </td>
                                <td class="py-4 px-4 font-mono font-semibold text-primary">
                                    #BH@item.MaBuoiHoc.ToString("D3")
                                </td>
                                <td class="py-4 px-4">
                                    <div class="font-label-md text-label-md text-brand-deep font-semibold">
                                        @(item.LopHoc?.TenLop ?? $"Lớp #{item.MaLop}")
                                    </div>
                                    <div class="text-outline text-[12px] truncate max-w-xs">
                                        @(item.NoiDung ?? "Nội dung chuẩn theo đề cương")
                                    </div>
                                </td>
                                <td class="py-4 px-4 text-on-surface">
                                    <div class="font-semibold text-brand-deep">
                                        @item.ThoiGianBatDau.ToString("dd/MM/yyyy")
                                    </div>
                                    <div class="text-[12px] text-outline font-mono">
                                        @item.ThoiGianBatDau.ToString("HH:mm") - @item.ThoiGianKetThuc.ToString("HH:mm")
                                    </div>
                                </td>
                                <td class="py-4 px-3 text-center">
                                    <span class="inline-block bg-primary/10 text-primary font-bold font-mono px-2.5 py-1 rounded-lg text-xs">
                                        @item.PhongHoc
                                    </span>
                                </td>
                                <td class="py-4 px-4 text-on-surface">
                                    <div class="flex items-center gap-1.5 font-medium">
                                        <span class="material-symbols-outlined text-[16px] text-outline">person</span>
                                        <span>@item.GiangVien</span>
                                    </div>
                                </td>
                                <td class="py-4 px-4">
                                    @if (isConflict)
                                    {
                                        <span class="inline-flex items-center gap-1.5 font-label-sm text-label-sm text-danger-crimson bg-red-100 px-2.5 py-1 rounded-full animate-pulse">
                                            <span class="w-1.5 h-1.5 rounded-full bg-danger-crimson"></span>
                                            Trùng ca học
                                        </span>
                                    }
                                    else if (item.TrangThai == "Đã hoàn thành")
                                    {
                                        <span class="inline-flex items-center gap-1.5 font-label-sm text-label-sm text-success-emerald bg-[#10B981]/10 px-2.5 py-1 rounded-full">
                                            <span class="w-1.5 h-1.5 rounded-full bg-success-emerald"></span>
                                            Hoàn thành
                                        </span>
                                    }
                                    else if (item.TrangThai == "Đã hủy")
                                    {
                                        <span class="inline-flex items-center gap-1.5 font-label-sm text-label-sm text-outline bg-surface-container px-2.5 py-1 rounded-full">
                                            <span class="w-1.5 h-1.5 rounded-full bg-outline"></span>
                                            Đã hủy
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 font-label-sm text-label-sm text-primary bg-primary/10 px-2.5 py-1 rounded-full">
                                            <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                                            Đã lên lịch
                                        </span>
                                    }
                                </td>
                                <td class="py-4 px-6 text-right">
                                    <div class="inline-flex items-center gap-1">
                                        <button onclick="viewSessionDetails(@item.MaBuoiHoc)" class="p-1.5 rounded-lg text-outline hover:text-primary hover:bg-surface-container-low transition-colors cursor-pointer" title="Xem chi tiết">
                                            <span class="material-symbols-outlined text-[18px]">visibility</span>
                                        </button>
                                        <button onclick="openEditDrawerFromRow(this)" class="p-1.5 rounded-lg text-outline hover:text-secondary-container hover:bg-surface-container-low transition-colors cursor-pointer" title="Chỉnh sửa">
                                            <span class="material-symbols-outlined text-[18px]">edit</span>
                                        </button>
                                        <button onclick="confirmDelete(@item.MaBuoiHoc, '#BH@item.MaBuoiHoc.ToString("D3") - @(item.LopHoc?.TenLop ?? "") (@item.PhongHoc)')" class="p-1.5 rounded-lg text-outline hover:text-danger-crimson hover:bg-red-50 transition-colors cursor-pointer" title="Xóa buổi học">
                                            <span class="material-symbols-outlined text-[18px]">delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Toolbar -->
        <div class="p-4 px-6 border-t border-border-subtle bg-surface-white flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="font-body-sm text-body-sm text-outline">
                Hiển thị <span class="font-semibold text-brand-deep tabular-nums">@startRecord-@endRecord</span> trên <span class="font-semibold text-brand-deep tabular-nums">@totalRecords</span> buổi học
            </div>
            <div class="flex items-center gap-1.5">
                <a href="/BuoiHoc/Index?page=@(currentPage - 1)&maLop=@selectedMaLop&phong=@selectedPhong&trangThai=@selectedTrangThai&search=@search" 
                   class="p-1.5 rounded-lg border border-border-standard text-outline hover:bg-surface-container-low @(currentPage <= 1 ? "opacity-40 pointer-events-none" : "")">
                    <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                </a>
                @for (int p = 1; p <= totalPages; p++)
                {
                    if (p == currentPage)
                    {
                        <span class="w-8 h-8 rounded-lg bg-primary text-surface-white font-label-md text-label-md font-bold flex items-center justify-center">@p</span>
                    }
                    else if (p <= 3 || p == totalPages || Math.Abs(p - currentPage) <= 1)
                    {
                        <a href="/BuoiHoc/Index?page=@p&maLop=@selectedMaLop&phong=@selectedPhong&trangThai=@selectedTrangThai&search=@search" 
                           class="w-8 h-8 rounded-lg border border-border-standard text-brand-deep hover:bg-surface-container-low font-label-md text-label-md flex items-center justify-center">@p</a>
                    }
                    else if (p == 4 && totalPages > 5)
                    {
                        <span class="px-1 text-outline font-body-sm">...</span>
                    }
                }
                <a href="/BuoiHoc/Index?page=@(currentPage + 1)&maLop=@selectedMaLop&phong=@selectedPhong&trangThai=@selectedTrangThai&search=@search" 
                   class="p-1.5 rounded-lg border border-border-standard text-outline hover:bg-surface-container-low @(currentPage >= totalPages ? "opacity-40 pointer-events-none" : "")">
                    <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- RIGHT SLIDE-OVER DRAWER (CREATE / UPDATE FORM) -->
<div class="fixed inset-0 z-50 overflow-hidden hidden transition-all duration-300" id="drawer-container">
    <!-- Overlay Backdrop -->
    <div class="absolute inset-0 bg-brand-deep/40 backdrop-blur-xs transition-opacity duration-300" id="drawer-backdrop" onclick="closeDrawer()"></div>
    <div class="absolute inset-y-0 right-0 max-w-full flex pl-10">
        <div class="w-screen max-w-md bg-surface-white shadow-2xl border-l border-border-standard flex flex-col justify-between">
            <!-- Drawer Header -->
            <div class="p-6 border-b border-border-subtle flex items-start justify-between bg-surface-white">
                <div>
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary text-[22px]">calendar_month</span>
                        <h2 class="font-headline-sm text-headline-sm text-brand-deep" id="drawer-title">Xếp lịch học mới</h2>
                    </div>
                    <p class="font-body-sm text-body-sm text-outline mt-1" id="drawer-subtitle">
                        Nhập thông tin ca học, phòng máy và phân công giảng viên.
                    </p>
                </div>
                <button onclick="closeDrawer()" class="p-1.5 rounded-xl text-outline hover:text-brand-deep hover:bg-surface-container-low transition-colors cursor-pointer">
                    <span class="material-symbols-outlined text-[20px]">close</span>
                </button>
            </div>

            <!-- Drawer Form Body -->
            <form id="drawer-form" method="post" action="/BuoiHoc/Create" class="flex-1 overflow-y-auto p-6 space-y-5">
                @Html.AntiForgeryToken()
                <input type="hidden" name="MaBuoiHoc" id="drawer-mabuoi" value="0"/>

                <!-- Select: Lớp học -->
                <div class="space-y-1.5">
                    <label class="block font-label-sm text-label-sm text-brand-deep uppercase tracking-wider">
                        Lớp học đào tạo <span class="text-danger-crimson">*</span>
                    </label>
                    <div class="relative">
                        <select name="MaLop" id="drawer-malop" required class="w-full appearance-none bg-surface-white border border-border-standard rounded-xl px-3.5 py-2.5 font-body-md text-body-md text-brand-deep focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary">
                            @foreach (var lop in lopHocs)
                            {
                                <option value="@lop.MaLop">@lop.TenLop (@(lop.SiSoToiDa) SV)</option>
                            }
                        </select>
                        <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[20px]">expand_more</span>
                    </div>
                </div>

                <!-- Input: Phòng học -->
                <div class="space-y-1.5">
                    <label class="block font-label-sm text-label-sm text-brand-deep uppercase tracking-wider">
                        Phòng học / Phòng máy <span class="text-danger-crimson">*</span>
                    </label>
                    <div class="relative">
                        <input name="PhongHoc" id="drawer-phong" required class="w-full bg-surface-white border border-border-standard rounded-xl px-3.5 py-2.5 font-mono font-semibold text-primary focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary uppercase" placeholder="Ví dụ: P.301, Lab CNTT 01" type="text" value="P.301"/>
                        <span class="material-symbols-outlined text-outline absolute right-3 top-1/2 -translate-y-1/2 text-[18px]">meeting_room</span>
                    </div>
                </div>

                <!-- Input: Giảng viên -->
                <div class="space-y-1.5">
                    <label class="block font-label-sm text-label-sm text-brand-deep uppercase tracking-wider">
                        Giảng viên phụ trách <span class="text-danger-crimson">*</span>
                    </label>
                    <div class="relative">
                        <input name="GiangVien" id="drawer-gv" required class="w-full bg-surface-white border border-border-standard rounded-xl px-3.5 py-2.5 font-body-md text-body-md text-brand-deep focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" placeholder="Ví dụ: ThS. Nguyễn Văn A" type="text" value="ThS. Nguyễn Văn A"/>
                        <span class="material-symbols-outlined text-outline absolute right-3 top-1/2 -translate-y-1/2 text-[18px]">person</span>
                    </div>
                </div>

                <!-- Dates: Bắt đầu & Kết thúc -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div class="space-y-1.5">
                        <label class="block font-label-sm text-label-sm text-brand-deep uppercase tracking-wider">
                            Thời gian bắt đầu <span class="text-danger-crimson">*</span>
                        </label>
                        <input name="ThoiGianBatDau" id="drawer-batdau" required type="datetime-local" class="w-full bg-surface-white border border-border-standard rounded-xl px-3 py-2 font-mono text-xs text-brand-deep focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary"/>
                    </div>
                    <div class="space-y-1.5">
                        <label class="block font-label-sm text-label-sm text-brand-deep uppercase tracking-wider">
                            Thời gian kết thúc <span class="text-danger-crimson">*</span>
                        </label>
                        <input name="ThoiGianKetThuc" id="drawer-ketthuc" required type="datetime-local" class="w-full bg-surface-white border border-border-standard rounded-xl px-3 py-2 font-mono text-xs text-brand-deep focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary"/>
                    </div>
                </div>

                <!-- Textarea: Nội dung bài học -->
                <div class="space-y-1.5">
                    <label class="block font-label-sm text-label-sm text-brand-deep uppercase tracking-wider">Nội dung ca học</label>
                    <textarea name="NoiDung" id="drawer-noidung" class="w-full bg-surface-white border border-border-standard rounded-xl p-3 font-body-sm text-body-sm text-brand-deep focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary resize-none" placeholder="Ví dụ: Buổi 1 - Giới thiệu kiến trúc MVC & Entity Framework Core..." rows="2"></textarea>
                </div>

                <!-- Textarea: Ghi chú -->
                <div class="space-y-1.5">
                    <label class="block font-label-sm text-label-sm text-brand-deep uppercase tracking-wider">Ghi chú vận hành</label>
                    <textarea name="GhiChu" id="drawer-ghichu" class="w-full bg-surface-white border border-border-standard rounded-xl p-3 font-body-sm text-body-sm text-brand-deep focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary resize-none" placeholder="Yêu cầu chuẩn bị máy chiếu, cài đặt Visual Studio 2026..." rows="2"></textarea>
                </div>

                <!-- Radio: Trạng thái ca học (Only for Edit) -->
                <div class="space-y-1.5" id="drawer-trangthai-group">
                    <label class="block font-label-sm text-label-sm text-brand-deep uppercase tracking-wider">Trạng thái ca học</label>
                    <div class="grid grid-cols-3 gap-2">
                        <label class="cursor-pointer border border-border-standard rounded-xl p-2.5 flex items-center justify-center gap-1.5 hover:bg-surface-container-low transition-colors" id="label-trangthai-scheduled">
                            <input type="radio" name="TrangThai" value="Đã lên lịch" class="hidden" id="radio-trangthai-scheduled" checked/>
                            <span class="font-label-sm text-label-sm font-semibold">Đã lên lịch</span>
                        </label>
                        <label class="cursor-pointer border border-border-standard rounded-xl p-2.5 flex items-center justify-center gap-1.5 hover:bg-surface-container-low transition-colors" id="label-trangthai-completed">
                            <input type="radio" name="TrangThai" value="Đã hoàn thành" class="hidden" id="radio-trangthai-completed"/>
                            <span class="font-label-sm text-label-sm font-semibold text-success-emerald">Hoàn thành</span>
                        </label>
                        <label class="cursor-pointer border border-border-standard rounded-xl p-2.5 flex items-center justify-center gap-1.5 hover:bg-surface-container-low transition-colors" id="label-trangthai-canceled">
                            <input type="radio" name="TrangThai" value="Đã hủy" class="hidden" id="radio-trangthai-canceled"/>
                            <span class="font-label-sm text-label-sm font-semibold text-danger-crimson">Đã hủy</span>
                        </label>
                    </div>
                </div>

                <!-- AI Assistant Tip Widget -->
                <div class="bg-primary/5 border border-primary/20 rounded-2xl p-3.5 flex items-start gap-3">
                    <div class="w-8 h-8 rounded-xl bg-primary text-surface-white flex items-center justify-center flex-shrink-0 shadow-sm">
                        <span class="material-symbols-outlined text-[18px]">auto_awesome</span>
                    </div>
                    <div>
                        <span class="font-label-sm text-label-sm text-primary uppercase tracking-wider block font-bold">Gợi ý từ AI Assistant</span>
                        <p class="font-body-sm text-[12px] text-on-surface-variant mt-0.5 leading-relaxed">
                            Hệ thống tự động kiểm tra xung đột trùng phòng máy và giảng viên bằng LINQ theo đúng quy chế đào tạo UNETI.
                        </p>
                    </div>
                </div>

                <!-- Drawer Footer Submit inside form -->
                <div class="border-t border-border-subtle pt-4 flex items-center justify-end gap-3">
                    <button type="button" onclick="closeDrawer()" class="border border-border-standard bg-surface-white hover:bg-surface-container-low text-brand-deep font-label-md text-label-md px-4 py-2.5 rounded-xl transition-colors cursor-pointer">
                        Hủy bỏ
                    </button>
                    <button type="submit" class="bg-primary hover:bg-[#0047b3] text-surface-white font-label-md text-label-md px-5 py-2.5 rounded-xl shadow-sm flex items-center gap-2 transition-all cursor-pointer">
                        <span class="material-symbols-outlined text-[18px]">save</span>
                        <span id="drawer-submit-text">Lưu buổi học</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Micro-interactions for Drawer and Global Modal
    const drawer = document.getElementById('drawer-container');
    const drawerForm = document.getElementById('drawer-form');

    function openDrawer(mode) {
        drawer.classList.remove('hidden');
        if (mode === 'create') {
            document.getElementById('drawer-title').innerText = 'Xếp lịch học mới';
            document.getElementById('drawer-subtitle').innerText = 'Nhập thông tin ca học, phòng máy và phân công giảng viên.';
            document.getElementById('drawer-submit-text').innerText = 'Lưu buổi học';
            drawerForm.action = '/BuoiHoc/Create';
            document.getElementById('drawer-mabuoi').value = '0';
            
            // Set default times (Tomorrow 08:00 to 11:30)
            const tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            const yyyy = tomorrow.getFullYear();
            const mm = String(tomorrow.getMonth() + 1).padStart(2, '0');
            const dd = String(tomorrow.getDate()).padStart(2, '0');
            document.getElementById('drawer-batdau').value = `${yyyy}-${mm}-${dd}T08:00`;
            document.getElementById('drawer-ketthuc').value = `${yyyy}-${mm}-${dd}T11:30`;
        }
    }

    function closeDrawer() {
        drawer.classList.add('hidden');
    }

    function openEditDrawerFromRow(btn) {
        const row = btn.closest('tr');
        document.getElementById('drawer-title').innerText = 'Cập nhật buổi học';
        document.getElementById('drawer-subtitle').innerText = 'Điều chỉnh thời gian, phòng học hoặc trạng thái ca học.';
        document.getElementById('drawer-submit-text').innerText = 'Cập nhật';
        drawerForm.action = '/BuoiHoc/EditPost';

        document.getElementById('drawer-mabuoi').value = row.dataset.id;
        document.getElementById('drawer-malop').value = row.dataset.malop;
        document.getElementById('drawer-phong').value = row.dataset.phong;
        document.getElementById('drawer-gv').value = row.dataset.gv;
        document.getElementById('drawer-batdau').value = row.dataset.batdau;
        document.getElementById('drawer-ketthuc').value = row.dataset.ketthuc;
        document.getElementById('drawer-noidung').value = row.dataset.noidung || '';
        document.getElementById('drawer-ghichu').value = row.dataset.ghichu || '';

        const status = row.dataset.trangthai;
        if (status === 'Đã hoàn thành') {
            document.getElementById('radio-trangthai-completed').checked = true;
        } else if (status === 'Đã hủy') {
            document.getElementById('radio-trangthai-canceled').checked = true;
        } else {
            document.getElementById('radio-trangthai-scheduled').checked = true;
        }

        drawer.classList.remove('hidden');
    }

    function viewSessionDetails(id) {
        const row = document.querySelector(`tr[data-id="${id}"]`);
        if (row) openEditDrawerFromRow(row.querySelector('button[title="Chỉnh sửa"]'));
    }

    function confirmDelete(id, sessionName) {
        openGlobalDeleteModal({
            action: '/BuoiHoc/DeletePost',
            id: id,
            title: 'Xóa buổi học này?',
            itemName: sessionName,
            message: `Bạn có chắc chắn muốn xóa buổi học <strong class="text-brand-deep">${sessionName}</strong>? Ca học và dữ liệu phân công giảng dạy liên quan sẽ bị gián đoạn.`,
            warning: 'Hành động này mang tính vĩnh viễn và không thể hoàn tác sau khi xác nhận.',
            submitText: 'Xóa vĩnh viễn'
        });
    }

    // Select-all Checkbox
    document.getElementById('select-all')?.addEventListener('change', function(e) {
        document.querySelectorAll('.row-checkbox').forEach(cb => cb.checked = e.target.checked);
    });

    // Client-side CSV Exporter
    function exportTableToCSV(filename) {
        let csv = [];
        const rows = document.querySelectorAll("#crud-table tr");
        for (let i = 0; i < rows.length; i++) {
            let row = [], cols = rows[i].querySelectorAll("td, th");
            for (let j = 1; j < cols.length - 1; j++) {
                let data = cols[j].innerText.replace(/(\r\n|\n|\r)/gm, " ").trim();
                data = data.replace(/"/g, '""');
                row.push('"' + data + '"');
            }
            csv.push(row.join(","));
        }
        const csvFile = new Blob(["\uFEFF" + csv.join("\n")], { type: "text/csv;charset=utf-8;" });
        const downloadLink = document.createElement("a");
        downloadLink.download = filename;
        downloadLink.href = window.URL.createObjectURL(csvFile);
        downloadLink.style.display = "none";
        document.body.appendChild(downloadLink);
        downloadLink.click();
        document.body.removeChild(downloadLink);
    }
</script>
